---
import Layout from '../layouts/Layout.astro';
import WaitlistFormCard from '../components/sections/WaitlistFormCard.astro';
import WaitlistConfirmationCard from '../components/sections/WaitlistConfirmationCard.astro';
---

<Layout title="Join the Waitlist | Huzlly"
  description="Join the Huzlly closed beta waitlist. 50 spots this cohort for freelancers who want proposals, contracts, invoicing, and projects running in one automatic flow."
  canonicalPath="/waitlist"
  hideChrome={true}
>
  <main class="relative flex min-h-[100dvh] flex-col items-center bg-gradient-to-tr from-blue-700 via-indigo-600 to-sky-400 px-6 py-6 sm:px-10 sm:py-8 lg:h-[100dvh] lg:justify-center lg:overflow-hidden lg:px-16 lg:py-10">
    <!-- Layered radial mesh wash for extra depth on top of the base gradient -->
    <div
      class="pointer-events-none absolute inset-0 -z-30"
      aria-hidden="true"
      style="background-image: radial-gradient(45% 40% at 10% 5%, rgba(196,181,253,0.6), transparent 65%), radial-gradient(40% 38% at 95% 8%, rgba(103,232,249,0.55), transparent 65%);"
    ></div>

    <!-- Soft ambient blur orbs — smaller + more saturated/contrasting so they read as distinct shapes in the thin visible margin, not just extra gradient -->
    <div class="pointer-events-none absolute -left-10 -top-10 -z-10 h-40 w-40 rounded-full bg-fuchsia-300/50 blur-2xl sm:h-56 sm:w-56" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-8 -top-14 -z-10 h-36 w-36 rounded-full bg-cyan-200/60 blur-2xl sm:h-48 sm:w-48" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-14 -left-10 -z-10 h-44 w-44 rounded-full bg-violet-400/40 blur-2xl sm:h-60 sm:w-60" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-10 -right-10 -z-10 h-40 w-40 rounded-full bg-sky-300/50 blur-2xl sm:h-56 sm:w-56" aria-hidden="true"></div>

    <!-- Ribbon-wave motif: dense, edge-hugging flowing lines (top-right + bottom-left),
         kept close to the actual visible margin band — the card covers most of the
         viewport here, so curves are anchored near the true edges rather than the
         wider corner spread that would work on a page with more visible background. -->
    <svg
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      aria-hidden="true"
    >
      <!-- Top-right cluster -->
      <g stroke="white" stroke-linecap="round">
        <path d="M900 -60 C 1080 20, 1200 -70, 1360 10 S 1620 0, 1720 90" stroke-width="2" opacity="0.6" />
        <path d="M880 10 C 1060 90, 1180 0, 1340 80 S 1600 70, 1700 160" stroke-width="1.75" opacity="0.5" />
        <path d="M860 80 C 1040 160, 1160 70, 1320 150 S 1580 140, 1680 230" stroke-width="1.5" opacity="0.38" />
        <path d="M840 150 C 1020 230, 1140 140, 1300 220 S 1560 210, 1660 300" stroke-width="1.5" opacity="0.26" />
      </g>

      <!-- Bottom-left cluster (mirrored) -->
      <g stroke="white" stroke-linecap="round">
        <path d="M-100 780 C 20 700, 140 800, 280 720 S 460 730, 560 650" stroke-width="2" opacity="0.55" />
        <path d="M-120 840 C 0 760, 120 860, 260 780 S 440 790, 540 710" stroke-width="1.75" opacity="0.44" />
        <path d="M-140 900 C -20 820, 100 920, 240 840 S 420 850, 520 770" stroke-width="1.5" opacity="0.3" />
      </g>

      <!-- Scattered dot accents, close to the visible edges -->
      <circle cx="120" cy="60" r="5" fill="white" opacity="0.6" />
      <circle cx="1360" cy="420" r="4.5" fill="white" opacity="0.5" />
      <circle cx="60" cy="480" r="4" fill="white" opacity="0.5" />
    </svg>

    <!-- Card stage — no overflow-hidden here, so the card's drop-shadow can
         spread/fade naturally instead of getting clipped at this wrapper's edge.
         lg:flex-none (was lg:flex-1): the card no longer force-grows to
         exactly consume main's remaining height — see the wrapper div note
         below for why. -->
    <div class="relative flex w-full flex-1 items-center justify-center lg:flex-none">

      <!-- Glassy outer glow ring — sits behind the card, bleeding a soft colored halo into the margin so the white card's edge reads crisp rather than blending into the gradient -->
      <div
        class="pointer-events-none absolute -inset-4 -z-10 rounded-[2.5rem] bg-gradient-to-b from-white/25 via-sky-200/15 to-transparent opacity-80 blur-2xl sm:-inset-8"
        aria-hidden="true"
      ></div>

      <!-- Card wrapper: mobile keeps h-full (confirmed working) — the parent
           there is a plain flex-1 box in normal document flow, so no
           mismatch risk. Desktop (lg) switches from h-full (100% of a
           flex-1 box sized to match main's exact 100dvh-minus-padding) to
           a definite calc() height with a bit of built-in slack
           (6rem reserved vs. the 5rem the padding actually uses).
           Previously the card was force-fit to exactly match main's
           computed available height — if the browser's 100dvh measurement
           didn't line up pixel-for-pixel with the real visible viewport
           (window chrome, OS taskbar, etc.), that mismatch landed entirely
           on one edge instead of splitting evenly (this is what caused the
           lopsided top/bottom gap). With lg:justify-center on <main> above
           and real slack here, any such mismatch is now split evenly by
           the browser's own centering — self-correcting instead of
           depending on exact arithmetic matching. -->
      <div class="relative w-full h-full [filter:drop-shadow(0_20px_35px_rgba(2,6,23,0.25))_drop-shadow(0_8px_14px_rgba(2,6,23,0.15))] lg:h-[calc(100dvh-6rem)]">
        <!-- Shared stage for both waitlist "screens" — moved here from the
             old WaitlistSplitCard.astro since it wraps both
             WaitlistFormCard.astro and WaitlistConfirmationCard.astro,
             which now live in separate component files. -->
        <section class="waitlist-stage relative flex h-full w-full items-center justify-center px-2 py-2 sm:px-4 sm:py-3">
          <!-- Ambient glow so the card visibly lifts off the flat paper background -->
          <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[70%] w-[85%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-100/40 blur-3xl" aria-hidden="true"></div>

          <WaitlistFormCard />
          <WaitlistConfirmationCard />
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Mobile: clip the decorative blur orbs / SVG that bleed past <main>'s
     own box edges (right side, and — since main is no longer height-
     locked with overflow-hidden on mobile — below the bottom edge too).
     `clip`, not `hidden`: `hidden` establishes an actual (if invisible)
     scroll container, which is what caused the earlier stuttery,
     non-native scroll when this was overflow-x-hidden/overflow-y-visible.
     `clip` never creates a scroll container on either axis, so it clips
     the overflow with zero effect on the page's native scroll behavior.
     Overridden at lg by the existing lg:overflow-hidden Tailwind class
     (class selector beats this bare-element one), which intentionally
     locks the whole section to exactly one viewport on desktop. */
  main {
    overflow: clip;
  }

  /* Stage height crossfade — the form panel and the next-steps panel
     have different natural heights, so swapping which one is visible
     used to make this section's box snap instantly to the new height.
     JS (switchScreens below) locks the stage to its current height right
     before a swap, then animates it to the incoming panel's height — this
     transition is what makes that resize glide instead of jump. Moved
     here from the old WaitlistSplitCard.astro along with the
     `.waitlist-stage` element itself. */
  .waitlist-stage {
    transition: min-height 0.35s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .waitlist-stage {
      transition: none;
    }
  }
</style>

<script>
  // Full waitlist submit / screen-swap / animation logic, moved here from
  // the old WaitlistSplitCard.astro now that the split card and next-steps
  // panels live in two separate components (WaitlistFormCard.astro and
  // WaitlistConfirmationCard.astro). Element lookups below target IDs
  // owned by those two components; see the "Astro scoping note" comments
  // in each of those files for how the shared keyframe animations
  // (`split-card-in`, `split-card-float`, `screen-enter`, `screen-leave`)
  // stay resolvable across the component boundary.
  const JOINED_COOKIE_NAME = 'huzlly_waitlist_joined';

  function getCookie(name: string): string | null {
    const match = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  // ~1 year expiry, site-wide path — set on successful form submission
  // only (not on the "already reserved" bypass button), so a returning
  // visitor who actually joined skips straight to the confirmation panel
  // on their next visit.
  function setJoinedCookie() {
    const oneYearInSeconds = 60 * 60 * 24 * 365;
    document.cookie = `${JOINED_COOKIE_NAME}=1; max-age=${oneYearInSeconds}; path=/`;
  }

  const alreadyJoined = getCookie(JOINED_COOKIE_NAME) === '1';

  const form = document.getElementById('waitlist-form');
  const errorEl = document.getElementById('waitlist-error');
  const splitCard = document.getElementById('waitlist-split-card');
  const nextSteps = document.getElementById('waitlist-next-steps');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const emailInput = document.getElementById('waitlist-email') as HTMLInputElement | null;
  const successTitle = document.getElementById('waitlist-success-title');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktopViewport = () => window.matchMedia('(min-width: 1024px)').matches;

  // The split card's entire animation lifecycle (one-shot entrance on
  // mount, persistent idle float on desktop, leave/re-enter on toggle) is
  // driven from here via inline `style.animation`, not CSS classes. Every
  // one of these phases used to be a separate class fighting the others
  // over the same `animation` property, and whichever class got removed
  // last, the card fell back to whatever the cascade resolved to next —
  // sometimes the base (invisible) state, sometimes a restarted entrance.
  // Setting `style.animation` directly sidesteps that entirely: inline
  // style always wins, so there's only ever one animation active at a
  // time and it's always the one we just chose.
  function setSplitCardAnimation(phase: 'idle' | 'enter' | 'leave') {
    if (!splitCard) return;

    if (prefersReducedMotion) {
      splitCard.style.animation = 'none';
      splitCard.style.opacity = '1';
      splitCard.style.transform = 'none';
      return;
    }

    if (phase === 'idle') {
      splitCard.style.opacity = '1';
      splitCard.style.transform = 'translateY(0)';
      splitCard.style.animation = isDesktopViewport()
        ? 'split-card-float 9s ease-in-out infinite'
        : 'none';
      return;
    }

    if (phase === 'enter') {
      splitCard.style.animation = 'screen-enter 0.6s ease-out forwards';
      splitCard.addEventListener('animationend', () => setSplitCardAnimation('idle'), { once: true });
      return;
    }

    if (phase === 'leave') {
      splitCard.style.animation = 'screen-leave 0.4s ease-in forwards';
    }
  }

  // Initial page-load state. If the visitor already has the "joined"
  // cookie set, skip the split card entirely (no entrance animation, no
  // idle float — just hide it) and show the confirmation panel directly
  // in its final visible/static state, with the "already joined" title.
  // Otherwise, behave exactly as before: play the one-shot entrance, then
  // hand off to the idle float.
  if (alreadyJoined) {
    if (splitCard) {
      splitCard.style.animation = 'none';
      splitCard.style.display = 'none';
    }
    if (nextSteps) {
      nextSteps.classList.remove('hidden');
      nextSteps.style.display = 'flex';
    }
    if (successTitle) {
      successTitle.textContent = "You're already on the list.";
    }
  } else if (splitCard) {
    if (prefersReducedMotion) {
      setSplitCardAnimation('idle');
    } else {
      splitCard.style.animation = 'split-card-in 1.1s ease-out forwards';
      splitCard.addEventListener('animationend', () => setSplitCardAnimation('idle'), { once: true });
    }
  }

  // Swap `border-rail` <-> `border-red-500` rather than stacking a second
  // border-color utility on top — two classes setting the same property at
  // equal specificity is exactly what broke the split-card/next-steps
  // toggle earlier, so this always removes the one it's not using.
  function setEmailInvalid(invalid: boolean) {
    if (!emailInput) return;
    if (invalid) {
      emailInput.classList.remove('border-rail');
      emailInput.classList.add('border-red-500');
    } else {
      emailInput.classList.remove('border-red-500');
      emailInput.classList.add('border-rail');
    }
  }

  // Clear the error state as soon as the person starts fixing the email.
  emailInput?.addEventListener('input', () => {
    errorEl?.classList.add('hidden');
    setEmailInvalid(false);
  });

  // Mobile keyboard fix: once the on-screen keyboard opens, the viewport
  // shrinks and this input (sitting inside the lower half of the split
  // card) can end up covered by the keyboard. The `overflow-hidden` that
  // used to sit on the page's <main> (mobile) has been removed for this
  // reason — that's what made the page unscrollable in the first place.
  //
  // Driven off `visualViewport`'s `resize` event rather than the input's
  // own `focus` event: focus only fires on an actual focus transition,
  // but Android's back button dismisses the keyboard WITHOUT blurring the
  // input — so tapping the still-focused input again to reopen the
  // keyboard fires no `focus` event at all, and a focus-only listener
  // would silently stop working after that. `visualViewport.resize`
  // fires on every keyboard open/close regardless of focus state, so it
  // keeps nudging the input back into view each time the keyboard
  // reopens. Falls back to the old focus-based nudge on browsers without
  // `visualViewport` (older Safari).
  function nudgeEmailIntoView() {
    if (!emailInput || document.activeElement !== emailInput) return;
    emailInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', () => {
      window.setTimeout(nudgeEmailIntoView, 50);
    });
  } else {
    emailInput?.addEventListener('focus', () => {
      window.setTimeout(nudgeEmailIntoView, 300);
    });
  }

  // Animated swap between the split-card (screen 1) and next-steps
  // (screen 2) panels — used for both directions (submit → next-steps,
  // "Go back" → split-card). `fromEl` fades/slides out first, then
  // `toEl` is unhidden and fades/slides in, so the two never render
  // stacked/overlapping mid-transition. `toDisplay` is the display value
  // to apply to `toEl` once it's shown ('flex' for next-steps, '' for
  // split-card so its own responsive `lg:grid` etc. classes take over
  // instead of a hardcoded value).
  function switchScreens(fromEl: HTMLElement | null, toEl: HTMLElement | null, toDisplay: string) {
    if (!fromEl || !toEl) return;

    // The form panel and the next-steps panel have different natural
    // heights, so swapping which one is visible used to snap the shared
    // stage instantly to the new height. Lock the stage at its current
    // height first, then (once the incoming panel is laid out) animate
    // toward its height instead — the `.waitlist-stage` CSS transition
    // above does the actual gliding.
    const stage = fromEl.closest('section');
    if (stage) {
      stage.style.minHeight = `${stage.getBoundingClientRect().height}px`;
    }

    const enterToEl = () => {
      toEl.classList.remove('hidden');
      toEl.style.display = toDisplay;

      if (stage) {
        if (prefersReducedMotion) {
          stage.style.minHeight = '';
        } else {
          // Wait a frame so toEl has its final layout before measuring.
          requestAnimationFrame(() => {
            stage.style.minHeight = `${toEl.getBoundingClientRect().height}px`;
          });
          stage.addEventListener('transitionend', () => {
            stage.style.minHeight = '';
          }, { once: true });
        }
      }

      if (prefersReducedMotion) return;

      // The split card drives its own enter animation (and the follow-up
      // hand-off to the idle float) via setSplitCardAnimation — see
      // above — rather than the shared `.screen-enter` class, since it's
      // the one panel with a persistent idle state to return to.
      if (toEl === splitCard) {
        setSplitCardAnimation('enter');
        return;
      }

      toEl.classList.add('screen-enter');
      toEl.addEventListener('animationend', () => {
        toEl.classList.remove('screen-enter');
      }, { once: true });
    };

    if (prefersReducedMotion) {
      fromEl.style.display = 'none';
      enterToEl();
      return;
    }

    if (fromEl === splitCard) {
      setSplitCardAnimation('leave');
      splitCard.addEventListener('animationend', () => {
        fromEl.style.display = 'none';
        enterToEl();
      }, { once: true });
      return;
    }

    fromEl.classList.add('screen-leave');
    fromEl.addEventListener('animationend', () => {
      fromEl.style.display = 'none';
      fromEl.classList.remove('screen-leave');
      enterToEl();
    }, { once: true });
  }

  // "Already reserved your spot?" — bypasses the form/API entirely and
  // jumps straight to the next-steps screen, same as a real duplicate
  // response would (title reads "You're already on the list."). Does NOT
  // set the "joined" cookie — only an actual successful form submit does.
  const alreadyReservedBtn = document.getElementById('waitlist-already-reserved');
  alreadyReservedBtn?.addEventListener('click', () => {
    showSuccess(true);
  });

  function showError(message: string, emailInvalid = false) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    setEmailInvalid(emailInvalid);
  }

  function showSuccess(duplicate: boolean) {
    if (successTitle) {
      successTitle.textContent = duplicate ? "You're already on the list." : "You're on the list.";
    }
    switchScreens(splitCard, nextSteps, 'flex');
  }

  // "Go back" on the next-steps screen — same animated swap as
  // showSuccess, just reversed. Works the same regardless of whether the
  // "joined" cookie is set — it only affects the initial page-load state.
  const goBackBtn = document.getElementById('waitlist-go-back');
  goBackBtn?.addEventListener('click', () => {
    switchScreens(nextSteps, splitCard, '');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    setEmailInvalid(false);

    const companyInput = document.getElementById('waitlist-company') as HTMLInputElement;
    const email = emailInput ? emailInput.value.trim() : '';

    if (!EMAIL_RE.test(email)) {
      showError('Enter a valid email address to join the waitlist.', true);
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, company: companyInput ? companyInput.value : '' }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showError('Something went wrong on our end — try again in a moment.');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      // A real, successful form submission — set the "joined" cookie so a
      // returning visitor skips straight to the confirmation panel next
      // time, regardless of whether the server reported it as a
      // duplicate.
      setJoinedCookie();
      showSuccess(Boolean(data.duplicate));
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
