---
import Layout from '../layouts/Layout.astro';
import WaitlistSplitCard from '../components/sections/WaitlistSplitCard.astro';
import { FileText, PenTool, CreditCard, Inbox } from 'lucide-astro';

const steps = [
  { icon: FileText, title: 'You join the list', body: 'Takes ten seconds. No credit card, no account to set up yet.' },
  { icon: PenTool, title: "We'll send an invite", body: 'As the beta cohort opens up spots, we email invites in order.' },
  { icon: CreditCard, title: 'You set up your flow', body: 'Connect your proposal, contract, and invoicing steps in one sitting.' },
  { icon: Inbox, title: 'Clients move through it', body: 'Every new client goes proposal to a running project without you chasing a thing.' },
];
---

<Layout title="Join the Waitlist | Huzlly"
  description="Join the Huzlly closed beta waitlist. 50 spots this cohort for freelancers who want proposals, contracts, invoicing, and projects running in one automatic flow."
  canonicalPath="/waitlist"
>
  <main>
    <WaitlistSplitCard />

    <section class="bg-paper px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center font-display text-2xl sm:text-3xl font-semibold tracking-tight text-ink">
          What happens after you join
        </h2>
        <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((step, i) => (
            <div class="text-center sm:text-left">
              <span class="font-mono text-xs text-blue-600/70">{String(i + 1).padStart(2, '0')}</span>
              <span class="mt-2 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 mx-auto sm:mx-0">
                <step.icon class="w-5 h-5" stroke-width="1.75" />
              </span>
              <h3 class="mt-4 text-base font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-sm text-ink/70 leading-relaxed">{step.body}</p>
            </div>
          ))}
        </div>

        <p class="mt-14 text-center text-sm text-ink/50">
          Have a question first? Check the <a href="/faq" class="text-blue-600 font-semibold hover:text-blue-700">FAQ</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>
