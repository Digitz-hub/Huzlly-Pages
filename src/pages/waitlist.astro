---
import Layout from '../layouts/Layout.astro';
import WaitlistSplitCard from '../components/sections/WaitlistSplitCard.astro';
---

<Layout title="Join the Waitlist | Huzlly"
  description="Join the Huzlly closed beta waitlist. 50 spots this cohort for freelancers who want proposals, contracts, invoicing, and projects running in one automatic flow."
  canonicalPath="/waitlist"
  hideChrome={true}
>
  <main class="relative flex min-h-[100dvh] flex-col items-center overflow-hidden bg-gradient-to-tr from-blue-700 via-indigo-600 to-sky-400 px-6 py-6 sm:px-10 sm:py-8 lg:h-[100dvh] lg:overflow-hidden lg:px-16 lg:py-10">
    <!-- Layered radial mesh wash for extra depth on top of the base gradient -->
    <div
      class="pointer-events-none absolute inset-0 -z-30"
      aria-hidden="true"
      style="background-image: radial-gradient(45% 40% at 10% 5%, rgba(196,181,253,0.6), transparent 65%), radial-gradient(40% 38% at 95% 8%, rgba(103,232,249,0.55), transparent 65%);"
    ></div>

    <!-- Curved floor / horizon: deep navy pooling at the bottom, blending up into the vibrant gradient — this is what gives the card something dark to visually "land" on -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-20 h-[62%]"
      aria-hidden="true"
      style="background-image: linear-gradient(to top, #05060f 0%, rgba(11,19,43,0.92) 22%, rgba(20,22,74,0.55) 55%, transparent 100%);"
    ></div>
    <div
      class="pointer-events-none absolute bottom-[-18%] left-1/2 -z-20 h-[46%] w-[150%] -translate-x-1/2 rounded-[50%] bg-[#03040c]/80 blur-3xl"
      aria-hidden="true"
    ></div>

    <!-- Faint horizon curve line — reinforces the sense of a curved 3D surface beneath the card -->
    <svg
      class="pointer-events-none absolute inset-x-0 bottom-[8%] -z-10 h-40 w-full opacity-40 sm:bottom-[10%]"
      viewBox="0 0 1440 200"
      preserveAspectRatio="none"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-50 40 Q 720 160 1490 40" stroke="url(#horizonGlow)" stroke-width="1.5" stroke-linecap="round" />
      <defs>
        <linearGradient id="horizonGlow" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="white" stop-opacity="0" />
          <stop offset="50%" stop-color="#a5f3fc" stop-opacity="0.8" />
          <stop offset="100%" stop-color="white" stop-opacity="0" />
        </linearGradient>
      </defs>
    </svg>

    <!-- Soft ambient blur orbs — smaller + more saturated/contrasting so they read as distinct shapes in the thin visible margin, not just extra gradient -->
    <div class="pointer-events-none absolute -left-10 -top-10 -z-10 h-40 w-40 rounded-full bg-fuchsia-300/50 blur-2xl sm:h-56 sm:w-56" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-8 -top-14 -z-10 h-36 w-36 rounded-full bg-cyan-200/60 blur-2xl sm:h-48 sm:w-48" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-14 -left-10 -z-10 h-44 w-44 rounded-full bg-violet-400/40 blur-2xl sm:h-60 sm:w-60" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-10 -right-10 -z-10 h-40 w-40 rounded-full bg-sky-300/50 blur-2xl sm:h-56 sm:w-56" aria-hidden="true"></div>

    <!-- Ribbon-wave motif: dense, edge-hugging flowing lines (top-right + bottom-left),
         kept close to the actual visible margin band — the card covers most of the
         viewport here, so curves are anchored near the true edges rather than the
         wider corner spread that would work on a page with more visible background. -->
    <svg
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      aria-hidden="true"
    >
      <!-- Top-right cluster -->
      <g stroke="white" stroke-linecap="round">
        <path d="M900 -60 C 1080 20, 1200 -70, 1360 10 S 1620 0, 1720 90" stroke-width="2" opacity="0.6" />
        <path d="M880 10 C 1060 90, 1180 0, 1340 80 S 1600 70, 1700 160" stroke-width="1.75" opacity="0.5" />
        <path d="M860 80 C 1040 160, 1160 70, 1320 150 S 1580 140, 1680 230" stroke-width="1.5" opacity="0.38" />
        <path d="M840 150 C 1020 230, 1140 140, 1300 220 S 1560 210, 1660 300" stroke-width="1.5" opacity="0.26" />
      </g>

      <!-- Bottom-left cluster (mirrored) -->
      <g stroke="white" stroke-linecap="round">
        <path d="M-100 780 C 20 700, 140 800, 280 720 S 460 730, 560 650" stroke-width="2" opacity="0.55" />
        <path d="M-120 840 C 0 760, 120 860, 260 780 S 440 790, 540 710" stroke-width="1.75" opacity="0.44" />
        <path d="M-140 900 C -20 820, 100 920, 240 840 S 420 850, 520 770" stroke-width="1.5" opacity="0.3" />
      </g>

      <!-- Scattered dot accents, close to the visible edges -->
      <circle cx="120" cy="60" r="5" fill="white" opacity="0.6" />
      <circle cx="1360" cy="420" r="4.5" fill="white" opacity="0.5" />
      <circle cx="60" cy="480" r="4" fill="white" opacity="0.5" />
    </svg>

    <!-- Card stage: everything here is layered so the card reads as physically elevated above a dark floor -->
    <div class="relative flex w-full flex-1 items-center justify-center lg:overflow-hidden">

      <!-- Glassy outer glow ring — sits behind the card, bleeding a soft colored halo into the margin so the white card's edge reads crisp rather than blending into the gradient -->
      <div
        class="pointer-events-none absolute -inset-4 -z-10 rounded-[2.5rem] bg-gradient-to-b from-white/25 via-sky-200/15 to-transparent opacity-80 blur-2xl sm:-inset-8"
        aria-hidden="true"
      ></div>

      <!-- Ground contact shadow — a flat, wide, blurred dark ellipse anchored beneath the card to fake a contact point on the "floor" -->
      <div
        class="pointer-events-none absolute bottom-[2%] left-1/2 -z-10 h-10 w-[78%] -translate-x-1/2 rounded-[50%] bg-slate-950/70 blur-2xl sm:h-16 sm:w-[62%] lg:bottom-[4%]"
        aria-hidden="true"
      ></div>

      <!-- Rim light — a thin bright glow riding just above the contact shadow, giving the bottom edge of the card a lit contour against the dark floor -->
      <div
        class="pointer-events-none absolute bottom-[9%] left-1/2 -z-10 h-1.5 w-[45%] -translate-x-1/2 rounded-full bg-sky-200/60 blur-md sm:bottom-[11%] lg:bottom-[13%]"
        aria-hidden="true"
      ></div>

      <!-- Card wrapper: a chained drop-shadow filter hugs the card's actual rounded silhouette (unlike a plain box-shadow div, this shapes itself to the card, including its corners) for a realistic, layered elevation shadow -->
      <div class="relative w-full [filter:drop-shadow(0_45px_70px_rgba(2,6,23,0.55))_drop-shadow(0_18px_28px_rgba(2,6,23,0.4))]">
        <WaitlistSplitCard />
      </div>
    </div>

    <p class="shrink-0 pt-2 text-center text-sm text-white/80 [text-shadow:0_1px_3px_rgba(0,0,0,0.45)]">
      <a href="/" class="rounded text-white/80 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Home</a>
      <span class="px-2 text-white/50" aria-hidden="true">·</span>
      <a href="/privacy" class="rounded text-white/80 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Privacy</a>
      <span class="px-2 text-white/50" aria-hidden="true">·</span>
      <a href="/terms" class="rounded text-white/80 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Terms</a>
    </p>
  </main>
</Layout>
