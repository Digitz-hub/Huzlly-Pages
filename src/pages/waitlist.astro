---
import Layout from '../layouts/Layout.astro';
import WaitlistSplitCard from '../components/sections/WaitlistSplitCard.astro';
---

<Layout title="Join the Waitlist | Huzlly"
  description="Join the Huzlly closed beta waitlist. 50 spots this cohort for freelancers who want proposals, contracts, invoicing, and projects running in one automatic flow."
  canonicalPath="/waitlist"
  hideChrome={true}
>
  <main class="relative flex min-h-[100dvh] flex-col items-center overflow-hidden bg-gradient-to-tr from-blue-700 via-indigo-600 to-sky-400 px-6 py-6 sm:px-10 sm:py-8 lg:h-[100dvh] lg:overflow-hidden lg:px-16 lg:py-10">
    <!-- Layered radial mesh wash for extra depth on top of the base gradient -->
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
      style="background-image: radial-gradient(45% 40% at 10% 5%, rgba(196,181,253,0.6), transparent 65%), radial-gradient(40% 38% at 95% 8%, rgba(103,232,249,0.55), transparent 65%), radial-gradient(50% 45% at 50% 105%, rgba(30,27,140,0.65), transparent 65%);"
    ></div>

    <!-- Soft ambient blur orbs — smaller + more saturated/contrasting so they read as distinct shapes in the thin visible margin, not just extra gradient -->
    <div class="pointer-events-none absolute -left-10 -top-10 -z-10 h-40 w-40 rounded-full bg-fuchsia-300/50 blur-2xl sm:h-56 sm:w-56" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-8 -top-14 -z-10 h-36 w-36 rounded-full bg-cyan-200/60 blur-2xl sm:h-48 sm:w-48" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-14 -left-10 -z-10 h-44 w-44 rounded-full bg-violet-300/50 blur-2xl sm:h-60 sm:w-60" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-10 -right-10 -z-10 h-40 w-40 rounded-full bg-sky-200/60 blur-2xl sm:h-56 sm:w-56" aria-hidden="true"></div>

    <!-- Subtle wavy line motif — higher contrast so it's actually visible against the gradient -->
    <svg
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-30"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-100 120 C 260 20, 520 240, 880 110 S 1500 20, 1600 150" stroke="white" stroke-width="2" stroke-linecap="round" />
      <path d="M-100 800 C 260 900, 520 680, 880 810 S 1500 900, 1600 780" stroke="white" stroke-width="2" stroke-linecap="round" />
      <path d="M-100 60 C 260 -20, 520 160, 880 50 S 1500 -20, 1600 90" stroke="white" stroke-width="1.5" stroke-linecap="round" />
      <path d="M-100 860 C 260 940, 520 760, 880 850 S 1500 940, 1600 820" stroke="white" stroke-width="1.5" stroke-linecap="round" />
    </svg>

    <div class="flex w-full flex-1 items-center justify-center lg:overflow-hidden">
      <WaitlistSplitCard />
    </div>

    <p class="shrink-0 pt-2 text-center text-sm text-white/70">
      <a href="/" class="rounded text-white/70 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Home</a>
      <span class="px-2 text-white/40" aria-hidden="true">·</span>
      <a href="/privacy" class="rounded text-white/70 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Privacy</a>
      <span class="px-2 text-white/40" aria-hidden="true">·</span>
      <a href="/terms" class="rounded text-white/70 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Terms</a>
    </p>
  </main>
</Layout>
