---
import Layout from '../layouts/Layout.astro';
import WaitlistSplitCard from '../components/sections/WaitlistSplitCard.astro';
---

<Layout title="Join the Waitlist | Huzlly"
  description="Join the Huzlly closed beta waitlist. 50 spots this cohort for freelancers who want proposals, contracts, invoicing, and projects running in one automatic flow."
  canonicalPath="/waitlist"
  hideChrome={true}
>
  <main class="flex min-h-[100dvh] flex-col items-center px-6 py-6 sm:px-10 sm:py-8 lg:h-[100dvh] lg:overflow-hidden lg:px-16 lg:py-10">
    <div class="flex w-full flex-1 items-center justify-center lg:overflow-hidden">
      <WaitlistSplitCard />
    </div>

    <p class="shrink-0 pt-2 text-center text-sm text-ink/50">
      <a href="/" class="rounded hover:text-ink/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Home</a>
      <span class="px-2" aria-hidden="true">·</span>
      <a href="/privacy" class="rounded hover:text-ink/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Privacy</a>
      <span class="px-2" aria-hidden="true">·</span>
      <a href="/terms" class="rounded hover:text-ink/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Terms</a>
    </p>
  </main>
</Layout>
