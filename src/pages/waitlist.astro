---
import Layout from '../layouts/Layout.astro';
import WaitlistSplitCard from '../components/sections/WaitlistSplitCard.astro';
---

<Layout title="Join the Waitlist | Huzlly"
  description="Join the Huzlly closed beta waitlist. 50 spots this cohort for freelancers who want proposals, contracts, invoicing, and projects running in one automatic flow."
  canonicalPath="/waitlist"
  hideChrome={true}
>
  <main class="relative flex min-h-[100dvh] flex-col items-center overflow-hidden bg-gradient-to-tr from-blue-700 via-indigo-600 to-sky-400 px-6 py-6 sm:px-10 sm:py-8 lg:h-[100dvh] lg:overflow-hidden lg:px-16 lg:py-10">
    <!-- Layered radial mesh wash for extra depth on top of the base gradient -->
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
      style="background-image: radial-gradient(60% 55% at 15% 10%, rgba(129,140,248,0.55), transparent 60%), radial-gradient(55% 50% at 90% 15%, rgba(56,189,248,0.45), transparent 60%), radial-gradient(65% 60% at 50% 100%, rgba(30,64,175,0.55), transparent 60%);"
    ></div>

    <!-- Soft ambient blur orbs -->
    <div class="pointer-events-none absolute -left-24 -top-24 -z-10 h-72 w-72 rounded-full bg-sky-300/40 blur-3xl sm:h-96 sm:w-96" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 -right-16 -z-10 h-80 w-80 rounded-full bg-indigo-400/40 blur-3xl sm:h-[26rem] sm:w-[26rem]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute right-1/4 top-1/3 -z-10 h-56 w-56 rounded-full bg-blue-200/20 blur-3xl" aria-hidden="true"></div>

    <!-- Subtle wavy line motif -->
    <svg
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.12]"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-100 180 C 260 60, 520 300, 880 160 S 1500 60, 1600 200" stroke="white" stroke-width="1.5" />
      <path d="M-100 380 C 260 260, 520 500, 880 360 S 1500 260, 1600 400" stroke="white" stroke-width="1.5" />
      <path d="M-100 600 C 260 480, 520 720, 880 580 S 1500 480, 1600 620" stroke="white" stroke-width="1.5" />
      <path d="M-100 800 C 260 700, 520 920, 880 780 S 1500 700, 1600 820" stroke="white" stroke-width="1.5" />
    </svg>

    <!-- Fine grain / noise-free glass sheen behind the card -->
    <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[75%] w-[90%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>

    <div class="flex w-full flex-1 items-center justify-center lg:overflow-hidden">
      <WaitlistSplitCard />
    </div>

    <p class="shrink-0 pt-2 text-center text-sm text-white/70">
      <a href="/" class="rounded text-white/70 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Home</a>
      <span class="px-2 text-white/40" aria-hidden="true">·</span>
      <a href="/privacy" class="rounded text-white/70 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Privacy</a>
      <span class="px-2 text-white/40" aria-hidden="true">·</span>
      <a href="/terms" class="rounded text-white/70 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Terms</a>
    </p>
  </main>
</Layout>
