---
// src/pages/privacy.astro

import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import { Mail } from 'lucide-astro';

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'information-we-collect', label: 'Information We Collect' },
  { id: 'how-we-use-it', label: 'How We Use It' },
  { id: 'sharing', label: 'Sharing & Third Parties' },
  { id: 'retention', label: 'Data Retention' },
  { id: 'your-rights', label: 'Your Rights' },
  { id: 'cookies', label: 'Cookies & Analytics' },
  { id: 'security', label: 'Security' },
  { id: 'children', label: "Children's Privacy" },
  { id: 'international', label: 'International Users' },
  { id: 'changes', label: 'Changes to This Policy' },
  { id: 'contact', label: 'Contact' },
];
---

<Layout
  title="Privacy Policy | Huzlly"
  description="How Huzlly collects, uses, and protects your data. This page is a structural draft — Huzlly is in closed beta and finalizing its legal language."
  canonicalPath="/privacy"
  ogImage="/og/og-privacy.png"
>
  <main>
    <!-- Hero -->
    <section class="bg-white px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl rounded-3xl bg-blue-50/50 sm:bg-blue-50/40 px-6 py-16 text-center sm:px-12 sm:py-24 mt-6">
        <p class="text-xs font-medium uppercase tracking-wide text-blue-600">Legal</p>
        <h1 class="mt-2 text-4xl sm:text-6xl font-bold tracking-tight text-gray-900 leading-tight">
          Privacy <span class="text-blue-600">Policy</span>
        </h1>
        <p class="mt-4 text-sm sm:text-base text-gray-600 max-w-xl mx-auto leading-relaxed">
          How Huzlly collects, uses, and protects your data. Huzlly is in closed beta, and this
          policy is being finalized alongside it.
        </p>

        <nav aria-label="Jump to section" class="mt-8 flex flex-wrap justify-center gap-2">
          {sections.map((section) => (
            <a href={`#${section.id}`}
              class="rounded-full bg-white border border-gray-200 px-4 py-1.5 text-xs sm:text-sm font-medium text-gray-700 shadow-sm transition-all hover:border-blue-300 hover:text-blue-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
            >
              {section.label}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- Draft notice -->
    <section class="bg-white px-4 pt-16 sm:px-6 sm:pt-20 lg:px-8">
      <div class="mx-auto max-w-3xl rounded-lg border-2 border-amber-200 bg-amber-50 p-6 sm:p-8">
        <Badge variant="warning">Structural draft &middot; not legal advice</Badge>
        <p class="mt-4 text-sm text-gray-700 leading-relaxed">
          This page lays out the sections a privacy policy like Huzlly's typically needs and what
          each one is for. It does not contain finished legal language. Every section below has a
          dashed placeholder block marking exactly where real legal copy needs to go — have that
          copy reviewed before this page goes live.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-3xl">

        <div id="overview" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">1. Overview</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A short, plain-language summary of what this policy covers and who it applies to —
            visitors to huzlly.com, waitlist signups, and closed-beta users of the product.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Scope statement, effective date, and who this policy covers.</p>
          </div>
        </div>

        <div id="information-we-collect" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">2. Information We Collect</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            What Huzlly collects directly (name and email from the waitlist and signup forms,
            account details) and what it collects through use of the product (proposal, contract,
            and payment workflow data; usage and device data).
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Itemized list of data categories collected, and whether each is required or optional.</p>
          </div>
        </div>

        <div id="how-we-use-it" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">3. How We Use It</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            The purposes data is used for — running the proposal-to-project flow, communicating
            about the waitlist and beta, improving the product, and legal or security purposes.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Purpose-by-purpose breakdown, and the legal basis for each if you're addressing GDPR-style requirements.</p>
          </div>
        </div>

        <div id="sharing" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">4. Sharing &amp; Third Parties</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Which third parties data passes through to make the flow work — e.g. payment
            processors, e-signature providers, hosting and infrastructure, email delivery — and
            the circumstances under which data would ever be shared beyond that.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Name the actual processors once they're locked in, plus your stance on sale of data (typically: none).</p>
          </div>
        </div>

        <div id="retention" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">5. Data Retention</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            How long data is kept — while an account is active, after cancellation, and for
            waitlist entries that never convert to an account.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Concrete retention periods or the criteria used to determine them.</p>
          </div>
        </div>

        <div id="your-rights" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">6. Your Rights</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            What people can ask for — access, correction, deletion, export — and how to submit
            that request.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Rights language for whichever regions you're targeting (e.g. GDPR, CCPA), and the request process.</p>
          </div>
        </div>

        <div id="cookies" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">7. Cookies &amp; Analytics</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Whether the site or product uses cookies or analytics tooling, what for, and how
            someone can opt out.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">List the actual tools in use once decided (or state plainly that none are used yet).</p>
          </div>
        </div>

        <div id="security" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">8. Security</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A general statement of the safeguards in place around stored data, and an
            acknowledgment that no system is guaranteed fully secure.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Security measures you're comfortable committing to publicly.</p>
          </div>
        </div>

        <div id="children" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">9. Children's Privacy</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A statement that Huzlly is not directed at children and is not knowingly used to
            collect data from them.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Minimum age statement and what happens if you learn a minor signed up.</p>
          </div>
        </div>

        <div id="international" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">10. International Users</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Where data is processed and stored, and how cross-border transfers are handled for
            users outside that region.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Your hosting region and transfer mechanism, if relevant to your user base.</p>
          </div>
        </div>

        <div id="changes" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">11. Changes to This Policy</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            How updates to this policy will be communicated, and how someone can tell when it was
            last changed.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Notice method (e.g. email, banner) and where the "last updated" date will live.</p>
          </div>
        </div>

        <div id="contact" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">12. Contact</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            How to reach Huzlly with privacy questions or a data request.
          </p>
          <p class="mt-4 flex items-center gap-2 text-sm text-gray-600">
            <Mail class="w-4 h-4 text-gray-400" stroke-width="2" />
            <a href="mailto:contact@huzlly.com" class="text-blue-600 font-semibold hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 rounded-md">
              contact@huzlly.com
            </a>
          </p>
        </div>

      </div>
    </section>
  </main>
</Layout>
