---
// src/pages/index.astro

import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import TheProblem from '../components/sections/TheProblem.astro';
import HowItWorks, { stageSummaries } from '../components/sections/HowItWorks.astro';
import WhyLean from '../components/sections/WhyLean.astro';
import WaitlistForm from '../components/sections/WaitlistForm.astro';


const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Huzlly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Huzlly is an all-in-one workspace for managing a freelance business — including clients, projects, tasks, contracts, and invoicing.',
  featureList: [
    'Automated proposal-to-contract handoff with email confirmation to both freelancer and client',
    'Automated contract-to-invoice and project creation on contract acceptance',
    'Per-task time tracking with automatic project-level totals and timesheets',
    'Permission-controlled client portal for documents, project progress, and direct communication',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free tier available; single flat-rate paid upgrade.',
  },
};

const howItWorksSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'How Huzlly works',
  itemListElement: stageSummaries.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.stage,
    description: s.headline,
  })),
};
---

<Layout
  title="Huzlly — Run your freelance business in one place"
  description="Manage clients, projects, tasks, contracts, and invoices from one organized workspace built for freelancers. Join the waitlist."
  canonicalPath="/"
>
  <main>
    <Hero />
    <TheProblem />
    <HowItWorks />
    <WhyLean />
    <WaitlistForm />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howItWorksSchema)} />
  </main>
</Layout>
