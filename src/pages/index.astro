---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Huzlly - Build & Scale Modern Web" description="Fast, SEO-optimized digital solutions tailored to scale your brand.">
  <main style="max-width: 900px; margin: 60px auto; padding: 0 20px; text-align: center;">
    <h1 style="font-size: 3rem; margin-bottom: 16px; color: #58a6ff;">Welcome to Huzlly</h1>
    <p style="font-size: 1.2rem; color: #8b949e; margin-bottom: 30px;">
      Zero lag, modern architecture powered by Astro & Cloudflare.
    </p>
    <a href="/pricing" style="display: inline-block; background: #238636; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;">
      Get Started
    </a>
  </main>
</Layout>
