---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import WhyLean from '../components/sections/WhyLean.astro';
import WaitlistForm from '../components/sections/WaitlistForm.astro';

// Minimal SoftwareApplication schema, page-specific per Layout.astro's
// sitewide-Organization / per-page-extra JSON-LD split. description and
// featureList are reused verbatim from SITE_IDENTITY_AND_AEO.md Section 5
// so the entity's capabilities stay consistent across every schema block
// sitewide.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Huzlly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Huzlly automates client onboarding, contracts, and payments for freelancers and solopreneurs in a single lean workflow, replacing bloated enterprise software.',
  featureList: [
    'Automated proposal-to-contract handoff with email confirmation to both freelancer and client',
    'Automated contract-to-invoice and project creation on contract acceptance',
    'Per-task time tracking with automatic project-level totals and timesheets',
    'Permission-controlled client portal for documents, project progress, and direct communication',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free tier available; single flat-rate paid upgrade.',
  },
};
---

<Layout
  title="Huzlly — One flow, not five apps"
  description="Huzlly automates client onboarding, contracts, invoicing, and projects for freelancers — one lean tool, no enterprise bloat. Join the waitlist."
  canonicalPath="/"
>
  <main>
    <Hero />
    <HowItWorks />
    <WhyLean />
    <WaitlistForm />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
  </main>
</Layout>
