---
// src/pages/index.astro

import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import TheProblem from '../components/sections/TheProblem.astro';
import HowItWorks, { stageSummaries } from '../components/sections/HowItWorks.astro';
import WhyLean from '../components/sections/WhyLean.astro';
import WaitlistForm from '../components/sections/WaitlistForm.astro';


const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Huzlly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Huzlly is an all-in-one workspace for managing a freelance business — including clients, projects, tasks, contracts, and invoicing.',
  featureList: [
    'Client management to organize client information and relationships',
    'Project and task management with deadlines and progress tracking',
    'Proposals and contracts to turn potential clients into active projects',
    'Invoicing and billing reminders for outstanding payments',
    'Payment-locked file delivery that unlocks client files only after invoice payment is received',
    'Client portal for sharing project updates, documents, and invoices',
    'Automation to reduce repetitive manual work in the freelance workflow',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free tier available; single flat-rate paid upgrade.',
  },
};

const howItWorksSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'How Huzlly works',
  itemListElement: stageSummaries.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.stage,
    description: s.headline,
  })),
};
---

<Layout
  title="Freelance Business Management Software | Huzlly"
  description="Manage clients, projects, tasks, contracts, and invoices with Huzlly - freelance business management software built for you, all in one organized workspace."
  canonicalPath="/"
>
  <main>
    <Hero />
    <TheProblem />
    <HowItWorks />
    <WhyLean />
    <WaitlistForm />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howItWorksSchema)} />
  </main>
</Layout>
