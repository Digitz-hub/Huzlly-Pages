---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturesSummary from '../components/sections/FeaturesSummary.astro';
import WaitlistForm from '../components/sections/WaitlistForm.astro';

// Minimal SoftwareApplication schema, page-specific per Layout.astro's
// sitewide-Organization / per-page-extra JSON-LD split.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Huzlly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Huzlly connects proposal approval, contract signing, payment collection, and client intake into one automated flow for solo freelancers.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free tier available; single flat-rate paid upgrade.',
  },
};
---

<Layout
  title="Huzlly — One flow, not five apps"
  description="Huzlly connects proposal approval, contract signing, payments, and intake into one automated flow for solo freelancers. No per-seat pricing, no bloat."
  canonicalPath="/"
>
  <main>
    <Hero />
    <FeaturesSummary />
    <WaitlistForm />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
  </main>
</Layout>
