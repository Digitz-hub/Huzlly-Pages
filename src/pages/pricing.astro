---
// src/pages/pricing.astro

import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import BlobDecoration from '../components/ui/BlobDecoration.astro';
import WaitlistCTA from '../components/sections/WaitlistCTA.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import type { FAQItem } from '../components/sections/FAQAccordion.astro';
import { Icon } from 'astro-icon/components';
import { ArrowRight, ArrowUpRight, Gift, Tag, SlidersHorizontal } from 'lucide-astro';

const promises = [
  {
    icon: Gift,
    title: 'There will be a free way in',
    body: 'Whatever the final pricing looks like, trying Huzlly won’t require a credit card up front.',
  },
  {
    icon: Tag,
    title: 'One flat upgrade, not a ladder',
    body: 'When you’re ready for more, it’s a single paid upgrade — not a stack of tiers to compare against each other.',
  },
  {
    icon: SlidersHorizontal,
    title: 'No per-seat math, ever',
    body: 'Huzlly is built for one freelancer running one flow. There’s no team pricing to design around, so there won’t be one.',
  },
];

const pricingFaq: FAQItem[] = [
  {
    question: 'So how much will Huzlly cost?',
    answer:
      'We haven’t locked in a number yet. Huzlly is in closed beta, and we’d rather price it after watching real freelancers run real client flows through it than guess up front.',
  },
  {
    question: 'Will there be hidden fees or per-seat pricing?',
    answer:
      'No. Huzlly is being built around one flat-rate tier instead of per-seat or usage-based pricing — that part is decided even though the number isn’t yet.',
  },
  {
    question: 'When will pricing be announced?',
    answer:
      'When Huzlly comes out of closed beta. Join the waitlist below and you’ll hear about it before it’s public anywhere else.',
  },
];
---

<Layout
  title="Pricing | Huzlly"
  description="Huzlly's pricing isn't public yet — we're pricing after closed beta, not before it. Here's what's already decided, and how to hear the number first."
  canonicalPath="/pricing"
  ogImage="/og/og-pricing.png"
  keywords="Huzlly pricing"
>
  <main>
    <!-- Hero -->
    <section class="bg-white px-4 pt-28 pb-20 sm:px-6 sm:pt-32 sm:pb-28 lg:px-8 lg:pt-40">
      <div class="mx-auto max-w-3xl text-center">
        <Badge variant="beta" class="mx-auto">Closed beta &middot; pricing not yet public</Badge>

        <SectionHeader
          as="h1"
          title="Simple Pricing for a Business That's Anything But Simple"
          subtitle="Huzlly's plans are taking shape. Join the waitlist to get early access and be the first to hear when pricing is announced."
          maxWidthClass="max-w-4xl"
          class="mt-6"
        />

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href="/waitlist" size="lg" motion>
            Get notified when pricing lands
            <ArrowRight class="w-4 h-4" stroke-width="1.75" />
          </Button>
          <Button href="#pricing-faq" variant="outline" size="lg">
            Read the pricing FAQ
          </Button>
        </div>
      </div>
    </section>

    <!-- What's already decided -->
    <section class="bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-2xl text-center">
          <div class="mx-auto inline-flex items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]">
            <Icon name="ph:check-circle-duotone" class="text-base" aria-hidden="true" />
            What we can tell you now
          </div>

          <h2 class="font-display mt-6 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
            The number isn't set. The shape of it already is.
          </h2>

          <p class="mt-4 text-lg leading-relaxed text-ink/70">
            These three things aren't changing between now and launch, whatever the price ends up being.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-3">
          {promises.map((promise) => (
            <Card variant="elevated" class="text-center sm:text-left">
              <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-paper sm:mx-0">
                <promise.icon class="w-5 h-5" stroke-width="1.75" />
              </span>
              <h3 class="font-display mt-4 text-base font-semibold text-ink">{promise.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{promise.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Why no number yet -->
    <section class="bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <Card variant="highlighted" class="relative overflow-hidden p-8 text-center !bg-electric sm:p-12">
          <BlobDecoration />

          <div class="relative z-10">
            <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
              Why we're not putting up a number yet
            </h2>
            <p class="mt-4 leading-relaxed text-white/80">
              Huzlly is onboarding 50 freelancers this cohort, on purpose — small enough that we
              can watch how the proposal-to-project flow actually gets used before we decide what
              it's worth charging for. A number picked before that feels like a guess. A number
              picked after it is a price.
            </p>
          </div>
        </Card>
      </div>
    </section>

    <!-- Pricing FAQ -->
    <section id="pricing-faq" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="mx-auto max-w-2xl text-center">
          <div class="mx-auto inline-flex items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]">
            <Icon name="ph:question-duotone" class="text-base" aria-hidden="true" />
            Pricing FAQ
          </div>

          <h2 class="font-display mt-6 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
            Questions people ask before there's a number
          </h2>
        </div>

        <div class="mt-14">
          <FAQAccordion items={pricingFaq} />
        </div>

        <div class="mt-10 text-center">
          <Button variant="accent" href="/faq">
            Check the full FAQ
            <ArrowUpRight class="w-4 h-4" stroke-width="1.75" />
          </Button>
        </div>
      </div>
    </section>

    <WaitlistCTA
      heading="Get pricing the moment it's live"
      subheading="Join the waitlist and you'll hear about pricing before it's public anywhere else — no sales calls, no spam."
    />
  </main>
</Layout>
