---
// src/pages/pricing.astro

import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import WaitlistCTA from '../components/sections/WaitlistCTA.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import type { FAQItem } from '../components/sections/FAQAccordion.astro';
import { ArrowUpRight } from 'lucide-astro';
import { Icon } from 'astro-icon/components';

const promises = [
  {
    icon: 'ph:trend-up-duotone',
    title: 'Start free, grow at your own pace',
  },
  {
    icon: 'ph:wallet-duotone',
    title: 'Pricing that fits your freelance business',
  },
  {
    icon: 'ph:check-circle-duotone',
    title: 'Simple to understand, easy to choose',
  },
];

const pricingFaq: FAQItem[] = [
  {
    question: 'How much will Huzlly cost?',
    answer:
      "Huzlly's pricing is still being finalized. We're working towards plans that are simple, transparent, and accessible for freelancers.",
  },
  {
    question: 'Will Huzlly have a free plan?',
    answer:
      "We're exploring a free plan so freelancers can get started without a large upfront commitment. More details will be shared when our plans are officially announced.",
  },
  {
    question: 'Will there be any hidden fees?',
    answer:
      'We believe pricing should be straightforward. Our goal is to keep plans transparent, with no confusing charges or unexpected surprises.',
  },
  {
    question: 'Will early users get special pricing?',
    answer:
      "We're still deciding what early access benefits may look like. Join the waitlist to stay informed about any special pricing or early-user offers.",
  },
  {
    question: 'When will Huzlly pricing be announced?',
    answer:
      'Pricing will be announced closer to launch. Join the waitlist to receive updates and be among the first to know when our plans are available.',
  },
];
---

<Layout
  title="Pricing | Huzlly"
  description="Huzlly's pricing isn't public yet — we're pricing after closed beta, not before it. Here's what's already decided, and how to hear the number first."
  canonicalPath="/pricing"
  ogImage="/og/og-pricing.png"
>
  <main>
    <!-- Hero + What's already decided -->
    <section class="bg-white px-4 pt-28 pb-20 sm:px-6 sm:pt-32 sm:pb-28 lg:px-8 lg:pt-40">
      <div class="mx-auto max-w-6xl">
        <SectionHeader
          as="h1"
          title={`Pricing built for the person\ndoing the work`}
          maxWidthClass="max-w-5xl"
          class="whitespace-pre-line hero-title"
        />
      </div>

      <div class="pricing-mesh-card mx-auto mt-24 grid max-w-6xl grid-cols-1 overflow-hidden rounded-2xl lg:grid-cols-12 lg:items-stretch">
        <div class="flex flex-col justify-center p-8 sm:p-10 lg:col-span-5">
          <h2 class="font-display text-2xl font-bold leading-tight tracking-tight text-ink sm:text-3xl">
            Simple pricing for the way you work.
          </h2>

          <p class="mt-5 text-base leading-relaxed text-ink/70">
            Huzlly's pricing is being designed to stay simple, transparent, and accessible for freelancers at every stage.
          </p>

          <Button href="/waitlist" size="lg" variant="primary" class="mt-10 w-fit group !bg-electric hover:!bg-electric">
            Get notified when pricing lands
            <Icon name="ph:caret-right" class="w-4 h-4 transition-transform duration-200 ease-in-out group-hover:translate-x-1" aria-hidden="true" />
          </Button>
        </div>

        <div class="p-8 sm:p-10 lg:col-span-7">
          <div class="flex h-full flex-col justify-center gap-4">
            {promises.map((promise) => (
              <div class="rounded-xl bg-gray-100 px-6 py-5">
                <div class="flex items-center gap-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white">
                    <Icon name={promise.icon} class="w-5 h-5 text-electric" aria-hidden="true" />
                  </span>
                  <h3 class="font-display text-base font-semibold leading-snug tracking-tight text-ink">{promise.title}</h3>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-10 text-center">
        <Button href="#pricing-faq" variant="outline" size="lg">
          Read the pricing FAQ
        </Button>
      </div>
    </section>

    <WaitlistCTA
      heading="Get the inside track on Huzlly pricing"
      subheading="Be among the first to hear about our plans, pricing, and what's coming next."
      variant="dark"
    />

    <!-- Pricing FAQ -->
    <section id="pricing-faq" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="mt-14">
          <FAQAccordion items={pricingFaq} />
        </div>

        <div class="mt-10 text-center">
          <Button variant="accent" href="/faq">
            Check the full FAQ
            <ArrowUpRight class="w-4 h-4" stroke-width="1.75" />
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .pricing-mesh-card {
    background-color: #ffffff;
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.12);
  }

  :global(.hero-title h1) {
    line-height: 1.3 !important;
  }
</style>
