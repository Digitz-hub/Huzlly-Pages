---
// src/pages/features.astro

import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import WaitlistCTA from '../components/sections/WaitlistCTA.astro';
import ProposalCard from '../components/ui/feature-cards/ProposalCard.astro';
import ContractCard from '../components/ui/feature-cards/ContractCard.astro';
import InvoiceCard from '../components/ui/feature-cards/InvoiceCard.astro';
import ProjectCard from '../components/ui/feature-cards/ProjectCard.astro';
import { ArrowRight } from 'lucide-astro';
import { Icon } from 'astro-icon/components';

const steps = [
  {
    icon: 'ph:file-text-duotone',
    title: 'Proposal to Contract, Automatically',
    chips: ['Auto-sends on approval', 'Confirmation email to both sides'],
    trigger:
      "Your client approves a proposal — right from the page you sent, no login or account for them to create.",
    controls:
      'Attach your contract template to a proposal and switch on automation once. Every proposal that gets approved from then on follows the same rule — you never have to remember to send the contract yourself.',
    outcome:
      "You and your client both get an instant confirmation email the moment the proposal is approved. If automation is on, the contract goes out in that same instant, pre-filled with the scope and pricing they just approved.",
    next: 'A signed contract is what releases the invoice and creates the project.',
  },
  {
    icon: 'ph:receipt-duotone',
    title: 'Contract Acceptance Creates the Invoice and the Project',
    chips: ['Invoice auto-sent on acceptance', 'Project created automatically'],
    trigger:
      'Your client reads the contract and accepts or rejects it — no separate e-signature app to open.',
    controls:
      "Set which invoice is linked to a contract ahead of time. Acceptance is what fires it, so you're never stuck manually raising an invoice right after a client signs.",
    outcome:
      'Either decision is confirmed by email to both of you. On acceptance, the linked invoice lands in your client\'s inbox immediately, and Huzlly creates a new project for that client at the same time — scoped and ready to work in.',
    next: "The project is live. You're logging real work in it within the same minute the contract was signed.",
  },
  {
    icon: 'ph:list-checks-duotone',
    title: 'Tasks and Time Tracking Inside Every Project',
    chips: ['Per-task timers', 'Auto-rolled project totals'],
    trigger:
      'A project exists — created the moment a contract was accepted, or started manually anytime.',
    controls:
      "Break the work into tasks as you go, and track time against each task individually while you're actually doing it, not reconstructed from memory at the end of the week.",
    outcome:
      "Every task's tracked time rolls up automatically into a single project total — no adding it up yourself. The full breakdown lives in your timesheet, so you always know exactly where a project's hours went.",
    next: "This is the time you'll bill against — no separate time-tracking app to keep in sync.",
  },
  {
    icon: 'ph:users-duotone',
    title: 'A Client Portal You Fully Control',
    chips: ['Off by default', 'Set per client, not sitewide'],
    trigger:
      "You decide to give a specific client portal access — nothing is shared until you turn it on.",
    controls:
      'Control access per client rather than sitewide: project visibility, task visibility, and direct communication can each be switched on or off independently for every client.',
    outcome:
      "Whatever you've allowed, your client can see: their proposals, contracts, and invoices to view or download, plus live project progress and task status. Where you've enabled communication, they can message you directly from the portal to request a change to a task or project.",
    next: "The client sees exactly as much as you choose to share, and nothing more.",
  },
];

const forYou = [
  'You\u2019re a solo freelancer, consultant, coach, or designer running your own client pipeline.',
  'You send proposals, contracts, and invoices yourself, and want project and time tracking in the same place.',
  'You want one flat price instead of a bill that grows with every seat you add.',
  'You want something that works the day you sign up, not after weeks of setup.',
];

const notForYou = [
  'Agencies or studios that need multiple logins, roles, or approval chains.',
  'Teams that need shared pipelines across several staff members.',
  'Businesses wanting a fully custom, build-your-own-CRM platform.',
  'Anyone who needs multi-seat collaboration on a single client account.',
];

const comparisons = [
  {
    icon: 'ph:stack-duotone',
    title: 'vs. Bonsai',
    body: 'Bonsai started lean but has grown into a fuller business-management suite, with team seats and enterprise-style add-ons layered on top of the core flow. Huzlly keeps proposal-to-project — including task and time tracking — in one connected flow, at a lower flat price, without the extra layers.',
  },
  {
    icon: 'ph:users-duotone',
    title: 'vs. HoneyBook',
    body: 'HoneyBook is built with studios and small teams in mind — its pricing and features assume more than one person working a pipeline. Huzlly skips the team layer entirely: one flat rate, built for the person actually doing the client work.',
  },
  {
    icon: 'ph:gear-six-duotone',
    title: 'vs. Dubsado',
    body: 'Dubsado is capable once it’s fully configured — but that configuration is the catch. Workflows, forms, and templates all need building before it does anything for you. Huzlly’s flow already exists, so you’re automating from day one, not week three.',
  },
];


const featureList = [
  'Automated proposal-to-contract handoff with email confirmation to both freelancer and client',
  'Automated contract-to-invoice and project creation on contract acceptance',
  'Per-task time tracking with automatic project-level totals and timesheets',
  'Permission-controlled client portal for documents, project progress, and direct communication',
];

// Presentation-only helpers (visual classes).
const pillBadge =
  'inline-flex items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]';
const softShadow = 'shadow-[0_10px_26px_-16px_rgba(20,24,43,0.14)]';
const liftHover =
  'transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_-16px_rgba(20,24,43,0.20)] motion-reduce:transition-none motion-reduce:hover:translate-y-0';
const glow =
  'pointer-events-none absolute inset-[-10%] rounded-full blur-[46px] opacity-[0.18] bg-[radial-gradient(circle_farthest-corner_at_50%_50%,transparent_0%,transparent_40%,#3B4EFF_100%)]';

// Hero trust points (real content). Class strings are written out in full so Tailwind's JIT can see them.
const heroTrustPoints = [
  { icon: 'ph:check-bold', label: 'End-to-end freelancer workflow', badge: 'bg-green-100 text-green-600' },
  { icon: 'ph:lightning-duotone', label: 'Smart automation between steps', badge: 'bg-blue-100 text-blue-600' },
  { icon: 'ph:users-duotone', label: 'A better experience for your clients', badge: 'bg-violet-100 text-violet-600' },
];

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Huzlly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Huzlly automates client onboarding, contracts, and payments for freelancers and solopreneurs in a single lean workflow, replacing bloated enterprise software.',
  featureList,
};
---

<Layout title="Features | Huzlly"
  description="Explore Huzlly's core features: automated contracts, invoicing, projects, and time tracking for freelancers who want less software, not more."
  canonicalPath="/features"
  ogImage="/og/og-features.png"
>
  <main>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />

    <!-- Hero -->
    <section class="relative isolate overflow-hidden bg-white px-4 pt-24 pb-20 sm:px-6 sm:pt-32 sm:pb-28 lg:px-8 lg:pt-40">
      <!-- Soft blue glow at the top (CSS only), replaces the old dot-grid. -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(ellipse_60%_100%_at_50%_0%,rgba(59,78,255,0.14),transparent_70%)]"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mx-auto max-w-3xl text-center">
        <div class={pillBadge}>
          <Icon name="ph:sparkle-duotone" class="text-base" aria-hidden="true" />
          Features
        </div>
        <h1 class="mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]">
          One flow, from proposal to <span class="text-blue-600">a running project.</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-ink/70 leading-relaxed max-w-2xl mx-auto">
          Proposal approval, contract signing, invoicing, and project setup — connected so each
          step starts the next one on its own. Here's exactly what happens at every stage, who
          gets notified, and what your client can see along the way.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="/waitlist" size="lg" motion>
            Join the waitlist
            <ArrowRight class="w-4 h-4" stroke-width="1.75" />
          </Button>
          <Button href="#comparisons" variant="outline" size="lg">
            See how it compares
          </Button>
        </div>
      </div>

      <!-- Hero trust points. Real content (semantic list, not aria-hidden). Wider than the text column, so it is
           its own container; relative z-10 keeps it above the side cards and connectors. Stacked below xl
           (the three items need ~1055px in one line, which does not fit the container at lg), one row with
           dividers from xl up. -->
      <div class="relative z-10 mx-auto mt-14 max-w-6xl">
        <ul class="mx-auto flex w-fit max-w-full flex-col items-start gap-4 xl:w-auto xl:flex-row xl:items-center xl:justify-center xl:gap-x-8">
          {heroTrustPoints.map((point, i) => (
            <li class="flex items-center">
              {i > 0 && (
                <span class="mr-8 hidden h-6 w-px bg-gray-200 xl:block" aria-hidden="true"></span>
              )}
              <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full ${point.badge}`}>
                <Icon name={point.icon} class="h-5 w-5" aria-hidden="true" />
              </span>
              <span class="ml-3 text-base font-normal text-ink/70 xl:whitespace-nowrap">{point.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Decorative dashed connector (left: Proposal -> Contract). Sits behind the cards (z-[-1]) and is locked to the
           left card wrappers: same origin, scale and horizontal anchoring, box top/height derived from the
           wrapper offsets + 288x116.8 card box + card rotations. The wrappers' top offsets are not scaled, so
           the gap in local units differs at xl (scale-75) vs 2xl (scale-100): one path per state. -->
      <svg
        class="pointer-events-none absolute z-[-1] hidden origin-top-left overflow-visible xl:block xl:left-0 xl:top-[310px] xl:h-[203px] xl:w-[288px] xl:scale-75 2xl:left-8 2xl:top-[340px] 2xl:h-[123px] 2xl:scale-100"
        fill="none"
        stroke="#a5b4fc"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path class="2xl:hidden" d="M75.16 0.49 C75.16 100.27 135.88 100.27 135.88 200.06" stroke-dasharray="4.95 5.94" />
        <path class="hidden 2xl:inline" d="M75.16 0.49 C75.16 60.27 154.55 60.27 154.55 120.06" stroke-dasharray="5.07 6.08" />
      </svg>

      <!-- Decorative hero side cards (left): Proposal above Contract, staggered. -->
      <div class="contents" aria-hidden="true">
        <div
          class="pointer-events-none absolute z-0 hidden origin-top-left xl:block xl:left-0 xl:top-[220px] xl:scale-75 2xl:left-8 2xl:scale-100"
          aria-hidden="true"
        >
          <ProposalCard />
        </div>
        <div
          class="pointer-events-none absolute z-0 hidden origin-top-left xl:block xl:-left-2 xl:top-[460px] xl:scale-75 2xl:left-10 2xl:scale-100"
          aria-hidden="true"
        >
          <ContractCard />
        </div>
      </div>

      <!-- Decorative dashed connector (right: Invoice -> Project). Sits behind the cards (z-[-1]) and is locked to the
           right card wrappers: same origin, scale and horizontal anchoring, box top/height derived from the
           wrapper offsets + 288x116.8 card box + card rotations. The wrappers' top offsets are not scaled, so
           the gap in local units differs at xl (scale-75) vs 2xl (scale-100): one path per state. -->
      <svg
        class="pointer-events-none absolute z-[-1] hidden origin-top-right overflow-visible xl:block xl:right-0 xl:top-[307.75px] xl:h-[208px] xl:w-[288px] xl:scale-75 2xl:right-8 2xl:top-[337px] 2xl:h-[128px] 2xl:scale-100"
        fill="none"
        stroke="#a5b4fc"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path class="2xl:hidden" d="M170.74 0.77 C170.74 103.17 94.57 103.17 94.57 205.57" stroke-dasharray="4.96 5.96" />
        <path class="hidden 2xl:inline" d="M170.74 0.77 C170.74 63.17 75.91 63.17 75.91 125.57" stroke-dasharray="4.84 5.81" />
      </svg>

      <!-- Decorative hero side cards (right): Invoice above Project, staggered. -->
      <div class="contents" aria-hidden="true">
        <div
          class="pointer-events-none absolute z-0 hidden origin-top-right xl:block xl:right-0 xl:top-[220px] xl:scale-75 2xl:right-8 2xl:scale-100"
          aria-hidden="true"
        >
          <InvoiceCard />
        </div>
        <div
          class="pointer-events-none absolute z-0 hidden origin-top-right xl:block xl:-right-2 xl:top-[460px] xl:scale-75 2xl:right-10 2xl:scale-100"
          aria-hidden="true"
        >
          <ProjectCard />
        </div>
      </div>
    </section>

    <!-- Is this for you -->
    <section class="bg-gray-50/70 px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <div class={pillBadge}>
            <Icon name="ph:user-circle-duotone" class="text-base" aria-hidden="true" />
            Who it's for
          </div>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink">
            Built for the person doing the work, not a team
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-ink/70">
            Huzlly is intentionally single-user first. That shapes everything below, so it's worth being upfront about it.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class={`rounded-2xl border border-[#e8e9f0] bg-white p-8 ${softShadow}`}>
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-100 text-electric">
                <Icon name="ph:user-circle-duotone" class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="text-lg font-semibold text-ink font-display">Huzlly is for you if</h3>
            </div>
            <ul class="mt-6 space-y-4">
              {forYou.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-50 text-electric">
                    <Icon name="ph:check-bold" class="h-3.5 w-3.5" aria-hidden="true" />
                  </span>
                  <span class="text-base text-ink/70 leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl bg-gray-100 p-8">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-ink/50">
                <Icon name="ph:users-three-duotone" class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="text-lg font-semibold text-ink/80 font-display">Not built for</h3>
            </div>
            <ul class="mt-6 space-y-4">
              {notForYou.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white text-ink/40">
                    <Icon name="ph:x-bold" class="h-3.5 w-3.5" aria-hidden="true" />
                  </span>
                  <span class="text-base text-ink/60 leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- The flow, in full -->
    <section class="bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <div class={pillBadge}>
            <Icon name="ph:flow-arrow-duotone" class="text-base" aria-hidden="true" />
            The flow
          </div>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink">
            From an approved proposal to a running project.
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-ink/70">
            Each step triggers the next one automatically. Here's what starts it, what you control, and what happens for you and your client.
          </p>
        </div>

        <ol class="relative mt-14 flex flex-col gap-6">
          <!-- Timeline rail (lg only) -->
          <div class="pointer-events-none absolute bottom-0 left-[21px] top-10 hidden w-px bg-gradient-to-b from-blue-200 via-blue-100 to-transparent lg:block" aria-hidden="true"></div>

          {steps.map((step, i) => (
            <li class="relative lg:pl-20">
              <!-- Timeline node (lg only) -->
              <span class="absolute left-0 top-8 hidden h-11 w-11 items-center justify-center rounded-full bg-blue-600 font-mono text-sm font-semibold text-white lg:flex" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class={`rounded-2xl border border-[#e8e9f0] bg-white p-6 sm:p-8 ${softShadow} ${liftHover}`}>
                <span class="mb-4 inline-flex h-7 items-center rounded-full bg-blue-600 px-3 font-mono text-xs font-semibold text-white lg:hidden" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>

                <div class="flex flex-wrap items-center gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-electric">
                    <Icon name={step.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <h3 class="text-xl font-semibold text-ink font-display">{step.title}</h3>
                  <div class="flex flex-wrap gap-2 sm:ml-auto">
                    {step.chips.map((chip) => (
                      <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700">{chip}</span>
                    ))}
                  </div>
                </div>

                <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
                  <div class="rounded-xl bg-gray-50 p-4">
                    <div class="flex items-center gap-2.5">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-electric">
                        <Icon name="ph:lightning-duotone" class="h-4 w-4" aria-hidden="true" />
                      </span>
                      <p class="text-sm font-semibold text-ink">Triggered by</p>
                    </div>
                    <p class="mt-3 text-sm text-ink/70 leading-relaxed">{step.trigger}</p>
                  </div>
                  <div class="rounded-xl bg-blue-50 p-4">
                    <div class="flex items-center gap-2.5">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-electric">
                        <Icon name="ph:sliders-horizontal-duotone" class="h-4 w-4" aria-hidden="true" />
                      </span>
                      <p class="text-sm font-semibold text-ink">You control</p>
                    </div>
                    <p class="mt-3 text-sm text-ink/70 leading-relaxed">{step.controls}</p>
                  </div>
                  <div class="rounded-xl bg-blue-100/60 p-4">
                    <div class="flex items-center gap-2.5">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-electric">
                        <Icon name="ph:check-circle-duotone" class="h-4 w-4" aria-hidden="true" />
                      </span>
                      <p class="text-sm font-semibold text-ink">What happens</p>
                    </div>
                    <p class="mt-3 text-sm text-ink/70 leading-relaxed">{step.outcome}</p>
                  </div>
                </div>

                <p class="mt-6 flex w-full items-start gap-3 rounded-xl bg-[#eef1ff] px-4 py-3 text-sm font-medium text-blue-700">
                  <Icon name="ph:arrow-right-bold" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                  <span>{step.next}</span>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Confirmation emails + client portal control, called out separately -->
    <section class="bg-gray-50/70 px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <div class={pillBadge}>
            <Icon name="ph:seal-check-duotone" class="text-base" aria-hidden="true" />
            Along the way
          </div>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink">
            You're always in the loop. Your client only sees what you allow.
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-ink/70">
            Two things run underneath every step above — worth calling out on their own.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class={`rounded-2xl border border-[#e8e9f0] bg-white p-6 sm:p-8 ${softShadow} ${liftHover}`}>
            <div class="relative flex h-28 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-b from-blue-50 to-white sm:h-32">
              <span class={glow} aria-hidden="true"></span>
              <span class="relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-100 text-electric">
                <Icon name="ph:envelope-simple-duotone" class="h-7 w-7" aria-hidden="true" />
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-ink font-display">Confirmation on every decision</h3>
            <p class="mt-2 text-sm text-ink/70 leading-relaxed">
              Every time a client approves a proposal, or accepts or rejects a contract, both of
              you get an email confirming exactly what happened. You never have to open Huzlly
              just to check whether a client has responded yet.
            </p>
          </div>

          <div class={`rounded-2xl border border-[#e8e9f0] bg-white p-6 sm:p-8 ${softShadow} ${liftHover}`}>
            <div class="relative flex h-28 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-b from-blue-50 to-white sm:h-32">
              <span class={glow} aria-hidden="true"></span>
              <span class="relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-100 text-electric">
                <Icon name="ph:shield-check-duotone" class="h-7 w-7" aria-hidden="true" />
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-ink font-display">Client access, on your terms</h3>
            <p class="mt-2 text-sm text-ink/70 leading-relaxed">
              The client portal is off by default and set per client, not sitewide. You choose
              whether each client can see project and task progress, and whether they can message
              you directly from the portal — independently, for every client you work with.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparisons -->
    <section id="comparisons" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <div class={pillBadge}>
            <Icon name="ph:scales-duotone" class="text-base" aria-hidden="true" />
            Comparisons
          </div>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink">
            How Huzlly stacks up
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-ink/70">
            Bonsai, HoneyBook, and Dubsado all do parts of this. Here's specifically where Huzlly is different.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-3">
          {comparisons.map((c) => (
            <div class={`rounded-2xl border border-[#e8e9f0] bg-white p-6 text-left ${softShadow} ${liftHover}`}>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-100 text-electric">
                <Icon name={c.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="mt-4 text-lg font-semibold text-ink font-display">{c.title}</h3>
              <p class="mt-2 text-sm text-ink/70 leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>

        <p class="mt-10 text-center text-sm text-ink/70">
          Curious what it costs? <a href="/pricing" class="rounded-sm font-medium text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">See pricing for lean freelance software &rarr;</a>
        </p>
      </div>
    </section>

    <WaitlistCTA heading="See the flow in action"
      subheading="Join the waitlist and we'll walk you through how each step fits your workflow — no sales calls, no pressure."
    />
  </main>
</Layout>
