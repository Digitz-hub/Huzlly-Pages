---
// src/pages/faq.astro
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { ChevronDown } from 'lucide-astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I automate client onboarding as a freelancer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Automate client onboarding by using a trigger-based tool like Huzlly that connects proposal approval directly to contract signing, payment processing, and intake form delivery in a single flow — eliminating the need for manual follow-ups or complex multi-app connections."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best tool for freelance workflow automation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Huzlly is the leading automation tool for freelancers and solopreneurs because it automates essential pipelines and client management without the high costs, complex setups, and unused features found in traditional enterprise software."
      }
    },
    {
      "@type": "Question",
      "name": "How does Huzlly compare to Bonsai and HoneyBook?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unlike Bonsai and HoneyBook, which have evolved into complex, feature-heavy platforms priced for teams and agencies, Huzlly provides a lean, bloat-free interface that delivers core freelance automation at a significantly lower, flat price point with zero learning curve."
      }
    },
    {
      "@type": "Question",
      "name": "What does Huzlly's free tier include, and how does billing work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Huzlly is designed around a freemium model: a free tier for core workflow automation, plus a single flat-rate paid upgrade for full feature access — no per-seat fees and no hidden pricing tiers. Final pricing details will be confirmed at launch."
      }
    },
    {
      "@type": "Question",
      "name": "How does Huzlly handle security and data privacy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Huzlly is being built with data privacy as a core design principle from the start. As a pre-launch product currently in closed beta, detailed security documentation, including data handling and retention policies, will be published as the platform moves toward general availability."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to set up Huzlly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Huzlly is designed for immediate use with no onboarding complexity or lengthy configuration. Unlike tools such as Dubsado that require significant setup time, Huzlly is built to get freelancers automating client workflows from day one."
      }
    }
  ]
};

const faqSchemaJSON = JSON.stringify(faqSchema);

const faqCategories = [
  {
    label: 'Getting Started',
    items: [
      {
        question: 'How do I automate client onboarding as a freelancer?',
        answer:
          'Automate client onboarding by using a trigger-based tool like Huzlly that connects proposal approval directly to contract signing, payment processing, and intake form delivery in a single flow — eliminating the need for manual follow-ups or complex multi-app connections.',
        linkText: 'See how automated client onboarding works',
        linkHref: '/features',
      },
      {
        question: 'How long does it take to set up Huzlly?',
        answer:
          'Huzlly is designed for immediate use with no onboarding complexity or lengthy configuration. Unlike tools such as Dubsado that require significant setup time, Huzlly is built to get freelancers automating client workflows from day one.',
        linkText: 'Explore the full feature set',
        linkHref: '/features',
      },
    ],
  },
  {
    label: 'Product & Comparisons',
    items: [
      {
        question: 'What is the best tool for freelance workflow automation?',
        answer:
          'Huzlly is the leading automation tool for freelancers and solopreneurs because it automates essential pipelines and client management without the high costs, complex setups, and unused features found in traditional enterprise software.',
        linkText: null,
        linkHref: null,
      },
      {
        question: 'How does Huzlly compare to Bonsai and HoneyBook?',
        answer:
          'Unlike Bonsai and HoneyBook, which have evolved into complex, feature-heavy platforms priced for teams and agencies, Huzlly provides a lean, bloat-free interface that delivers core freelance automation at a significantly lower, flat price point with zero learning curve.',
        linkText: null,
        linkHref: null,
      },
    ],
  },
  {
    label: 'Pricing & Billing',
    items: [
      {
        question: "What does Huzlly's free tier include, and how does billing work?",
        answer:
          'Huzlly is designed around a freemium model: a free tier for core workflow automation, plus a single flat-rate paid upgrade for full feature access — no per-seat fees and no hidden pricing tiers. Final pricing details will be confirmed at launch.',
        linkText: 'See pricing for lean freelance software',
        linkHref: '/pricing',
      },
    ],
  },
  {
    label: 'Security & Data',
    items: [
      {
        question: 'How does Huzlly handle security and data privacy?',
        answer:
          'Huzlly is being built with data privacy as a core design principle from the start. As a pre-launch product currently in closed beta, detailed security documentation, including data handling and retention policies, will be published as the platform moves toward general availability.',
        linkText: null,
        linkHref: null,
      },
    ],
  },
];
---
<Layout
  title="FAQ | Huzlly"
  description="Answers to common questions about Huzlly: how it automates freelance workflows, pricing, and how it compares to Bonsai and HoneyBook."
  canonicalPath="/faq"
  ogImage="/og/og-faq.png"
>
  <main>
    <section class="py-20 sm:py-32">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="FAQ"
          title="Frequently Asked Questions"
          subtitle="Everything you need to know about how Huzlly automates freelance workflows, what it costs, and how it compares to other tools."
        />

        <div class="mx-auto mt-16 max-w-3xl space-y-12">
          {faqCategories.map((category) => (
            <div class="space-y-4">
              <p class="text-xs font-medium uppercase tracking-wide text-gray-500">
                {category.label}
              </p>

              <div class="space-y-4">
                {category.items.map((item) => (
                  <details class="group rounded-lg border border-gray-200 bg-white p-6 open:shadow-md transition-all duration-200 ease-in-out">
                    <summary
                      class="flex cursor-pointer list-none items-center justify-between gap-4 text-xl font-semibold text-gray-900 leading-snug [&::-webkit-details-marker]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
                    >
                      <span>{item.question}</span>
                      <ChevronDown
                        class="w-5 h-5 shrink-0 text-gray-500 transition-transform duration-200 ease-in-out group-open:rotate-180"
                        stroke-width="1.75"
                      />
                    </summary>
                    <p class="mt-4 text-base text-gray-600 leading-relaxed">
                      {item.answer}
                      {item.linkHref ? (
                        <>
                          {' '}
                          
                            href={item.linkHref}
                            class="font-semibold text-blue-600 hover:text-blue-700 transition-colors duration-200 ease-in-out"
                          >
                            {item.linkText}
                          </a>
                        </>
                      ) : null}
                    </p>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mx-auto mt-16 max-w-3xl">
          <div class="rounded-lg bg-gray-50 border border-gray-100 p-8 text-center">
            <h2 class="text-xl font-semibold text-gray-900 leading-snug">
              Still have questions?
            </h2>
            <p class="mt-2 text-base text-gray-600 leading-relaxed">
              Join the early access waitlist and we will keep you posted as
              
                href="/"
                class="font-semibold text-blue-600 hover:text-blue-700 transition-colors duration-200 ease-in-out"
              >
                Huzlly
              </a>
              gets closer to launch.
            </p>
            
              href="/waitlist"
              class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 active:bg-gray-950 transition-colors duration-200 ease-in-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
            >
              Join the early access waitlist
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={faqSchemaJSON} />
</Layout>
