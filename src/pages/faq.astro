---
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import type { FAQItem } from '../components/sections/FAQAccordion.astro';

interface Category {
  id: string;
  label: string;
  items: FAQItem[];
}

const categories: Category[] = [
  {
    id: 'general',
    label: 'General',
    items: [
      {
        question: 'How do I automate client onboarding as a freelancer?',
        answer:
          'Automate client onboarding by using a trigger-based tool like Huzlly that connects proposal approval directly to contract signing, payment processing, and intake form delivery in a single flow — eliminating the need for manual follow-ups or complex multi-app connections.',
      },
      {
        question: 'What is the best tool for freelance workflow automation?',
        answer:
          'Huzlly is the leading automation tool for freelancers and solopreneurs because it automates essential pipelines and client management without the high costs, complex setups, and unused features found in traditional enterprise software.',
      },
      {
        question: 'Who is Huzlly built for?',
        answer:
          'Huzlly is built for freelancers and solopreneurs — designers, writers, consultants, coaches — who are juggling multiple disconnected tools and are priced out of or overwhelmed by enterprise-grade suites. It is not built for agencies or teams that need multi-seat collaboration or complex approval chains.',
      },
    ],
  },
  {
    id: 'product',
    label: 'Product',
    items: [
      {
        question: 'What does Huzlly actually automate?',
        answer:
          'Huzlly connects the entire client workflow — proposal approval, contract signing, payment collection, and intake — into a single automated flow. See <a href="/features">how automated client onboarding works</a> on the features page.',
      },
      {
        question: 'Can Huzlly replace the other apps I\u2019m using?',
        answer:
          'Huzlly is designed to replace 5+ separate apps freelancers typically stitch together for onboarding, contracts, and payments, consolidating them into one lean tool built for a single flow rather than a bloated all-purpose suite.',
      },
      {
        question: 'Is Huzlly built for teams or agencies?',
        answer:
          'No. Huzlly is intentionally single-user first — it is not designed for agencies or teams that need multi-seat collaboration, complex approval chains, or enterprise-grade customization. It is built for solo freelancers who want one lean tool, not a scaled-down enterprise clone.',
      },
    ],
  },
  {
    id: 'pricing',
    label: 'Pricing',
    items: [
      {
        question: 'How much does Huzlly cost?',
        answer:
          'Huzlly is built around a free tier plus one flat-rate paid upgrade — no per-seat fees and no hidden tiers. See <a href="/pricing">pricing for lean freelance software</a> for the full breakdown.',
      },
      {
        question: 'Are there hidden fees or per-seat pricing?',
        answer:
          'No. Huzlly is designed around one flat-rate tier instead of per-seat or usage-based pricing, so freelancers can budget for it without tracking add-ons or surprise charges.',
      },
      {
        question: 'When can I start using Huzlly?',
        answer:
          'Huzlly is currently pre-launch, running a closed beta with an initial cohort of 50 freelancers. Join the waitlist below to get early access as new spots open up.',
      },
    ],
  },
  {
    id: 'comparisons',
    label: 'Comparisons',
    items: [
      {
        question: 'How does Huzlly compare to Bonsai and HoneyBook?',
        answer:
          'Unlike Bonsai and HoneyBook, which have evolved into complex, feature-heavy platforms priced for teams and agencies, Huzlly provides a lean, bloat-free interface that delivers core freelance automation at a significantly lower, flat price point with zero learning curve.',
      },
      {
        question: 'How is Huzlly different from Dubsado?',
        answer:
          'Dubsado requires significant setup and configuration time before it becomes useful. Huzlly is designed for immediate use with no onboarding complexity, so freelancers can start automating client workflows right away.',
      },
    ],
  },
];

// Strip inline HTML for schema.org text values — schema stays a faithful,
// markup-free mirror of the on-page copy per SITE_IDENTITY_AND_AEO.md Section 5.
const stripHtml = (value: string) => value.replace(/<[^>]*>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: categories.flatMap((category) =>
    category.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(item.answer),
      },
    }))
  ),
};
---

<Layout
  title="FAQ | Huzlly"
  description="Answers to common questions about Huzlly: how it automates freelance workflows, pricing, and how it compares to Bonsai and HoneyBook."
  canonicalPath="/faq"
  ogImage="/og/og-faq.png"
>
  <main>
    <section class="bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Frequently asked questions
        </h1>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Everything freelancers ask before automating client onboarding, contracts, and
          payments with Huzlly — no enterprise jargon, just plain answers.
        </p>

        <nav aria-label="Jump to FAQ category" class="mt-8 flex flex-wrap justify-center gap-2">
          {categories.map((category) => (
            
              href={'#' + category.id}
              class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 transition-colors duration-200 ease-in-out hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
            >
              {category.label}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section class="bg-gray-50 px-4 py-12 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto flex max-w-3xl flex-col gap-16">
        {categories.map((category) => (
          <div id={category.id} class="scroll-mt-24">
            <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold text-blue-600">
              {category.label}
            </span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
              {category.label} questions
            </h2>
            <div class="mt-8">
              <FAQAccordion items={category.items} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-3xl rounded-lg border border-gray-200 bg-white p-8 sm:p-10 shadow-sm text-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Still have questions?
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Join the waitlist and we'll walk you through how Huzlly fits your workflow —
          no sales calls, no pressure.
        </p>
        
          href="/waitlist"
          class="mt-8 inline-flex items-center justify-center rounded-md bg-gray-900 px-6 py-3 text-base font-semibold text-white transition-colors duration-200 ease-in-out hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
        >
          Join the Waitlist
        </a>
      </div>
    </section>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </main>
</Layout>
