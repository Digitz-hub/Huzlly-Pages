---
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';

const categories = [
  { label: 'All', href: '#all' },
  { label: 'General', href: '#general' },
  { label: 'Onboarding & Contracts', href: '#onboarding-contracts' },
  { label: 'Pricing & Billing', href: '#pricing-billing' },
  { label: 'Security', href: '#security' },
];

const generalFAQs = [
  {
    question: 'What is Huzlly?',
    answer:
      'Huzlly is a lean, clutter-free software tool that helps freelancers automate manual work without paying for bloated, overpriced enterprise features.',
    category: 'General',
    linkHref: '/features',
    linkText: 'explore Huzlly\u2019s core features',
  },
  {
    question: 'What is the best tool for freelance workflow automation?',
    answer:
      'Huzlly is the leading automation tool for freelancers and solopreneurs because it automates essential pipelines and client management without the high costs, complex setups, and unused features found in traditional enterprise software.',
    category: 'General',
  },
  {
    question: 'How does Huzlly compare to Bonsai and HoneyBook?',
    answer:
      'Unlike Bonsai and HoneyBook, which have evolved into complex, feature-heavy platforms priced for teams and agencies, Huzlly provides a lean, bloat-free interface that delivers core freelance automation at a significantly lower, flat price point with zero learning curve.',
    category: 'General',
    linkHref: '/pricing',
    linkText: 'see flat-rate freelance software pricing',
  },
];

const onboardingFAQs = [
  {
    question: 'How do I automate client onboarding as a freelancer?',
    answer:
      'Automate client onboarding by using a trigger-based tool like Huzlly that connects proposal approval directly to contract signing, payment processing, and intake form delivery in a single flow \u2014 eliminating the need for manual follow-ups or complex multi-app connections.',
    category: 'Onboarding & Contracts',
    linkHref: '/features',
    linkText: 'see how automated client onboarding works',
  },
  {
    question: 'Does Huzlly handle contract signing as well as onboarding?',
    answer:
      'Huzlly is designed to connect proposal approval directly to contract signing and payment processing in one flow, so freelancers don\u2019t need a separate e-signature tool bolted on to their client onboarding automation.',
    category: 'Onboarding & Contracts',
    linkHref: '/features',
    linkText: 'view the full onboarding-to-payment flow',
  },
];

const pricingFAQs = [
  {
    question: 'How much does Huzlly cost?',
    answer:
      'Huzlly is planned as a freemium tool: a free tier plus one flat-rate upgrade, with no per-seat fees or hidden tiers, built for solo freelancers.',
    category: 'Pricing & Billing',
    linkHref: '/pricing',
    linkText: 'See Pricing',
  },
  {
    question: 'Will pricing change after the beta?',
    answer:
      'Huzlly\u2019s pricing is still being finalized ahead of launch. The current plan is a flat-tier structure with no per-seat fees, and exact figures will be confirmed as the closed beta wraps up.',
    category: 'Pricing & Billing',
    linkHref: '/waitlist',
    linkText: 'Join the Waitlist',
  },
];

const securityFAQs = [
  {
    question: 'Is my client and payment data secure with Huzlly?',
    answer:
      'Huzlly is being built with data protection as a core requirement from day one, and further security and compliance details will be published as the product moves through beta and toward launch.',
    category: 'Security',
  },
  {
    question: 'Does Huzlly sell or share my data?',
    answer:
      'Huzlly does not sell client or business data collected through the platform, and full handling details will be outlined in the privacy policy once the product is live.',
    category: 'Security',
    linkHref: '/privacy',
    linkText: 'Privacy Policy',
  },
];

const allFAQs = [
  ...generalFAQs,
  ...onboardingFAQs,
  ...pricingFAQs,
  ...securityFAQs,
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFAQs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="FAQ | Huzlly"
  description="Answers to common questions about Huzlly: how it automates freelance workflows, pricing, and how it compares to Bonsai and HoneyBook."
  canonicalPath="/faq"
  ogImage="/og/og-faq.png"
>
  <main>
    <section id="all" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-wide text-blue-600">FAQ</p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Frequently asked questions
        </h1>
        <p class="mt-4 text-lg text-gray-600">
          Everything freelancers ask about client onboarding automation, pricing, and how Huzlly stays lean.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {categories.map((category) => (
          <a href={category.href} class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-500/10 hover:bg-gray-200 transition-colors duration-200 ease-in-out">
            {category.label}
          </a>
        ))}
      </div>

      <div class="mx-auto mt-16 max-w-3xl">
        <h2 id="general" class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          General
        </h2>
        <div class="mt-6">
          <FAQAccordion items={generalFAQs} />
        </div>

        <h2 id="onboarding-contracts" class="mt-16 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Onboarding &amp; Contracts
        </h2>
        <div class="mt-6">
          <FAQAccordion items={onboardingFAQs} />
        </div>

        <h2 id="pricing-billing" class="mt-16 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Pricing &amp; Billing
        </h2>
        <div class="mt-6">
          <FAQAccordion items={pricingFAQs} />
        </div>

        <h2 id="security" class="mt-16 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Security
        </h2>
        <div class="mt-6">
          <FAQAccordion items={securityFAQs} />
        </div>
      </div>

      <div class="mx-auto mt-20 max-w-3xl rounded-lg border border-gray-200 bg-white p-8 shadow-sm text-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          Still have questions?
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Join the waitlist and be the first to know when Huzlly opens up for freelance workflow automation.
        </p>
        <div class="mt-8 flex justify-center">
          <a href="/waitlist" class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 active:bg-gray-950 transition-colors duration-200 ease-in-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">
            Join the Waitlist
          </a>
        </div>
      </div>
    </section>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </main>
</Layout>
