---
// src/pages/terms.astro
// Terms of Service. Same approach as privacy.astro: structural skeleton with
// a plain-English description per section and an explicit placeholder block
// where Kartik's own legal language goes — no invented clauses, obligations,
// or liability terms.

import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import { Mail } from 'lucide-astro';

const sections = [
  { id: 'acceptance', label: 'Acceptance of Terms' },
  { id: 'the-service', label: 'The Service' },
  { id: 'eligibility', label: 'Eligibility & Accounts' },
  { id: 'beta', label: 'Closed Beta Terms' },
  { id: 'fees', label: 'Fees' },
  { id: 'responsibilities', label: 'Your Responsibilities' },
  { id: 'content', label: 'Content & IP' },
  { id: 'third-parties', label: 'Third-Party Services' },
  { id: 'disclaimers', label: 'Disclaimers' },
  { id: 'liability', label: 'Limitation of Liability' },
  { id: 'termination', label: 'Termination' },
  { id: 'governing-law', label: 'Governing Law' },
  { id: 'changes', label: 'Changes to These Terms' },
  { id: 'contact', label: 'Contact' },
];
---

<Layout
  title="Terms of Service | Huzlly"
  description="The terms governing use of Huzlly's website and closed-beta product. This page is a structural draft — Huzlly is finalizing its legal language."
  canonicalPath="/terms"
  ogImage="/og/og-terms.png"
>
  <main>
    <!-- Hero -->
    <section class="bg-white px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl rounded-3xl bg-blue-50/50 sm:bg-blue-50/40 px-6 py-16 text-center sm:px-12 sm:py-24 mt-6">
        <p class="text-xs font-medium uppercase tracking-wide text-blue-600">Legal</p>
        <h1 class="mt-2 text-4xl sm:text-6xl font-bold tracking-tight text-gray-900 leading-tight">
          Terms of <span class="text-blue-600">Service</span>
        </h1>
        <p class="mt-4 text-sm sm:text-base text-gray-600 max-w-xl mx-auto leading-relaxed">
          The terms governing use of huzlly.com and the closed-beta product. Huzlly is in closed
          beta, and these terms are being finalized alongside it.
        </p>

        <nav aria-label="Jump to section" class="mt-8 flex flex-wrap justify-center gap-2">
          {sections.map((section) => (
            <a href={`#${section.id}`}
              class="rounded-full bg-white border border-gray-200 px-4 py-1.5 text-xs sm:text-sm font-medium text-gray-700 shadow-sm transition-all hover:border-blue-300 hover:text-blue-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
            >
              {section.label}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- Draft notice -->
    <section class="bg-white px-4 pt-16 sm:px-6 sm:pt-20 lg:px-8">
      <div class="mx-auto max-w-3xl rounded-lg border-2 border-amber-200 bg-amber-50 p-6 sm:p-8">
        <Badge variant="warning">Structural draft &middot; not legal advice</Badge>
        <p class="mt-4 text-sm text-gray-700 leading-relaxed">
          This page lays out the sections a terms-of-service agreement like Huzlly's typically
          needs and what each one is for. It does not contain finished legal language, and
          nothing here should be read as an actual obligation, warranty, or liability term. Every
          section below has a dashed placeholder block marking exactly where real legal copy
          needs to go — have that copy reviewed before this page goes live.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-3xl">

        <div id="acceptance" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">1. Acceptance of Terms</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A statement that using huzlly.com or the product means agreeing to these terms, and
            what happens if someone doesn't agree.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Standard acceptance clause and effective date.</p>
          </div>
        </div>

        <div id="the-service" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">2. The Service</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A plain description of what Huzlly does — connecting proposal approval, contract
            signing, payment collection, and intake into one flow — and a note that it's
            currently pre-launch and evolving during closed beta.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Service description and any "as-is during beta" framing you want to formalize.</p>
          </div>
        </div>

        <div id="eligibility" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">3. Eligibility &amp; Accounts</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Who can sign up (e.g. minimum age, acting on your own behalf as a freelancer or
            solopreneur), and the account holder's responsibility for their login credentials.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Eligibility criteria and account-security obligations.</p>
          </div>
        </div>

        <div id="beta" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">4. Closed Beta Terms</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Terms specific to being in a limited cohort — that access is invite-based, that
            features, availability, and pricing may change before general availability, and how
            feedback given during the beta may be used.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Beta-specific disclaimers, cohort access terms, and feedback-license language if you want one.</p>
          </div>
        </div>

        <div id="fees" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">5. Fees</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A note that pricing isn't public yet (see the <a href="/pricing" class="text-blue-600 font-semibold hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 rounded-md">pricing page</a>),
            that Huzlly will be a free tier plus one flat-rate paid upgrade with no per-seat fees,
            and how billing and cancellation will work once pricing launches.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Billing cycle, cancellation, and refund terms once pricing is set.</p>
          </div>
        </div>

        <div id="responsibilities" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">6. Your Responsibilities</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            What's expected of a user running client work through Huzlly — accurate information,
            lawful use, and not using the flow to defraud or misrepresent terms to their own
            clients.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Acceptable-use rules and prohibited conduct.</p>
          </div>
        </div>

        <div id="content" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">7. Content &amp; Intellectual Property</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Who owns what — the user's proposals, contracts, and client data stay theirs; Huzlly's
            product, branding, and code stay Huzlly's.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Ownership and license terms for user content vs. the Huzlly product/brand.</p>
          </div>
        </div>

        <div id="third-parties" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">8. Third-Party Services</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            A note that parts of the flow (payment processing, e-signature) run through
            third-party providers, and that their terms apply alongside Huzlly's.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Name the actual providers once they're locked in, and how responsibility is split.</p>
          </div>
        </div>

        <div id="disclaimers" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">9. Disclaimers</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            The standard disclaimer that the service is provided without certain warranties,
            especially relevant while it's in closed beta.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Warranty disclaimer language — get this reviewed rather than drafted casually.</p>
          </div>
        </div>

        <div id="liability" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">10. Limitation of Liability</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            The cap on what Huzlly is liable for if something goes wrong — this is one of the
            highest-stakes clauses in the whole document.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Liability cap and excluded damages — strongly recommend a lawyer draft this one specifically.</p>
          </div>
        </div>

        <div id="termination" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">11. Termination</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            How and when an account can be closed, by the user or by Huzlly, and what happens to
            data on termination.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Termination triggers and post-termination data handling.</p>
          </div>
        </div>

        <div id="governing-law" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">12. Governing Law</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Which jurisdiction's law applies and how disputes get resolved.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Governing jurisdiction and dispute-resolution method (courts vs. arbitration).</p>
          </div>
        </div>

        <div id="changes" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">13. Changes to These Terms</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            How updates to these terms will be communicated, and how someone can tell when they
            were last changed.
          </p>
          <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your legal language goes here</p>
            <p class="mt-1 text-sm text-gray-500">Notice method and where the "last updated" date will live.</p>
          </div>
        </div>

        <div id="contact" class="mt-14 scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-semibold text-gray-900">14. Contact</h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            How to reach Huzlly with questions about these terms.
          </p>
          <p class="mt-4 flex items-center gap-2 text-sm text-gray-600">
            <Mail class="w-4 h-4 text-gray-400" stroke-width="2" />
            <a href="mailto:contact@huzlly.com" class="text-blue-600 font-semibold hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 rounded-md">
              contact@huzlly.com
            </a>
          </p>
        </div>

      </div>
    </section>
  </main>
</Layout>
