---
// src/components/layout/Nav.astro
// Consumed only by Layout.astro (per CLAUDE.md Section 2 folder rules).
//
// PER-PAGE INSPIRATION OVERRIDE — CLAUDE.md Section 4.5
// Design source: user-supplied reference screenshot of a floating, centered,
// glassmorphic "pill" navbar (green-glow site, brand name "augment" in the
// reference). DESIGN_SYSTEM.md v2 tokens (ink/paper/rail palette, rounded-xl
// buttons, rounded-2xl cards) are NOT the source for this component's shape,
// color, or radius — see the design note in the chat response for the exact
// tokens used here. What stays fixed regardless of the override (per Section
// 4.5's non-negotiable list): the blue-600 accent color, strict layout
// ownership (this file still renders only a <header>, still consumed only by
// Layout.astro), the ui/ Button primitive (used below for the CTA rather than
// hand-rolled button markup, with a class override for the pill radius), full
// nav content/routes, and all accessibility/focus-visible requirements.
//
// Structural changes from spec vs. the reference screenshot:
// - No "Login" link — spec explicitly says CTA only, no extra login link.
// - Four nav items (Features / Pricing / FAQ / About) instead of five, per
//   Huzlly's actual page map — content always follows PAGE_MAP_AND_SEO.md,
//   never the inspiration source, even when the inspiration has a different
//   link count.
// - No dropdowns, no hide-on-scroll — CTA and pill stay static/persistent.
//
// Note: a scroll/load/hover animation layer (spring reveal, frosted-glass
// scroll state, sliding tab indicator, CTA hover-scale) was added and then
// reverted at the user's request — this file is back to the plain static
// glass pill with no JS-driven motion beyond the mobile menu toggle.
//
// PILL → FULL-WIDTH BAR (this pass): per direct request, switched shape
// from the floating, margin-inset, rounded-full "pill" to an edge-to-edge
// bar spanning the full viewport width, fixed to the true top (no top/side
// margin), with a bottom hairline border instead of an all-around pill
// border. This is a shape/layout change only — the liquid-glass backdrop-
// filter, dark-theme text/link colors, mobile menu behavior, and Button
// CTA are all untouched. rounded-full → removed entirely (bar has square
// corners); the pill's `border` (all sides) → `border-b` (bottom edge
// only, since top/left/right sit flush against the viewport edge and a
// border there would look like a stray line, not a bar edge); the pill's
// own horizontal max-w-5xl constraint moved from the outer wrapper to an
// inner content row so the glass/border still spans full width while the
// logo/links/CTA stay centered and readable at wide viewports. Mobile
// menu sheet's rounded-3xl floating-card look is kept as-is (a bar header
// naturally opens into a plain dropdown sheet, not a second pill).
//
// LIQUID GLASS DISTORTION (earlier pass): per direct request for an Apple-
// style "liquid glass" pill — not just blur, but a visible bend/refraction
// of whatever scrolls behind it, like a real glass lens. This is a
// browser-native effect achievable with an SVG filter (feTurbulence +
// feDisplacementMap) referenced from `backdrop-filter`, not a Tailwind
// utility — Tailwind's `backdrop-blur-*` alone (still kept, layered
// underneath) only softens what's behind, it can't displace/bend pixels.
//
// Structure:
//   1. An inline, visually hidden `<svg>` right after the opening
//      <header> tag defines `#liquid-glass-distortion`: feTurbulence
//      generates a low-frequency fractal noise field, feDisplacementMap
//      then uses that noise to push each backdrop pixel a few px off its
//      real position — the "bend" the reference shows. Scoped to this
//      file only (id is unique in the page), inert/no motion, adds no
//      network request.
//   2. The pill and the mobile sheet both get a `.liquid-glass` class
//      (defined in the <style> block below) that layers
//      `backdrop-filter: url(#liquid-glass-distortion) blur(...)` — the
//      SVG reference runs first (bends the backdrop), the blur softens
//      the now-bent result, matching how the reference's glass reads as
//      both warped AND soft, not one or the other. `-webkit-backdrop-
//      filter` mirrors it for Safari (the browser that shipped the
//      original "liquid glass" look).
//   3. Tailwind's `backdrop-blur-xl` utility classes were removed from
//      the pill/sheet markup since the blur now lives inside this same
//      backdrop-filter value (a second, separate backdrop-filter
//      declaration would just overwrite the first rather than combine).
//      Border, transparency, shadow, and every color from the previous
//      dark-theme pass are untouched.
//
// Graceful degradation: SVG backdrop-filter references aren't supported
// in every browser (older Firefox in particular). Where unsupported the
// declaration is simply ignored by the browser, which leaves `bg-
// transparent` with no blur/distortion at all — acceptable for a
// decorative nav effect, no layout or content breaks either way.

import { Menu, X, ArrowRight } from 'lucide-astro';
import Button from '../ui/Button.astro';

const navLinks = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href;
};
---

<header class="fixed inset-x-0 top-0 z-50">
  <!-- Liquid-glass distortion filter def — see file-header comment.
       Visually hidden (0-size, absolute), referenced by the
       `.liquid-glass` backdrop-filter below via its #id. -->
  <svg class="absolute h-0 w-0 overflow-hidden" aria-hidden="true" focusable="false">
    <filter id="liquid-glass-distortion" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="noise" />
      <feGaussianBlur in="noise" stdDeviation="2" result="softNoise" />
      <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="28" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <!-- Full-width glass bar -->
  <div class="liquid-glass border-b border-white/15 bg-white/[0.03] shadow-lg shadow-black/20">
    <div class="relative mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:h-16 sm:px-6">
      <!-- Left: Brand -->
      <a href="/"
        class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-paper transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:text-xl"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-blue-600" aria-hidden="true"></span>
        Huzlly
      </a>

      <!-- Center: Desktop nav links -->
      <nav aria-label="Primary" class="hidden md:flex md:items-center md:gap-1">
        {navLinks.map((link) => (
          <a href={link.href}
            class={`rounded-full px-4 py-2 text-sm font-medium transition-colors duration-200 ${
              isActive(link.href)
                ? 'bg-blue-500/15 text-blue-400'
                : 'text-paper/60 hover:text-paper hover:bg-white/[0.06]'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: Desktop CTA -->
      <div class="hidden md:flex md:items-center">
        <Button href="/waitlist" size="default" class="!rounded-full !shadow-none">
          Join Waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </div>

      <!-- Mobile Menu Toggle -->
      <button id="nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-full p-2.5 text-paper hover:bg-white/[0.08] transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <Menu id="nav-icon-menu" class="w-5 h-5" stroke-width="1.75" />
        <X id="nav-icon-close" class="w-5 h-5 hidden" stroke-width="1.75" />
      </button>
    </div>

    <!-- Mobile Menu Sheet — glass dropdown below the bar -->
    <div id="mobile-menu"
      class="liquid-glass absolute inset-x-0 top-full hidden border-b border-white/15 bg-ink/60 p-3 shadow-lg shadow-black/20 md:hidden"
    >
      <nav aria-label="Mobile primary" class="mx-auto flex max-w-5xl flex-col gap-1 px-4 sm:px-6">
        {navLinks.map((link) => (
          <a href={link.href}
            class={`rounded-2xl px-4 py-3 text-sm font-medium transition-colors duration-200 ${
              isActive(link.href)
                ? 'bg-blue-500/15 text-blue-400'
                : 'text-paper/70 hover:text-paper hover:bg-white/[0.06]'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <Button href="/waitlist" size="default" class="!rounded-full !shadow-none mt-1.5 w-full">
          Join Waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Liquid-glass backdrop-filter — see the file-header "LIQUID GLASS
     DISTORTION" comment for the full rationale. Applied via <style>
     rather than a Tailwind arbitrary-value class since the value chains
     an SVG url() reference with blur() and needs vendor prefixing. */
  .liquid-glass {
    backdrop-filter: url(#liquid-glass-distortion) blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
</style>

<script>
  const toggleBtn = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('nav-icon-menu');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggleBtn && mobileMenu && iconMenu && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(!isOpen));
    });

    // Close mobile menu when a link inside it is clicked
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
