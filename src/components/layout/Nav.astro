---
// src/components/layout/Nav.astro
// Consumed only by Layout.astro (per CLAUDE.md Section 2 folder rules).
// v2 redesign pass: ink/paper/rail palette replaces gray-*/white; the CTA
// button reuses the ui/ Button primitive instead of hand-rolled markup
// (per CLAUDE.md Section 2's "always use the primitive" rule); logo dot
// and active-link accent stay blue-600 (fixed accent, unchanged).

import { Menu, X, ArrowRight } from 'lucide-astro';
import Button from '../ui/Button.astro';

const navLinks = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href;
};
---

<header class="sticky top-0 z-50 bg-paper/80 backdrop-blur-md border-b border-rail transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href="/"
      class="font-display text-xl font-semibold tracking-tight text-ink flex items-center gap-2 hover:opacity-90 transition-opacity focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      <span class="inline-block w-2 h-2 rounded-full bg-blue-600" aria-hidden="true"></span>
      Huzlly
    </a>

    <!-- Desktop Nav Links -->
    <nav aria-label="Primary" class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a href={link.href}
          class={`text-sm font-medium px-3.5 py-2 rounded-xl transition-all duration-200 ${
            isActive(link.href)
              ? 'text-blue-600 bg-blue-50/60 font-semibold'
              : 'text-ink/70 hover:text-ink hover:bg-rail/30'
          }`}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center">
      <Button href="/waitlist" size="default">
        Join Waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
    </div>

    <!-- Mobile Menu Toggle -->
    <button id="nav-toggle"
      type="button"
      class="md:hidden inline-flex items-center justify-center rounded-xl p-2 text-ink hover:bg-rail/30 transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <Menu id="nav-icon-menu" class="w-6 h-6" stroke-width="1.75" />
      <X id="nav-icon-close" class="w-6 h-6 hidden" stroke-width="1.75" />
    </button>
  </div>

  <!-- Mobile Menu Sheet -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-rail bg-paper/95 backdrop-blur-md">
    <nav aria-label="Mobile primary" class="px-4 sm:px-6 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a href={link.href}
          class={`text-sm font-medium px-3.5 py-2.5 rounded-xl transition-all duration-200 ${
            isActive(link.href)
              ? 'text-blue-600 bg-blue-50/60 font-semibold'
              : 'text-ink/70 hover:text-ink hover:bg-rail/30'
          }`}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <Button href="/waitlist" size="default" class="mt-2 w-full">
        Join Waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('nav-icon-menu');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggleBtn && mobileMenu && iconMenu && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(!isOpen));
    });

    // Close mobile menu when a link inside it is clicked
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
