---
// src/components/layout/Nav.astro
// Consumed only by Layout.astro (per CLAUDE.md Section 2 folder rules).
//
// PER-PAGE INSPIRATION OVERRIDE — CLAUDE.md Section 4.5
// Design source: user-supplied reference screenshot of a floating, centered,
// glassmorphic "pill" navbar (green-glow site, brand name "augment" in the
// reference). DESIGN_SYSTEM.md v2 tokens (ink/paper/rail palette, rounded-xl
// buttons, rounded-2xl cards) are NOT the source for this component's shape,
// color, or radius — see the design note in the chat response for the exact
// tokens used here. What stays fixed regardless of the override (per Section
// 4.5's non-negotiable list): the blue-600 accent color, strict layout
// ownership (this file still renders only a <header>, still consumed only by
// Layout.astro), the ui/ Button primitive (used below for the CTA rather than
// hand-rolled button markup, with a class override for the pill radius), full
// nav content/routes, and all accessibility/focus-visible requirements.
//
// Structural changes from spec vs. the reference screenshot:
// - No "Login" link — spec explicitly says CTA only, no extra login link.
// - Four nav items (Features / Pricing / FAQ / About) instead of five, per
//   Huzlly's actual page map — content always follows PAGE_MAP_AND_SEO.md,
//   never the inspiration source, even when the inspiration has a different
//   link count.
// - No dropdowns, no hide-on-scroll — CTA and pill stay static/persistent.
//
// Note: a scroll/load/hover animation layer (spring reveal, frosted-glass
// scroll state, sliding tab indicator, CTA hover-scale) was added and then
// reverted at the user's request — this file is back to the plain static
// glass pill with no JS-driven motion beyond the mobile menu toggle.

import { Menu, X, ArrowRight } from 'lucide-astro';
import Button from '../ui/Button.astro';

const navLinks = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href;
};
---

<header class="sticky top-4 z-50 mt-4 px-4 sm:top-6 sm:mt-6 sm:px-6">
  <div class="relative mx-auto max-w-5xl">
    <!-- Floating glass pill bar -->
    <div class="flex h-14 items-center justify-between rounded-full border border-white/60 bg-transparent pl-5 pr-2 shadow-lg shadow-black/5 backdrop-blur-xl sm:h-16 sm:pl-6 sm:pr-2.5">
      <!-- Left: Brand -->
      <a href="/"
        class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-ink transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:text-xl"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-blue-600" aria-hidden="true"></span>
        Huzlly
      </a>

      <!-- Center: Desktop nav links -->
      <nav aria-label="Primary" class="hidden md:flex md:items-center md:gap-1">
        {navLinks.map((link) => (
          <a href={link.href}
            class={`rounded-full px-4 py-2 text-sm font-medium transition-colors duration-200 ${
              isActive(link.href)
                ? 'bg-blue-50 text-blue-600'
                : 'text-ink/60 hover:text-ink hover:bg-black/[0.03]'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: Desktop CTA -->
      <div class="hidden md:flex md:items-center">
        <Button href="/waitlist" size="default" class="!rounded-full !shadow-none">
          Join Waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </div>

      <!-- Mobile Menu Toggle -->
      <button id="nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-full p-2.5 text-ink hover:bg-black/[0.04] transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <Menu id="nav-icon-menu" class="w-5 h-5" stroke-width="1.75" />
        <X id="nav-icon-close" class="w-5 h-5 hidden" stroke-width="1.75" />
      </button>
    </div>

    <!-- Mobile Menu Sheet — floating glass card below the pill -->
    <div id="mobile-menu"
      class="absolute inset-x-0 top-full mt-2 hidden rounded-3xl border border-white/60 bg-white/85 p-3 shadow-lg shadow-black/5 backdrop-blur-xl md:hidden"
    >
      <nav aria-label="Mobile primary" class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a href={link.href}
            class={`rounded-2xl px-4 py-3 text-sm font-medium transition-colors duration-200 ${
              isActive(link.href)
                ? 'bg-blue-50 text-blue-600'
                : 'text-ink/70 hover:text-ink hover:bg-black/[0.03]'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <Button href="/waitlist" size="default" class="!rounded-full !shadow-none mt-1.5 w-full">
          Join Waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('nav-icon-menu');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggleBtn && mobileMenu && iconMenu && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(!isOpen));
    });

    // Close mobile menu when a link inside it is clicked
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
