---
// src/components/layout/Footer.astro

const usefulLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];

const supportLinks = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms & Conditions' },
];

const socialLinks = [
  { href: 'https://x.com/huzlly', label: 'X' },
  { href: 'https://instagram.com/huzllyofficial', label: 'Instagram' },
];

const year = new Date().getFullYear();
---

<footer class="pt-10 sm:pt-14 bg-ink">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 gap-10 p-8 sm:grid-cols-2 sm:p-10 lg:grid-cols-10 lg:pt-12 lg:pb-12 lg:pl-12 lg:pr-20">
      <div class="lg:col-span-2">
        <a href="/"
          class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-blue-600" aria-hidden="true"></span>
          Huzlly
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/50">
          Everything you need to organize your freelance business, stay on top of your work, and
          get paid with confidence.
        </p>
      </div>

      <div class="contents lg:grid lg:col-start-7 lg:col-span-4 lg:grid-cols-[repeat(20,minmax(0,1fr))] lg:gap-10 lg:mr-8">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-wider text-white">Main</p>
        <ul class="mt-4 space-y-3">
          {
            usefulLinks.map((link) => (
              <li>
                <a href={link.href}
                  class="text-sm text-white/50 transition-colors duration-200 ease-in-out hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-white">Support</p>
        <ul class="mt-4 space-y-3">
          {
            supportLinks.map((link) => (
              <li>
                <a href={link.href}
                  class="text-sm text-white/50 transition-colors duration-200 ease-in-out hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-wider text-white">Socials</p>
        <ul class="mt-4 flex flex-col items-start gap-3">
          {
            socialLinks.map((social) => {
              return (
                <li>
                  <a href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Follow us on ${social.label}`}
                    class="inline-flex items-center justify-center text-white transition-opacity duration-200 ease-in-out hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                  >
                    {social.label === 'X' ? (
                      <svg class="h-5 w-5" viewBox="0 0 1200 1227" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="currentColor" d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z" />
                      </svg>
                    ) : (
                      <svg class="h-5 w-5" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="currentColor" d="M295.42,6c-53.2,2.51-89.53,11-121.29,23.48-32.87,12.81-60.73,30-88.45,57.82S40.89,143,28.17,175.92c-12.31,31.83-20.65,68.19-23,121.42S2.3,367.68,2.56,503.46,3.42,656.26,6,709.6c2.54,53.19,11,89.51,23.48,121.28,12.83,32.87,30,60.72,57.83,88.45S143,964.09,176,976.83c31.8,12.29,68.17,20.67,121.39,23s70.35,2.87,206.09,2.61,152.83-.86,206.16-3.39S799.1,988,830.88,975.58c32.87-12.86,60.74-30,88.45-57.84S964.1,862,976.81,829.06c12.32-31.8,20.69-68.17,23-121.35,2.33-53.37,2.88-70.41,2.62-206.17s-.87-152.78-3.4-206.1-11-89.53-23.47-121.32c-12.85-32.87-30-60.7-57.82-88.45S862,40.87,829.07,28.19c-31.82-12.31-68.17-20.7-121.39-23S637.33,2.3,501.54,2.56,348.75,3.4,295.42,6m5.84,903.88c-48.75-2.12-75.22-10.22-92.86-17-23.36-9-40-19.88-57.58-37.29s-28.38-34.11-37.5-57.42c-6.85-17.64-15.1-44.08-17.38-92.83-2.48-52.69-3-68.51-3.29-202s.22-149.29,2.53-202c2.08-48.71,10.23-75.21,17-92.84,9-23.39,19.84-40,37.29-57.57s34.1-28.39,57.43-37.51c17.62-6.88,44.06-15.06,92.79-17.38,52.73-2.5,68.53-3,202-3.29s149.31.21,202.06,2.53c48.71,2.12,75.22,10.19,92.83,17,23.37,9,40,19.81,57.57,37.29s28.4,34.07,37.52,57.45c6.89,17.57,15.07,44,17.37,92.76,2.51,52.73,3.08,68.54,3.32,202s-.23,149.31-2.54,202c-2.13,48.75-10.21,75.23-17,92.89-9,23.35-19.85,40-37.31,57.56s-34.09,28.38-57.43,37.5c-17.6,6.87-44.07,15.07-92.76,17.39-52.73,2.48-68.53,3-202.05,3.29s-149.27-.25-202-2.53m407.6-674.61a60,60,0,1,0,59.88-60.1,60,60,0,0,0-59.88,60.1M245.77,503c.28,141.8,115.44,256.49,257.21,256.22S759.52,643.8,759.25,502,643.79,245.48,502,245.76,245.5,361.22,245.77,503m90.06-.18a166.67,166.67,0,1,1,167,166.34,166.65,166.65,0,0,1-167-166.34" transform="translate(-2.5 -2.5)" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col sm:flex-row sm:items-center px-8 py-6 sm:px-10 lg:px-12">
      <p class="text-sm text-white/40">Copyright &copy; {year} Huzlly. All rights reserved.</p>
    </div>
  </div>
</footer>
