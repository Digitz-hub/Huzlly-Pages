---
// src/components/layout/Footer.astro

import { X as XIcon, Instagram as InstagramIcon } from 'lucide-astro';

const usefulLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];

const supportLinks = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms & Conditions' },
];

const socialLinks = [
  { href: 'https://x.com/huzlly', label: 'X' },
  { href: 'https://instagram.com/huzllyofficial', label: 'Instagram' },
];

// Maps a social link's label to its lucide icon. Falls back to XIcon so an
// unrecognised label still renders something reasonable instead of breaking.
const socialIcons: Record<string, typeof XIcon> = {
  X: XIcon,
  Instagram: InstagramIcon,
};

const year = new Date().getFullYear();
---

<footer class="pt-10 sm:pt-14 bg-ink">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 gap-10 p-8 sm:grid-cols-2 sm:p-10 lg:grid-cols-4 lg:p-12">
      <div>
        <a href="/"
          class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-blue-600" aria-hidden="true"></span>
          Huzlly
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/50">
          Everything you need to organize your freelance business, stay on top of your work, and
          get paid with confidence.
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-white">Main</p>
        <ul class="mt-4 space-y-3">
          {
            usefulLinks.map((link) => (
              <li>
                <a href={link.href}
                  class="text-sm text-white/50 transition-colors duration-200 ease-in-out hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-white">Support</p>
        <ul class="mt-4 space-y-3">
          {
            supportLinks.map((link) => (
              <li>
                <a href={link.href}
                  class="text-sm text-white/50 transition-colors duration-200 ease-in-out hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-white">Socials</p>
        <ul class="mt-4 flex items-center gap-3">
          {
            socialLinks.map((social) => {
              const Icon = socialIcons[social.label] ?? XIcon;
              return (
                <li>
                  <a href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Follow us on ${social.label}`}
                    class="inline-flex items-center justify-center text-white transition-opacity duration-200 ease-in-out hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                  >
                    <Icon class="h-4 w-4" stroke-width="1.75" aria-hidden="true" />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-8 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-10 lg:px-12">
      <p class="text-sm text-white/40">Copyright &copy; {year} Huzlly.</p>
      <p class="text-sm text-white/40">All rights reserved.</p>
    </div>
  </div>
</footer>
