---
// src/components/layout/Footer.astro

import { ArrowRight } from 'lucide-astro';
import Button from '../ui/Button.astro';

const usefulLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];

const socialLinks = [
  { href: 'https://x.com/huzlly', label: 'X' },
  { href: 'https://instagram.com/huzllyofficial', label: 'Instagram' },
];

const year = new Date().getFullYear();
---

<footer class="px-4 pb-4 pt-10 sm:px-6 sm:pb-6 sm:pt-14">
  <div class="mx-auto max-w-7xl rounded-3xl border border-black/5 bg-white/80 shadow-lg shadow-black/5 backdrop-blur-xl">
    <div class="grid grid-cols-1 gap-10 p-8 sm:grid-cols-2 sm:p-10 lg:grid-cols-4 lg:p-12">
      <div>
        <a href="/"
          class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-blue-600" aria-hidden="true"></span>
          Huzlly
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink/50">
          Lean, clutter-free workflow automation for freelancers — no enterprise bloat, no
          per-seat pricing.
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-ink">Useful Links</p>
        <ul class="mt-4 space-y-3">
          {
            usefulLinks.map((link) => (
              <li>
                <a href={link.href}
                  class="text-sm text-ink/50 transition-colors duration-200 ease-in-out hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-medium text-ink">Follow Us</p>
        <ul class="mt-4 space-y-3">
          {
            socialLinks.map((social) => (
              <li>
                <a href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-ink/50 transition-colors duration-200 ease-in-out hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-medium text-ink">Join our waitlist</p>
        <p class="mt-4 text-sm leading-relaxed text-ink/50">
          Be the first to know when we launch.
        </p>
        <Button href="/waitlist" size="default" class="!rounded-full !shadow-none mt-4">
          Join Waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-black/5 px-8 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-10 lg:px-12">
      <p class="text-sm text-ink/40">Copyright &copy; {year} Huzlly.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy"
          class="text-sm text-ink/40 transition-colors duration-200 ease-in-out hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
        >
          Privacy
        </a>
        <a href="/terms"
          class="text-sm text-ink/40 transition-colors duration-200 ease-in-out hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
        >
          Terms
        </a>
        <p class="text-sm text-ink/40">All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
