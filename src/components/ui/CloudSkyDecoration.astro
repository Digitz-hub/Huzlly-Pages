---
// src/components/ui/CloudSkyDecoration.astro

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['pointer-events-none absolute -z-[5] inset-0', className]}
  aria-hidden="true"
>
  <canvas data-cloud-sky class="block h-full w-full"></canvas>
</div>

<script>
  import { initCloudSky } from '../../scripts/cloudSky';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-cloud-sky]');
  if (canvas) {
    initCloudSky(canvas);
  }
</script>
