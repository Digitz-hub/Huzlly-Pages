---
// USAGE EXAMPLE — not a page, just a reference snippet.
// Delete this file once you've copied the pattern into Hero.astro (or
// wherever the 4 floating cards should live). Shows how to position 4
// cards loosely around a hero's corners, matching the reference sketch:
// icon badge via the "icon" slot, iconBg per DESIGN_SYSTEM.md tokens,
// slight rotation per card, and one card starting expanded.

import { Check, FileText, DollarSign, FolderOpen } from 'lucide-astro';
import AutomationNotificationCard from './AutomationNotificationCard.astro';
---

<div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="false">
  <!-- Top-left -->
  <div class="pointer-events-auto absolute left-[2%] top-[6%]">
    <AutomationNotificationCard
      iconBg="bg-teal-600"
      title="Proposal accepted"
      description="Contract sent to client instantly"
      rotation={-6}
      defaultExpanded={true}
    >
      <Check slot="icon" class="h-[17px] w-[17px]" stroke-width="2.5" />
    </AutomationNotificationCard>
  </div>

  <!-- Top-right -->
  <div class="pointer-events-auto absolute right-[2%] top-[6%]">
    <AutomationNotificationCard
      iconBg="bg-amber-500"
      title="Payment received"
      description="Client paid $1,200 for Website Redesign"
      rotation={8}
    >
      <DollarSign slot="icon" class="h-[17px] w-[17px]" stroke-width="2" />
    </AutomationNotificationCard>
  </div>

  <!-- Bottom-left -->
  <div class="pointer-events-auto absolute bottom-[6%] left-[2%]">
    <AutomationNotificationCard
      iconBg="bg-blue-600"
      title="Client signed contract"
      description="Invoice created and sent to client automatically"
      rotation={5}
    >
      <FileText slot="icon" class="h-[17px] w-[17px]" stroke-width="2" />
    </AutomationNotificationCard>
  </div>

  <!-- Bottom-right — 4th color not yet defined in DESIGN_SYSTEM.md;
       using a plain Tailwind swatch (rose-500) as a placeholder. Flag
       this for design review before shipping, or reuse one of the three
       approved colors above instead. -->
  <div class="pointer-events-auto absolute bottom-[6%] right-[2%]">
    <AutomationNotificationCard
      iconBg="bg-rose-500"
      title="New project created"
      description="Time tracking is now live for this client"
      rotation={-4}
    >
      <FolderOpen slot="icon" class="h-[17px] w-[17px]" stroke-width="2" />
    </AutomationNotificationCard>
  </div>
</div>
