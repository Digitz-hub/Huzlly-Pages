---
// src/components/ui/why-us-cards/ProposalFlowPreview.astro
//
// Compact "client -> proposal -> contract" workflow preview, ported from a
// user-supplied HTML/CSS reference (client pill -> proposal focus card ->
// e-signed contract card, connected by lines). The reference canvas was
// ~700x300 with a below-560px vertical stacking breakpoint; here it's
// scaled down and kept strictly horizontal at every width instead, since
// this component always lives inside a short, fixed-height box (h-32
// sm:h-40 - see WhyUs.astro) that's wide relative to its height at every
// breakpoint. All three nodes + connectors get proportionally smaller
// widths/fonts/paddings on mobile (below sm) rather than restacking
// vertically, so the whole flow still reads as one continuous pipeline
// no matter how narrow the card gets.
//
// Styling intentionally follows the how-it-works illustration components
// (src/components/ui/how-it-works-cards/HowItWorks*.astro) rather than
// the sitewide ink/paper/rail tokens: those components are the existing
// precedent in this codebase for "little app-UI mockup" visuals, and use
// slate-900/slate-500/slate-200 + the electric brand blue for exactly this
// kind of card/badge/connector treatment. Amber and emerald are kept as
// semantic status colors (pending vs. signed/accepted) since neither
// concept exists in the sitewide token set and the reference relies on
// that color distinction to read correctly.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['flex h-full w-full items-center justify-center gap-1 px-1.5 sm:gap-2 sm:px-3', className]}
  aria-hidden="true"
>
  <!-- Node 1: Client / new lead -->
  <div class="flex w-[58px] shrink-0 flex-col gap-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 shadow-sm sm:w-[82px] sm:gap-1.5 sm:rounded-xl sm:px-2.5 sm:py-2">
    <span class="text-[6.5px] font-medium leading-none text-slate-400 sm:text-[8.5px]">Client</span>
    <span class="truncate text-[7.5px] font-semibold leading-tight text-slate-900 sm:text-[9.5px]">Acme Studio</span>
    <span class="flex items-center gap-1">
      <span class="h-1 w-1 shrink-0 rounded-full bg-amber-500 sm:h-1.5 sm:w-1.5"></span>
      <span class="truncate text-[6.5px] font-medium leading-none text-slate-400 sm:text-[8px]">New Lead</span>
    </span>
  </div>

  <!-- Connector: client -> proposal -->
  <div class="flex shrink-0 items-center">
    <span class="h-1 w-1 shrink-0 rounded-full border border-slate-300 bg-white sm:h-1.5 sm:w-1.5"></span>
    <span class="h-px w-2.5 shrink-0 bg-slate-200 sm:w-5"></span>
  </div>

  <!-- Node 2: Proposal (primary focus card) -->
  <div class="flex w-[100px] shrink-0 flex-col rounded-lg border border-slate-200 bg-white px-2 py-1.5 shadow-md sm:w-[136px] sm:rounded-xl sm:px-2.5 sm:py-2">
    <div class="mb-1 flex items-start gap-1 sm:mb-1.5 sm:gap-1.5">
      <span class="flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-[5px] bg-amber-50 text-amber-600 sm:h-5 sm:w-5 sm:rounded-md">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-2 w-2 sm:h-3 sm:w-3">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <path d="M14 2v6h6"/>
          <path d="M9 13h6"/>
          <path d="M9 17h4"/>
        </svg>
      </span>
      <span class="line-clamp-2 text-[7px] font-semibold leading-tight text-slate-900 sm:text-[9px]">Brand Identity &amp; Web Design</span>
    </div>
    <div class="mt-auto border-t border-slate-100 pt-1 sm:pt-1.5">
      <span class="inline-flex items-center gap-0.5 rounded-full bg-emerald-50 px-1.5 py-[1px] text-[6px] font-semibold text-emerald-600 sm:px-2 sm:py-[3px] sm:text-[7.5px]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="h-[6px] w-[6px] sm:h-[8px] sm:w-[8px]">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        Accepted
      </span>
    </div>
  </div>

  <!-- Connector: proposal -> contract (active) -->
  <div class="flex shrink-0 items-center">
    <span class="h-1 w-1 shrink-0 rounded-full bg-electric sm:h-1.5 sm:w-1.5"></span>
    <span class="h-0 w-2.5 shrink-0 border-t border-dashed border-electric/50 sm:w-5"></span>
  </div>

  <!-- Node 3: Contract, e-signed -->
  <div class="flex w-[78px] shrink-0 flex-col gap-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 shadow-sm sm:w-[104px] sm:gap-1.5 sm:rounded-xl sm:px-2.5 sm:py-2">
    <div class="flex items-center gap-1 sm:gap-1.5">
      <span class="flex h-3 w-3 shrink-0 items-center justify-center rounded-[4px] bg-emerald-50 text-emerald-600 sm:h-4 sm:w-4 sm:rounded-[5px]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[7px] w-[7px] sm:h-2.5 sm:w-2.5">
          <rect x="3" y="11" width="18" height="10" rx="2"/>
          <path d="M7 11V8a5 5 0 0 1 9.9-1"/>
        </svg>
      </span>
      <span class="truncate text-[6.5px] font-semibold leading-tight text-slate-900 sm:text-[8.5px]">Service Agreement</span>
    </div>
    <span class="flex items-center gap-0.5 pl-[16px] sm:gap-1 sm:pl-[21px]">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="h-[6px] w-[6px] shrink-0 text-emerald-600 sm:h-[8px] sm:w-[8px]">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="truncate text-[6px] font-medium leading-none text-emerald-600 sm:text-[7.5px]">E-signed</span>
    </span>
  </div>
</div>
