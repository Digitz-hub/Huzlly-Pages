---
// src/components/ui/AutomationNotificationCard.astro
// Collapsible "automation event" notification card — designed to sit as a
// floating/scattered element in a hero section, implying a live automation
// just ran inside Huzlly (e.g. "Client signed contract").
//
// Collapsed: icon badge + title + chevron, single row, vertically centered.
// Expanded (on click/Enter/Space): a divider + description slide open below
// the header row via a CSS grid-template-rows animation. The divider and
// description are indented to align under the title, not the icon.
//
// No JS framework needed — this repo has no React/Vue integration installed
// (see astro.config.mjs), so interactivity here follows the same pattern as
// FAQAccordion.astro / Hero.astro's `.reveal` blocks: plain CSS + a small
// inline <script>, with a `prefers-reduced-motion` fallback.
//
// Icon is passed via the "icon" slot so any lucide-astro icon (or custom
// SVG) can be used per instance — this component only owns layout/behavior,
// not icon content. `iconBg` should be a Tailwind background class using
// DESIGN_SYSTEM.md tokens (bg-blue-600 / bg-teal-600 / bg-amber-500 are the
// three currently-approved signal/accent colors; a 4th color for a 4-card
// set isn't defined in the system yet — pick one and flag it for review
// rather than inventing a new hex value here).
//
// Rotation is applied via `rotationClass` — a full Tailwind rotate class
// (e.g. 'rotate-6', '-rotate-6') passed straight into class:list. This
// replaces an earlier numeric `rotation` prop that drove rotation through
// an inline `style="transform: rotate(...)"` attribute, which violated
// CLAUDE.md Section 3's zero-tolerance inline-style rule. No inline style
// anywhere in this component now.

export interface Props {
  iconBg?: string; // Tailwind bg-* class, e.g. 'bg-teal-600'
  title: string;
  description: string;
  rotationClass?: string; // Tailwind rotate class, e.g. '-rotate-6' or 'rotate-3'
  defaultExpanded?: boolean;
  class?: string;
}

const {
  iconBg = 'bg-blue-600',
  title,
  description,
  rotationClass = '',
  defaultExpanded = false,
  class: className,
} = Astro.props;
---

<div class:list={[
    'automation-card w-72 sm:w-80 cursor-pointer select-none rounded-2xl border border-rail bg-paper p-4',
    'shadow-[0_20px_40px_-12px_rgba(20,17,15,0.18),0_6px_14px_-4px_rgba(20,17,15,0.08)]',
    rotationClass,
    className,
  ]}
  data-expanded={defaultExpanded ? 'true' : 'false'}
  role="button"
  tabindex="0"
  aria-expanded={defaultExpanded}
>
  <!-- Header row: icon + title + chevron — self-contained, fixed height regardless of expand state -->
  <div class="flex items-center gap-2.5">
    <div class:list={['flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-white', iconBg]}>
      <slot name="icon" />
    </div>
    <div class="flex min-w-0 flex-1 items-center justify-between gap-2">
      <span class="truncate font-display text-sm font-semibold text-ink">{title}</span>
      <svg class="chevron h-4 w-4 shrink-0 text-ink/40 transition-transform duration-200 ease-in-out"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 9l6 6 6-6" />
      </svg>
    </div>
  </div>

  <!-- Divider + description — separate block below the header row, indented to align under the title column (not the icon) -->
  <div class="detail-wrap grid pl-[46px] transition-[grid-template-rows] duration-300 ease-in-out">
    <div class="overflow-hidden">
      <div class="detail-inner opacity-0 transition-opacity duration-300 ease-in-out">
        <div class="mt-3 border-t border-rail"></div>
        <p class="pt-2 text-xs leading-snug text-ink/50">{description}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .automation-card .detail-wrap {
    grid-template-rows: 0fr;
  }
  .automation-card[data-expanded='true'] .detail-wrap {
    grid-template-rows: 1fr;
  }
  .automation-card[data-expanded='true'] .detail-inner {
    opacity: 1;
  }
  .automation-card[data-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .automation-card .detail-wrap,
    .automation-card .detail-inner,
    .automation-card .chevron {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.automation-card').forEach((card) => {
    const toggle = () => {
      const expanded = card.getAttribute('data-expanded') === 'true';
      card.setAttribute('data-expanded', expanded ? 'false' : 'true');
      card.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    };
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>
