---
// src/components/ui/HuzzlyWithoutIllustration.astro
//
// Inlines the "Without Huzlly" scattered-tools illustration from
// src/components/ui/huzzly-without.svg as literal markup, mirroring the
// approach used for HuzzlyWithIllustration.astro on the other side of the
// same "Why Huzlly exists" comparison.
//
// Why inlined rather than imported or referenced by path:
// - astro.config.mjs only wires up the `astro-icon` integration, which
//   handles icon fonts, not arbitrary local .svg files — there's no
//   SVG-as-Astro-component pipeline configured in this project.
// - The source file lives under src/components/ui/, not public/, so a
//   plain <img src="..."> reference isn't an option either without
//   duplicating the asset into public/.
//
// This single illustration replaces the old hand-built composition in
// about.astro (scattered absolutely-positioned chips from a `tools` +
// `beforeChipStyles` pairing, dashed decorative circles, and dashed SVG
// connector paths) with one responsive graphic.
//
// The SVG markup below is copied as-is from huzzly-without.svg — the only
// change is on the root <svg> element, where the fixed width="688"
// height="444" attributes are swapped for `class="h-auto w-full"` so the
// illustration scales to fill whatever container it's placed in. The
// original file itself is left untouched. The illustration already has
// its own "Too many tools. Too much manual work." quote baked into the
// artwork, so no separate quote block is rendered alongside it.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['relative mx-auto w-full max-w-[280px] sm:max-w-sm', className]} aria-hidden="true">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="42 132 688 444" class="h-auto w-full" fill="none" role="img" aria-labelledby="t d" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
<title id="t">Without Huzzly</title><desc id="d">Scattered tools connected by tangled manual links: proposals, payments, e-signatures, invoicing and project setup.</desc>
<defs>
<style>
@font-face{font-family:'HuzzlyInter';font-weight:500;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'HuzzlyCaveat';font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}
.lbl{font-family:'HuzzlyInter',Inter,system-ui,-apple-system,'Segoe UI',sans-serif;font-weight:500;font-size:15px}
.note{font-family:'HuzzlyCaveat',Caveat,'Segoe Print','Comic Sans MS',cursive;font-weight:400;font-size:20px}
</style>
<filter id="chipShadow" x="-30%" y="-40%" width="160%" height="190%" color-interpolation-filters="sRGB"><feDropShadow dx="0" dy="10" stdDeviation="11" flood-color="#5A6390" flood-opacity="0.14"/></filter>
