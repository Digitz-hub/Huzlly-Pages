---
// src/components/ui/ScatterDecoration.astro
// Purely decorative full-bleed hero layer. SUPERSEDES the previous
// "glass/chrome" scattered-panel version (six frosted, tinted, floating
// panels driven by float-animation.css) — that pass is fully replaced,
// not layered alongside this one, per the standing "one decorative
// pattern per component" rule.
//
// This is now an animated starfield/warp-tunnel effect: a full-bleed
// `<canvas>` rendered and driven by `src/scripts/starfield.ts`, which
// is a vanilla-TS port of the "Glitter Wrap" Originkit/Framer component
// (glittering sparkle flashes streaming toward/away from the viewer).
// This project has no React and no Framer runtime, so only the actual
// canvas simulation/rendering algorithm was ported over — see that
// file's own header comment for the full breakdown of what was kept vs.
// stripped.
//
// POSITIONING: unlike the previous panel version (which hugged the
// section's padded content box via `top-24 sm:top-28 lg:top-32` /
// `bottom-28 sm:bottom-40` offsets, since those panels needed clearance
// from the header/footer edges of the hero's own padding), this canvas
// is `absolute inset-0` — full-bleed across the entire parent `<section>`,
// same convention DotPattern.astro already uses for its own full-bleed
// texture layer. A warp-tunnel effect reads correctly filling the whole
// stage, not clipped to an inset content box.
//
// STACKING ORDER: kept at `-z-[5]`, same value the previous panel wrapper
// used and matching DotPattern.astro's own documented reasoning —
// less negative than the `.hero-grain` overlay's `-z-[9]` (grain paints
// furthest back, this layer paints just in front of it), while still
// sitting behind the in-flow, un-z-indexed content column and behind
// DotPattern (per Hero.astro's DOM order: grain → this starfield →
// DotPattern → content).
//
// MOTION: respects `prefers-reduced-motion: reduce` the same way
// Hero.astro's own `<script>` block does (checking
// `window.matchMedia('(prefers-reduced-motion: reduce)').matches`) —
// `starfield.ts`'s `initStarfield` draws a single static frame
// and never starts the animation loop when that preference is set,
// rather than continuously animating.
//
// VISIBILITY: like the previous version, the `lg:`-only visibility
// toggle is NOT hardcoded here — the consumer (Hero.astro) applies
// `class="hidden lg:block"` on this component's usage, which flows into
// the `class` prop below and lands on the wrapper.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['pointer-events-none absolute -z-[5] inset-0', className]}
  aria-hidden="true"
>
  <canvas data-hero-starfield class="block h-full w-full"></canvas>
</div>

<script>
  import { initStarfield } from '../../scripts/starfield';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-starfield]');
  if (canvas) {
    initStarfield(canvas);
  }
</script>
