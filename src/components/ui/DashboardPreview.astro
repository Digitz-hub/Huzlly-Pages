---
// src/components/ui/DashboardPreview.astro
// Bento-grid "product dashboard" visual for the homepage hero — converted
// from the approved hero-dashboard-preview.html mockup. This is a fixed,
// content-complete, single-purpose component built only for Hero.astro's
// hero section; it is NOT a general-purpose primitive and isn't meant to
// be reused elsewhere or extended with props for other content. Renders
// only the bento grid itself — the "Monopol" eyebrow and headline in the
// source preview were placeholder text for the standalone mockup and are
// intentionally dropped here; the real eyebrow/H1 belong to Hero.astro
// per this task's brief. Not yet wired into Hero.astro — that's a
// separate stage.
//
// AutomationNotificationCard.astro is untouched by this file and is not
// used here — this component owns its own card markup directly since the
// preview's cards (fixed layout, no expand/collapse, no icon slot) don't
// match that component's collapsible-notification contract.
//
// No required props — this is a fixed, content-complete block. `class`
// is accepted for outer placement/spacing only, matching the passthrough
// pattern already used on AutomationNotificationCard.
//
// STEP 3 — full port of freelancer-pain-points-redesign.html's 5-card
// bento grid (replaces the earlier 3-column/9-card-slot bento built in
// prior passes). Grid: `grid-cols-12` at the `lg` breakpoint (this
// project's existing grid-switch convention, in place of the mockup's
// custom 900px breakpoint) with `lg:col-span-*`/`lg:row-span-*` matching
// the mockup's spans exactly (admin 5/2, apps 4, time 3, fees 7, comm
// 12). Below `lg`, every card reverts to the implicit single-column
// stack in DOM order (1 → 2 → 3 → 4 → 5), same as before.
//
// Outfit font: applied locally to this file's headings/numerals via
// inline `style="font-family: 'Outfit', sans-serif;"`, the same approach
// used for TheShift.astro's <h2> in Step 2 — not added to Tailwind's
// global font config. The `<link>` tags that actually load Outfit +
// Phosphor live in TheShift.astro (Step 1) and are unchanged/untouched
// here.
//
// Coral accent: mockup's single locked accent (`#e0492e` / tint
// `#fdece7` / tint-border `#f6cfc5`) applied via Tailwind arbitrary-value
// classes wherever the mockup uses it — the "0 billable hours" pill +
// toggle switch on card 1, the "Unpaid Time" badge on card 3, and the
// donut chart's colored arc + "SaaS bloat" figure on card 4 — matching
// the same hex values established in Step 2, not added to
// tailwind.config.mjs.
//
// Card 1 dark theme: mockup's dark admin card re-themed here with
// `bg-ink text-white` (this project's existing dark-surface token,
// already used as the "on-dark" fill for card 5's icon tile), with the
// icon tile, body copy, divider, and toggle switch adjusted for
// on-dark contrast per the mockup (translucent icon tile, muted-white
// body copy, translucent divider).
//
// Card 4 donut: pure CSS conic-gradient circle (no image), coral arc
// sized to the mockup's 35% figure (35% of 360° ≈ 126deg), with an
// inset white/paper disc behind the "35% / SaaS bloat" label — same
// technique as the mockup's `.fee-figure`/`::after` construction, just
// rebuilt with Tailwind arbitrary-value utilities instead of custom CSS
// classes.
//
// No scroll-triggered fade-in / IntersectionObserver / animation classes
// ported from the mockup — every card renders fully visible immediately,
// static, per the brief.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['grid grid-cols-1 gap-5 lg:grid-cols-12', className]} data-dashboard-preview>

  <!-- Card 1: Trapped in Admin Work (dark, spans 5 cols + 2 rows) -->
  <div class="flex flex-col rounded-2xl bg-ink p-6 text-white shadow-sm lg:col-span-5 lg:row-span-2">
    <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-white/10">
      <i class="ph-duotone ph-clipboard-text text-2xl text-white" aria-hidden="true"></i>
    </div>
    <h3 style="font-family: 'Outfit', sans-serif;" class="mb-2 text-xl font-semibold leading-snug text-white">Trapped in Admin Work</h3>
    <p class="flex-grow text-base leading-relaxed text-white/60">Every accepted proposal triggers a mountain of unpaid prep: custom agreements, invoice reminders, and shared drives. It feels like a full-time job before work even starts.</p>
    <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-5">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#fdece7]/10 px-3 py-1 text-xs font-medium text-[#ff9a85]">
        <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
        0 billable hours
      </span>
      <span class="relative inline-block h-[22px] w-[38px] flex-shrink-0 rounded-full bg-[#e0492e]" aria-hidden="true">
        <span class="absolute right-[3px] top-[3px] h-4 w-4 rounded-full bg-white"></span>
      </span>
    </div>
  </div>

  <!-- Card 2: Too Many Disconnected Apps (spans 4 cols) -->
  <div class="rounded-2xl bg-white p-6 shadow-sm lg:col-span-4">
    <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-[#fdece7]">
      <i class="ph-duotone ph-squares-four text-2xl text-[#e0492e]" aria-hidden="true"></i>
    </div>
    <h3 style="font-family: 'Outfit', sans-serif;" class="mb-2 text-xl font-semibold leading-snug text-ink">Too Many Disconnected Apps</h3>
    <p class="text-base leading-relaxed text-ink/70">A different app for every task. You end up switching tabs and copying the same info everywhere.</p>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
        <i class="ph-duotone ph-file-text text-sm text-[#e0492e]" aria-hidden="true"></i>
        Agreements
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
        <i class="ph-duotone ph-receipt text-sm text-[#e0492e]" aria-hidden="true"></i>
        Billing
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
        <i class="ph-duotone ph-kanban text-sm text-[#e0492e]" aria-hidden="true"></i>
        Task Boards
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
        <i class="ph-duotone ph-chat-circle-dots text-sm text-[#e0492e]" aria-hidden="true"></i>
        Client DMs
      </span>
      <span class="inline-flex items-center rounded-full border border-dashed border-ink/15 px-3 py-1 text-xs font-medium text-ink/40">
        + 4 more
      </span>
    </div>
  </div>

  <!-- Card 3: Chasing Payments (spans 3 cols) -->
  <div class="flex flex-col rounded-2xl bg-white p-6 shadow-sm lg:col-span-3">
    <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-[#fdece7]">
      <i class="ph-duotone ph-hourglass-medium text-2xl text-[#e0492e]" aria-hidden="true"></i>
    </div>
    <h3 style="font-family: 'Outfit', sans-serif;" class="mb-2 text-xl font-semibold leading-snug text-ink">Chasing Payments</h3>
    <p class="flex-grow text-base leading-relaxed text-ink/70">Following up on unpaid invoices, hearing "it's in process," and losing days waiting for payouts.</p>
    <div class="mt-5 flex items-center gap-2 border-t border-rail pt-5">
      <span style="font-family: 'Outfit', sans-serif;" class="text-2xl font-bold tracking-tight text-ink">5–8<span class="ml-1 text-sm font-medium text-ink/40">hrs/wk</span></span>
      <span class="ml-auto inline-flex items-center rounded-full bg-[#fdece7] px-3 py-1 text-xs font-medium text-[#e0492e]">Unpaid Time</span>
    </div>
  </div>

  <!-- Card 4: Lost to Hidden Fees & Cuts (spans 7 cols, horizontal) -->
  <div class="flex items-center gap-8 rounded-2xl bg-white p-6 shadow-sm lg:col-span-7">
    <div class="relative flex h-[150px] w-[150px] flex-shrink-0 items-center justify-center rounded-full" style="background: conic-gradient(#e0492e 0deg 126deg, #f0ece6 126deg 360deg);">
      <div class="absolute inset-[11px] flex flex-col items-center justify-center rounded-full bg-white">
        <span style="font-family: 'Outfit', sans-serif;" class="text-2xl font-bold tracking-tight text-ink">35%</span>
        <span class="text-[10px] font-semibold uppercase tracking-wide text-ink/40">SaaS bloat</span>
      </div>
    </div>
    <div class="min-w-0">
      <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[#fdece7]">
        <i class="ph-duotone ph-chart-pie-slice text-2xl text-[#e0492e]" aria-hidden="true"></i>
      </div>
      <h3 style="font-family: 'Outfit', sans-serif;" class="mb-2 text-xl font-semibold leading-snug text-ink">Lost to Hidden Fees &amp; Cuts</h3>
      <p class="text-base leading-relaxed text-ink/70">Marketplace commissions and heavy per-seat software fees quietly eat 30–40% of your actual earnings.</p>
    </div>
  </div>

  <!-- Card 5: Messy Client Communication & Scope Creep (full width, horizontal) -->
  <div class="flex flex-col items-start gap-4 rounded-2xl bg-white p-6 shadow-sm sm:flex-row sm:items-center lg:col-span-12">
    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[#fdece7]">
      <i class="ph-duotone ph-chats-circle text-2xl text-[#e0492e]" aria-hidden="true"></i>
    </div>
    <div class="flex-grow">
      <div class="flex flex-wrap items-center gap-3">
        <h3 style="font-family: 'Outfit', sans-serif;" class="text-xl font-semibold leading-snug text-ink">Messy Client Communication &amp; Scope Creep</h3>
        <span class="inline-flex items-center rounded-full bg-[#fdece7] px-3 py-1 text-xs font-medium text-[#e0492e]">Zero Boundaries</span>
      </div>
      <p class="mt-2 text-base leading-relaxed text-ink/70">Files scattered across WhatsApp, email, and DMs. Unpaid extra revisions, and constantly explaining project status to clients.</p>
    </div>
  </div>

</div>
