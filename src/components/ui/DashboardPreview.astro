---
// src/components/ui/DashboardPreview.astro

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['grid grid-cols-1 gap-5 lg:grid-cols-12', className]} data-dashboard-preview>

  <div class="flex flex-col rounded-2xl border border-[#e8e9f0] p-6 text-white lg:col-span-5 lg:row-span-2" style="background: linear-gradient(160deg, #3f5ce0, #0b1024 78%); box-shadow: 0 16px 36px -14px rgba(20,24,43,0.35);">
    <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-[rgba(255,255,255,0.16)]">
      <i class="ph-duotone ph-clipboard-text text-2xl text-white" aria-hidden="true"></i>
    </div>
    <h3 class="mb-2 text-xl font-semibold leading-snug text-white font-display">Trapped in Admin Work</h3>
    <p class="flex-grow text-base leading-relaxed text-[rgba(255,255,255,0.72)]">Every accepted proposal triggers a mountain of unpaid prep: custom agreements, invoice reminders, and shared drives. It feels like a full-time job before work even starts.</p>
    <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-5">
      <span class="inline-flex items-center gap-2 rounded-full bg-[rgba(255,255,255,0.18)] px-3 py-1 text-xs font-medium text-white">
        <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
        0 billable hours
      </span>
      <span class="relative inline-block h-[22px] w-[38px] flex-shrink-0 rounded-full bg-[rgba(255,255,255,0.18)]" aria-hidden="true">
        <span class="absolute right-[3px] top-[3px] h-4 w-4 rounded-full bg-white"></span>
      </span>
    </div>
  </div>

  <div class="lg:col-span-7 grid grid-cols-1 gap-5 lg:grid-cols-2">
    <div class="rounded-2xl border border-[#e8e9f0] bg-white p-6 shadow-[0_10px_26px_-16px_rgba(20,24,43,0.14)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_-16px_rgba(20,24,43,0.20)]">
      <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-[#eef1ff]">
        <i class="ph-duotone ph-squares-four text-2xl text-[#3f5ce0]" aria-hidden="true"></i>
      </div>
      <h3 class="mb-2 text-xl font-semibold leading-snug text-[#14182b] font-display">Too Many Disconnected Apps</h3>
      <p class="text-base leading-relaxed text-[#666c7d]">A different app for every task. You end up switching tabs and copying the same info everywhere.</p>
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
          <i class="ph-duotone ph-file-text text-sm text-[#3f5ce0]" aria-hidden="true"></i>
          Agreements
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
          <i class="ph-duotone ph-receipt text-sm text-[#3f5ce0]" aria-hidden="true"></i>
          Billing
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
          <i class="ph-duotone ph-kanban text-sm text-[#3f5ce0]" aria-hidden="true"></i>
          Task Boards
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-rail/30 px-3 py-1 text-xs font-medium text-ink/70 ring-1 ring-inset ring-ink/10">
          <i class="ph-duotone ph-chat-circle-dots text-sm text-[#3f5ce0]" aria-hidden="true"></i>
          Client DMs
        </span>
        <span class="inline-flex items-center rounded-full border border-dashed border-ink/15 px-3 py-1 text-xs font-medium text-[#9297a6]">
          + 4 more
        </span>
      </div>
    </div>

    <div class="flex flex-col rounded-2xl border border-[#e8e9f0] bg-white p-6 shadow-[0_10px_26px_-16px_rgba(20,24,43,0.14)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_-16px_rgba(20,24,43,0.20)]">
      <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-[#eef1ff]">
        <i class="ph-duotone ph-hourglass-medium text-2xl text-[#3f5ce0]" aria-hidden="true"></i>
      </div>
      <h3 class="mb-2 text-xl font-semibold leading-snug text-[#14182b] font-display">Chasing Payments</h3>
      <p class="flex-grow text-base leading-relaxed text-[#666c7d]">Following up on unpaid invoices, hearing "it's in process," and losing days waiting for payouts.</p>
      <div class="mt-5 flex items-center gap-2 border-t border-rail pt-5">
        <span style="font-family: 'Outfit', sans-serif;" class="text-2xl font-bold tracking-tight text-[#14182b]">5–8<span class="ml-1 text-sm font-medium text-[#9297a6]">hrs/wk</span></span>
        <span class="ml-auto inline-flex items-center rounded-full bg-[#eef1ff] px-3 py-1 text-xs font-medium text-[#3f5ce0]">Unpaid Time</span>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-8 rounded-2xl border border-[#e8e9f0] bg-white p-6 shadow-[0_10px_26px_-16px_rgba(20,24,43,0.14)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_-16px_rgba(20,24,43,0.20)] lg:col-span-7">
    <div class="relative flex h-[150px] w-[150px] flex-shrink-0 items-center justify-center rounded-full" style="background: conic-gradient(#3f5ce0 0deg 126deg, #eef0f5 126deg 360deg);">
      <div class="absolute inset-[11px] flex flex-col items-center justify-center rounded-full bg-white">
        <span style="font-family: 'Outfit', sans-serif;" class="text-2xl font-bold tracking-tight text-[#14182b]">35%</span>
        <span class="text-[10px] font-semibold uppercase tracking-wide text-[#9297a6]">SaaS bloat</span>
      </div>
    </div>
    <div class="min-w-0">
      <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[#eef1ff]">
        <i class="ph-duotone ph-chart-pie-slice text-2xl text-[#3f5ce0]" aria-hidden="true"></i>
      </div>
      <h3 class="mb-2 text-xl font-semibold leading-snug text-[#14182b] font-display">Lost to Hidden Fees &amp; Cuts</h3>
      <p class="text-base leading-relaxed text-[#666c7d]">Marketplace commissions and heavy per-seat software fees quietly eat 30–40% of your actual earnings.</p>
    </div>
  </div>

  <div class="flex flex-col items-start gap-4 rounded-2xl border border-[#e8e9f0] bg-white p-6 shadow-[0_10px_26px_-16px_rgba(20,24,43,0.14)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_-16px_rgba(20,24,43,0.20)] sm:flex-row sm:items-center lg:col-span-12">
    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[#eef1ff]">
      <i class="ph-duotone ph-chats-circle text-2xl text-[#3f5ce0]" aria-hidden="true"></i>
    </div>
    <div class="flex-grow">
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="text-xl font-semibold leading-snug text-[#14182b] font-display">Messy Client Communication &amp; Scope Creep</h3>
        <span class="inline-flex items-center rounded-full bg-[#eef1ff] px-3 py-1 text-xs font-medium text-[#3f5ce0]">Zero Boundaries</span>
      </div>
      <p class="mt-2 text-base leading-relaxed text-[#666c7d]">Files scattered across WhatsApp, email, and DMs. Unpaid extra revisions, and constantly explaining project status to clients.</p>
    </div>
  </div>

</div>
