---
// src/components/ui/Card.astro

export interface Props {
  variant?: 'flat' | 'flat-lift' | 'elevated' | 'highlighted';
  class?: string;
  as?: 'div' | 'li' | 'article';
  tick?: boolean;
}

const { variant = 'flat', class: className, as: Tag = 'div', tick = false } = Astro.props;

const classesByVariant: Record<string, string> = {
  flat: 'rounded-2xl bg-paper p-6 hover:shadow-md transition-all duration-200 ease-in-out',
  'flat-lift':
    'rounded-2xl bg-paper p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-200 ease-in-out',
  elevated:
    'rounded-2xl bg-paper p-6 shadow-sm hover:shadow-md transition-shadow duration-200 ease-in-out',
  highlighted: 'rounded-2xl bg-paper p-6 shadow-md',
};

const showTick = tick && (variant === 'flat' || variant === 'flat-lift');

const classes = [classesByVariant[variant], showTick ? 'relative' : '', className]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes}>
  {
    showTick && (
      <span class="pointer-events-none absolute left-3 top-3 h-2.5 w-2.5 text-rail" aria-hidden="true">
        <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 0V10M0 5H10" stroke="currentColor" stroke-width="1" />
        </svg>
      </span>
    )
  }
  <slot />
</Tag>
