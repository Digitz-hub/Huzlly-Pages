---
// src/components/ui/SectionHeader.astro
// Centered eyebrow + heading + lead paragraph per DESIGN_SYSTEM.md
// Section 4 ("Section Header Pattern").
// Redesign pass: heading moves to the Plus Jakarta Sans display face
// (font-display) and the neutral palette moves to stone-*.

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { eyebrow, title, subtitle, as: HeadingTag = 'h2', class: className } = Astro.props;

// Section H2 type scale from DESIGN_SYSTEM.md Section 2. If `as="h1"` is used
// (e.g. a page's single H1 doubling as a section header), the Hero H1 scale
// is applied instead so heading level and visual scale stay in sync. Both
// scales now carry font-display per the type-pairing redesign.
const headingClasses =
  HeadingTag === 'h1'
    ? 'font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-stone-900 leading-[1.1]'
    : 'font-display mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-stone-900';
---

<div class={['mx-auto max-w-2xl text-center', className].filter(Boolean).join(' ')}>
  {eyebrow && <p class="text-xs font-medium uppercase tracking-wide text-blue-600">{eyebrow}</p>}
  <HeadingTag class={headingClasses}>{title}</HeadingTag>
  {subtitle && <p class="mt-4 text-lg text-stone-600">{subtitle}</p>}
</div>
