---
// src/components/ui/SectionHeader.astro

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { eyebrow, title, subtitle, as: HeadingTag = 'h2', class: className } = Astro.props;

const headingClasses =
  HeadingTag === 'h1'
    ? 'font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]'
    : 'font-display mt-2 text-3xl sm:text-4xl font-semibold tracking-tight text-ink';
---

<div class={['mx-auto max-w-2xl text-center', className].filter(Boolean).join(' ')}>
  {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-blue-600">{eyebrow}</p>}
  <HeadingTag class={headingClasses}>{title}</HeadingTag>
  {subtitle && <p class="mt-4 text-lg text-ink/70">{subtitle}</p>}
</div>
