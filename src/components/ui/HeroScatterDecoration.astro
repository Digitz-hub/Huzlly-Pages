---
// src/components/ui/HeroScatterDecoration.astro
// Purely decorative scattered-dot layer, designed as a companion to the
// floating AutomationNotificationCard set — not a second competing
// "background pattern" alongside Hero.astro's cloud-blur glow.
// The cloud-blur is atmosphere (sits behind everything); this layer is a
// foreground prop of small dots scattered across the hero, mixing with the
// gradient rather than clustering strictly at the corners.
//
// DESIGN SYSTEM NOTE (per CLAUDE.md Section 4.5 — Per-Page
// Inspiration-Driven Design): scoped to this component/hero only; does not
// change the sitewide illustration guidance in DESIGN_SYSTEM.md Section 7/7.5.
//
// Colors: dots use the three approved accent/signal tokens (blue-600,
// teal-600, amber-500) — no new hex values introduced. Size (small/medium/
// large) and opacity are varied per-dot so each stays legible against
// whatever part of the gradient it lands on; nothing here is an inline
// style="..." attribute, per the standing zero-tolerance rule — all
// variation is expressed through Tailwind utility classes and arbitrary
// bracket values under the decorative-transform exception in CLAUDE.md
// Section 3.
//
// TEXT-COLUMN CLEARANCE (this pass): Hero.astro centers its headline/
// paragraph content in a `max-w-2xl` (672px) column with no max-width on
// the `<section>` itself. This layer only renders at `lg:` and up (see
// Hero.astro's `class="hidden lg:block"` on this component), so the
// narrowest viewport it ever appears on is 1024px — at that width the
// centered column already spans from ~17% to ~83% horizontally, and that
// safe-zone-for-text only gets wider (not narrower) on bigger screens.
// Every dot below is kept at ≤15% from the left or right edge so none of
// them can ever land inside the text column at any `lg`+ width, while
// still landing well outside the four original corner positions.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 -z-[5]', className]}
  aria-hidden="true"
>
  <!-- Dots — scattered across the whole hero (corners + the open space
       further down each side), 3 sizes, 3 approved accent colors, opacity
       tuned per-dot for visibility against the gradient at that position.
       All 8 sit at ≤15% from the left/right edge (see clearance note
       above) so none of them ever fall inside the centered max-w-2xl
       text column. -->
  <span class="absolute left-[18%] top-[14%] h-2 w-2 rounded-full bg-teal-600/70"></span>
  <span class="absolute right-[22%] top-[10%] h-1.5 w-1.5 rounded-full bg-amber-500/70"></span>
  <span class="absolute bottom-[16%] left-[24%] h-2.5 w-2.5 rounded-full bg-blue-600/60"></span>
  <span class="absolute bottom-[10%] right-[18%] h-1.5 w-1.5 rounded-full bg-teal-600/60"></span>
  <span class="absolute left-[9%] top-[42%] h-1 w-1 rounded-full bg-amber-500/80"></span>
  <span class="absolute right-[9%] top-[60%] h-2 w-2 rounded-full bg-blue-600/50"></span>
  <span class="absolute left-[13%] bottom-[38%] h-1.5 w-1.5 rounded-full bg-teal-600/75"></span>
  <span class="absolute right-[13%] bottom-[24%] h-1 w-1 rounded-full bg-amber-500/65"></span>
</div>
