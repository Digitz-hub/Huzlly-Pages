---
// src/components/sections/TheProblem.astro

import DashboardPreview from '../ui/DashboardPreview.astro';
import { ArrowRight } from 'lucide-astro';

---

<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/duotone/style.css" />

<section id="the-problem" class="scroll-mt-20 relative border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="inline-flex items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]">
      <i class="ph-duotone ph-warning-circle text-base" aria-hidden="true"></i>
      Why freelancing feels harder than it should
    </div>

    <h2 class="mt-6 text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl font-display">
      Managing a freelance business was never supposed to feel this complicated.
    </h2>

    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink/70">
      Scattered spreadsheets, unpaid admin work, and chasing invoices quietly eat your time, your money, and your focus before a single client project even starts.
    </p>

    <DashboardPreview class="mt-14 mx-auto max-w-5xl" />

    <div class="mt-10 text-center">
      <a href="#how-it-works" class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 rounded-md">
        See how Huzlly fixes this
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </a>
    </div>
  </div>
</section>
