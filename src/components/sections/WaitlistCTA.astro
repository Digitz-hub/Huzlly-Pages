---
// src/components/sections/WaitlistCTA.astro

import { ArrowRight } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

export interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Get early access',
  subheading = "Huzlly is in closed beta. Join the waitlist and we'll email you when a spot opens — no sales calls, no spam, unsubscribe any time.",
} = Astro.props;
---

<section class="bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <Card variant="highlighted" class="p-8 sm:p-12 text-center relative overflow-hidden !bg-transparent">
      <div class="pointer-events-none absolute -z-[1] inset-0" aria-hidden="true">
        <canvas data-waitlist-cloudsky class="block h-full w-full"></canvas>
      </div>

      <Badge variant="beta" class="mx-auto !bg-white/90 !text-ink !ring-white/40">50 spots this cohort</Badge>

      <h2 class="mt-5 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
        {heading}
      </h2>
      <p class="mt-4 text-white/80 leading-relaxed max-w-md mx-auto">
        {subheading}
      </p>

      <div class="mt-8">
        <Button href="/waitlist" size="lg" motion>
          Join the waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </div>
    </Card>
  </div>
</section>

<script>
  import { initCloudSky } from '../../scripts/cloudsky';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-waitlist-cloudsky]');
  if (canvas) {
    initCloudSky(canvas);
  }
</script>
