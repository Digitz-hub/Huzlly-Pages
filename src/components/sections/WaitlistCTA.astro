---
// src/components/sections/WaitlistCTA.astro

import { ArrowRight } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import BlobDecoration from '../ui/BlobDecoration.astro';

export interface Props {
  heading?: string;
}

const {
  heading = "Let's Get Your Freelance Business Management Organized",
} = Astro.props;
---

<section class="bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <Card variant="highlighted" class="relative overflow-hidden p-8 sm:p-12 text-center !bg-electric">
      <BlobDecoration />

      <div class="relative z-10">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          {heading}
        </h2>

        <div class="mt-8">
          <Button href="/waitlist" size="lg" motion class="!bg-white !text-ink hover:!bg-white">
            Join the waitlist
            <ArrowRight class="w-4 h-4" stroke-width="1.75" />
          </Button>
        </div>
      </div>
    </Card>
  </div>
</section>
