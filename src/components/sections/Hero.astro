---
// src/components/sections/Hero.astro
// Homepage hero — v5 full redesign. Replaces the prior page-specific
// "Tools AI" inspiration override (floating icon cards + center glow
// node) with DESIGN_SYSTEM.md v2's actual sitewide signature element:
// the flow-rail diagram (Section 3 "Flow-Rail Diagram" spec, Section 6
// motion "Rail-Dot Travel", Quick Reference "Signature Element").
//
// Why: the floating-card treatment was a one-off inspiration swap; the
// system's own spec for the hero's signature visual is nodes sitting ON
// a rail line (blue -> teal -> amber gradient), not floating beside it.
// This version also makes the visual literal instead of generic —
// six nodes trace Huzlly's real product flow from SITE_IDENTITY_AND_AEO.md
// Section 3: Proposal -> Contract -> Invoice -> Project -> Tasks -> Client
// Portal, each captioned in the mono eyebrow style.
//
// Decorative pattern budget (DESIGN_SYSTEM.md Section 7.5 placement rule,
// one per page/area): dot-grid texture behind the hero, nothing else
// stacked in the same area. No ambient glow orb here.
//
// Motion: scroll-reveal (unchanged sitewide mechanism) + one-shot
// rail-dot travel along the gradient rail on first viewport entry
// (Section 6 "Rail-Dot Travel" — not looping). Both fully degrade
// under prefers-reduced-motion: dot is omitted rather than shown static,
// since the rail and captioned nodes stay completely legible without it.

import { ArrowRight, FileText, PenTool, Receipt, FolderKanban, ListChecks, Users } from 'lucide-astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

const flow = [
  { label: 'Proposal', icon: FileText },
  { label: 'Contract', icon: PenTool },
  { label: 'Invoice', icon: Receipt },
  { label: 'Project', icon: FolderKanban },
  { label: 'Tasks', icon: ListChecks },
  { label: 'Portal', icon: Users },
];
---

<section class="relative overflow-hidden bg-paper px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
  <!-- Dot-grid texture — this hero's one decorative pattern, per
       DESIGN_SYSTEM.md Section 4 / 7.5. Not combined with an ambient
       glow in the same area. -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-40
              [background-image:radial-gradient(theme(colors.rail)_1px,transparent_1px)]
              [background-size:24px_24px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl text-center">
    <Badge variant="beta" class="reveal">Closed beta &middot; 50 spots this cohort</Badge>

    <h1 class="reveal mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]">
      One flow.<br class="hidden sm:block" /> Not five apps.
    </h1>

    <p class="reveal mt-6 text-lg sm:text-xl text-ink/70 leading-relaxed max-w-2xl mx-auto">
      Freelancers stitch proposals, contracts, invoicing, and project setup together across a pile
      of disconnected tools. Huzlly turns that pile into one lean, automatic flow &mdash; built for
      solo freelancers, not agencies paying for seats they don't need.
    </p>

    <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button href="/waitlist" size="lg" motion>
        Join the waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
      <Button href="#how-it-works" variant="outline" size="lg">
        See how it works
      </Button>
    </div>
  </div>

  <!-- Signature: flow-rail diagram — six nodes tracing the real Huzlly
       flow, sitting on a blue -> teal -> amber gradient rail, with a
       one-shot traveling dot on first entry. DESIGN_SYSTEM.md Section 3
       "Flow-Rail Diagram (signature element spec)". -->

  <!-- Desktop / tablet: horizontal rail -->
  <div class="hero-visual reveal relative mx-auto mt-14 hidden max-w-4xl sm:block">
    <div class="relative h-0.5 w-full rounded-full bg-gradient-to-r from-blue-600 via-teal-600 to-amber-500">
      <span class="rail-dot absolute top-1/2 left-0 h-2 w-2 -translate-y-1/2 rounded-full bg-blue-600 shadow-[0_0_8px_2px_rgba(37,99,235,0.5)]" aria-hidden="true"></span>
    </div>
    <div class="mt-0 flex justify-between">
      {flow.map(({ label, icon: Icon }) => (
        <div class="flex -translate-y-1/2 flex-col items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full border border-rail bg-paper shadow-sm">
            <Icon class="h-4 w-4 text-blue-600" stroke-width="1.75" />
          </div>
          <span class="font-mono text-[11px] uppercase tracking-widest text-ink/50">{label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Mobile: vertical rail (same literal "nodes on a line" spec, rotated
       to fit narrow viewports without cramming six nodes into one row) -->
  <div class="hero-visual reveal relative mx-auto mt-12 max-w-xs sm:hidden">
    <div class="relative mx-auto w-0.5 self-stretch rounded-full bg-gradient-to-b from-blue-600 via-teal-600 to-amber-500" style="height: 100%;">
      <span class="rail-dot-vertical absolute top-0 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full bg-blue-600 shadow-[0_0_8px_2px_rgba(37,99,235,0.5)]" aria-hidden="true"></span>
    </div>
    <div class="absolute inset-0 flex flex-col justify-between py-1">
      {flow.map(({ label, icon: Icon }) => (
        <div class="flex items-center gap-4">
          <div class="flex h-10 w-10 shrink-0 -translate-x-1/2 items-center justify-center rounded-full border border-rail bg-paper shadow-sm">
            <Icon class="h-4 w-4 text-blue-600" stroke-width="1.75" />
          </div>
          <span class="font-mono text-[11px] uppercase tracking-widest text-ink/50">{label}</span>
        </div>
      ))}
    </div>
  </div>

  <p class="reveal mt-10 text-center text-xs font-medium text-ink/50 sm:mt-8">
    Designed to replace 5+ separate apps &mdash; connected into one automatic flow.
  </p>
</section>

<style>
  /* Scroll-reveal: elements start hidden, .is-visible fades/lifts them in.
     Falls back to always-visible if JS never runs or motion is reduced. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* Mobile vertical rail needs an explicit height since its children are
     absolutely positioned over it — sized to match the node stack. */
  .hero-visual.sm\:hidden {
    height: 300px;
  }

  /* Rail-dot travel — one-shot, not looping. Starts hidden; the
     IntersectionObserver below adds .is-visible to .hero-visual, which
     triggers this keyframe once via animation-fill-mode: forwards. */
  .rail-dot,
  .rail-dot-vertical {
    opacity: 0;
  }
  @keyframes rail-travel-x {
    0% { left: 0%; opacity: 1; }
    100% { left: 100%; opacity: 1; }
  }
  @keyframes rail-travel-y {
    0% { top: 0%; opacity: 1; }
    100% { top: 100%; opacity: 1; }
  }
  .hero-visual.is-visible .rail-dot {
    animation: rail-travel-x 1.4s 0.3s ease-in-out forwards;
  }
  .hero-visual.is-visible .rail-dot-vertical {
    animation: rail-travel-y 1.4s 0.3s ease-in-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    /* Rail-dot travel is omitted entirely under reduced motion — the
       rail and captioned nodes stay fully legible without it, per
       DESIGN_SYSTEM.md Section 6 "Rail-Dot Travel" fallback rule. */
    .rail-dot,
    .rail-dot-vertical {
      display: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealTargets = document.querySelectorAll('.reveal');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealTargets.forEach((el) => observer.observe(el));
  }
</script>
