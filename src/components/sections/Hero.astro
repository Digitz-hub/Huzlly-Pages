---
// src/components/sections/Hero.astro
// Homepage hero. Signature element is the "5 apps -> 1 flow" diagram: it
// makes the core pitch (Huzlly replaces a pile of disconnected tools with
// one connected pipeline) legible at a glance. Real product flow is
// Proposal -> Contract -> Invoice -> Project -> Tasks/Timesheets -> Client
// Portal; condensed to 4 nodes here (Proposal/Contract/Invoice/Project)
// with the tasks/time/portal stages folded into the caption below the
// diagram, since 6 nodes doesn't fit a compact hero diagram legibly.
// NOTE: FAQ.astro's "Product Questions" category matches this same flow —
// see FLOW_UPDATE_MIGRATION.md for the full migration history.
//
// v2 redesign pass: the "after" side of the diagram is rebuilt as a literal
// flow-rail (DESIGN_SYSTEM.md Section 3/4) — nodes sit ON a horizontal
// gradient line, with a one-shot traveling dot on load. Ambient glow is
// replaced by the dot-grid texture (Section 4) as this hero's one accent.

import { ArrowRight, FileText, PenTool, Receipt, FolderKanban, X } from 'lucide-astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

const scatteredTools = ['Proposal tool', 'E-sign app', 'Invoicing tool', 'Payment processor', 'Form builder'];

const flowSteps = [
  { label: 'Proposal', icon: FileText },
  { label: 'Contract', icon: PenTool },
  { label: 'Invoice', icon: Receipt },
  { label: 'Project', icon: FolderKanban },
];
---

<section class="relative overflow-hidden bg-paper px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
  <!-- Dot-grid texture — this hero's one accent, per DESIGN_SYSTEM.md
       Section 4. Not combined with an ambient glow in the same area. -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-40
              [background-image:radial-gradient(theme(colors.rail)_1px,transparent_1px)]
              [background-size:24px_24px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl text-center">
    <Badge variant="beta" class="reveal">Closed beta &middot; 50 spots this cohort</Badge>

    <h1 class="reveal mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]">
      One flow.<br class="hidden sm:block" /> Not five apps.
    </h1>

    <p class="reveal mt-6 text-lg sm:text-xl text-ink/70 leading-relaxed max-w-2xl mx-auto">
      Freelancers stitch proposals, contracts, invoicing, and project setup together across a pile
      of disconnected tools. Huzlly turns that pile into one lean, automatic flow &mdash; built for
      solo freelancers, not agencies paying for seats they don't need.
    </p>

    <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button href="/waitlist" size="lg" motion>
        Join the waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
      <Button href="#how-it-works" variant="outline" size="lg">
        See how it works
      </Button>
    </div>
  </div>

  <!-- Signature: scattered tools collapsing into one connected flow-rail -->
  <div class="reveal mt-16 sm:mt-20 mx-auto max-w-4xl">
    <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
      <!-- Before: scattered apps -->
      <div class="order-1 w-full lg:flex-1">
        <p class="font-mono text-xs uppercase tracking-widest text-ink/40 mb-3 text-center lg:text-right">
          What you're juggling now
        </p>
        <div class="flex flex-wrap justify-center lg:justify-end gap-2">
          {scatteredTools.map((tool) => (
            <span class="flow-chip inline-flex items-center gap-1.5 rounded-lg border border-rail bg-rail/10 px-3 py-1.5 text-xs font-medium text-ink/40">
              <X class="w-3 h-3 text-ink/30" stroke-width="2" />
              {tool}
            </span>
          ))}
        </div>
      </div>

      <!-- Divider arrow -->
      <div class="order-2 flex-none flex justify-center rotate-90 lg:rotate-0">
        <ArrowRight class="w-6 h-6 text-blue-600" stroke-width="1.75" />
      </div>

      <!-- After: one connected flow-rail -->
      <div class="order-3 w-full lg:flex-1">
        <p class="font-mono text-xs uppercase tracking-widest text-blue-600 mb-3 text-center lg:text-left">
          What Huzlly runs instead
        </p>

        <!-- Node row: circles sit ON the rail line, per DESIGN_SYSTEM.md
             Section 3/4 flow-rail spec. -->
        <div class="relative grid grid-cols-4 items-center gap-2 sm:gap-4">
          <div class="rail-line pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 h-px sm:h-0.5 bg-gradient-to-r from-blue-600 via-teal-600 to-amber-500" aria-hidden="true"></div>
          <span class="rail-dot pointer-events-none absolute top-1/2 -translate-y-1/2 h-2 w-2 rounded-full bg-blue-600 shadow-sm" aria-hidden="true"></span>
          {flowSteps.map((step) => (
            <span class="flow-chip relative z-10 mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-rail bg-paper text-blue-600 shadow-sm">
              <step.icon class="w-5 h-5" stroke-width="1.75" />
            </span>
          ))}
        </div>

        <!-- Caption row, aligned under each node -->
        <div class="mt-2 grid grid-cols-4 gap-2 sm:gap-4">
          {flowSteps.map((step) => (
            <span class="text-center font-mono text-xs uppercase tracking-widest text-ink/50">{step.label}</span>
          ))}
        </div>
      </div>
    </div>

    <p class="reveal mt-6 text-center lg:text-left text-xs font-medium text-ink/50">
      Tasks, time tracking, and an optional client portal &mdash; all inside the project from here.
    </p>
  </div>
</section>

<style>
  /* Scroll-reveal: elements start hidden, .is-visible fades/lifts them in.
     Falls back to always-visible if JS never runs or motion is reduced. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .flow-chip {
    opacity: 0;
    transform: scale(0.94);
  }
  .flow-chip.is-visible {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .rail-line {
    transform: scaleX(0);
    transform-origin: left;
  }
  .rail-line.is-visible {
    transform: scaleX(1);
    transition: transform 0.5s ease 0.2s;
  }

  /* Rail-dot travel — signature motion, one-shot on hero entrance, per
     DESIGN_SYSTEM.md Section 6 ("Rail-Dot Travel"). Starts after the rail
     line has finished drawing in (0.2s delay + 0.5s transition = 0.7s). */
  .rail-dot {
    left: 0;
    opacity: 0;
  }
  .rail-dot.is-visible {
    animation: rail-travel 650ms ease-in-out 700ms forwards;
  }
  @keyframes rail-travel {
    0% {
      left: 0;
      opacity: 1;
    }
    100% {
      left: calc(100% - 8px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .flow-chip,
    .rail-line {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    /* Skip the travel keyframe entirely — the rail and nodes stay fully
       legible without it, per the mandatory reduced-motion fallback. */
    .rail-dot {
      display: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('.reveal, .flow-chip, .rail-line, .rail-dot');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = el.classList.contains('flow-chip') ? i * 60 : 0;
            setTimeout(() => el.classList.add('is-visible'), delay);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
