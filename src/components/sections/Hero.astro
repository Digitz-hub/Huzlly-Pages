---
// src/components/sections/Hero.astro
// Homepage hero — v7, page-specific inspiration override (CLAUDE.md
// Section 4.5) modeled on a user-supplied reference (Cap.so-style hero):
// soft cloud-blur glow behind centered content, a small pill badge with
// an inline accent link + chevron, a tiny eyebrow line above the
// headline, bold black two-line headline, gray subtext, two CTAs
// (light/outline first, blue-600 filled second), a small note line,
// and a bottom underlined secondary link. No nav — Nav.astro handles
// that separately, this is the hero section only.
//
// Palette: stays on DESIGN_SYSTEM.md's default light ink/paper tokens
// (unlike the v6 dark override) — accent blue-600 fixed as always.
//
// Decorative pattern note: previously a soft organic cloud-blur (layered
// CSS radial-gradient blur circles in an absolutely-positioned -z-10
// div), per the DESIGN_SYSTEM.md Section 7.5 "Abstract Blend Waves"
// entry (page-specific override via CLAUDE.md 4.5, not a sitewide
// default). Replaced this pass with a flat 2-color linear gradient
// applied straight to the <section>'s own background (see color choice
// note below) — no separate decorative div, no blur, no image asset.
//
// GRADIENT COLOR CHOICE (this pass): blue-600 → amber-500, diagonal
// (bg-gradient-to-br), both at low opacity (/10) layered over the base
// bg-paper color so body text and the pill/CTA elements stay legible.
// Blue and amber/orange are the palette's complementary pair (opposite
// warmth, opposite ends of the wheel) — teal-600 sits too close to
// blue-600 on the wheel to read as a second, contrasting anchor. Ink and
// paper are neutrals, not gradient-color candidates. All three
// accent/signal tokens (blue-600, teal-600, amber-500) still appear
// elsewhere in this hero (badge/CTA, card icon backgrounds), so
// blue-600/amber-500 in the backdrop reads as reinforcing the existing
// palette, not introducing new colors.
//
// Floating automation cards + scatter decoration (added this pass):
// four AutomationNotificationCard instances scattered at the hero's
// corners, one per step of the Proposal → Contract → Invoice → Project
// flow (SITE_IDENTITY_AND_AEO.md Section 3), plus a HeroScatterDecoration
// layer (dots + doodle arrows) tying the cards together visually. Both
// components are pre-built/finalized — this file only imports, positions,
// and feeds them data; no markup inside either component was touched.
//
// Stacking order (back to front): gradient backdrop (painted directly on
// the <section>'s own background, no z-index needed) → HeroScatterDecoration
// (-z-[5], baked into that component) → centered headline/subtext/CTA
// content (default stacking) → floating cards (z-10, explicit, so they
// sit above everything else in the hero).
// Cards + decoration are both hidden below `lg` — at narrower widths
// there isn't room around the centered content for four 288–320px cards
// without crowding the headline/CTAs, which the existing hero reserves
// via its sm:/lg: padding scale.
//
// STACKING CONTEXT FIX (earlier pass, still required): the <section>
// below carries `isolate` in addition to `relative`. `position: relative`
// alone does NOT create a stacking context (only relative/absolute + an
// explicit z-index, or `isolate`, does) — so without it, HeroScatterDecoration's
// `-z-[5]` wrapper would escape past the section into the nearest ancestor
// stacking context instead of stacking locally, and paint *before* (i.e.
// underneath) this section's own background — now the gradient described
// above — since the section itself, with z-index:auto, would otherwise
// paint at a later step in that outer context. `isolate` forces this
// section to be its own stacking context, so its background paints first
// *inside* it and the negative-z scatter decoration correctly paints on
// top of that background instead of underneath it. No inline styles used
// — `isolate` is a static Tailwind utility class.
//
// Card data source: SITE_IDENTITY_AND_AEO.md Section 3 end-to-end flow.
// Rotation is passed via `rotationClass` (-rotate-6 / rotate-6 / rotate-3 /
// -rotate-3) — AutomationNotificationCard.astro applies this straight into
// class:list rather than an inline style, so no `style="transform: ..."`
// exists anywhere in the rendered markup. (An earlier pass drove rotation
// through a numeric `rotation` prop + inline style; that was a CLAUDE.md
// Section 3 zero-tolerance violation and has been fixed at the component
// level, with this file updated to pass rotationClass accordingly.)
//
// ⚠️ Flag (per CLAUDE.md Section 3 "stop and flag" rule): the bottom-right
// card's `bg-rose-500` iconBg is not one of DESIGN_SYSTEM.md's three
// approved signal/accent colors (blue-600 / teal-600 / amber-500) or the
// fixed brand accent. It's used here only because it was specified
// verbatim in the task and already flagged as unapproved inside
// AutomationNotificationCard.astro's own header comment — confirm with
// design before shipping, or swap it for one of the three approved tones.

import { ChevronRight, Check, FileText, DollarSign, FolderOpen } from 'lucide-astro';
import AutomationNotificationCard from '../ui/AutomationNotificationCard.astro';
import HeroScatterDecoration from '../ui/HeroScatterDecoration.astro';
---

<section class="relative isolate overflow-hidden bg-paper bg-gradient-to-br from-blue-600/10 to-amber-500/10 px-4 pt-24 pb-28 sm:px-6 sm:pt-32 sm:pb-40 lg:px-8">
  <!-- Scatter decoration — dots + hand-drawn doodle arrows tied to the
       floating cards below. Sits above the cloud-blur backdrop (-z-10)
       and below the centered content, per its own -z-[5]. Hidden below
       `lg` alongside the cards it points at. -->
  <HeroScatterDecoration class="hidden lg:block" />

  <div class="relative mx-auto max-w-2xl text-center">
    <a
      href="/waitlist"
      class="reveal inline-flex items-center gap-1.5 rounded-full border border-rail bg-paper px-4 py-1.5
             text-sm text-ink/70 shadow-sm transition-colors duration-200 ease-in-out hover:border-ink/20"
    >
      Closed beta, cohort 3 &middot; <span class="font-semibold text-blue-600">50 spots left</span>
      <ChevronRight class="w-3.5 h-3.5 text-blue-600" stroke-width="2" />
    </a>

    <p class="reveal mt-6 text-sm text-ink/50">Propose. Sign. Get paid.</p>

    <h1 class="reveal mt-2 font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink leading-[1.1]">
      One flow. Not five apps.
    </h1>

    <p class="reveal mt-6 text-base sm:text-lg text-ink/60 leading-relaxed max-w-xl mx-auto">
      Huzlly is the lean alternative to a pile of freelance tools. Proposals, contracts, invoices,
      and projects &mdash; connected in one automatic flow, built for solo freelancers.
    </p>

    <div class="reveal mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="#how-it-works"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-rail bg-paper px-5 py-2.5
               text-sm font-semibold text-ink shadow-sm transition-colors duration-200 ease-in-out
               hover:bg-rail/20 hover:border-ink/30
               focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        See how it works
      </a>
      <a
        href="/waitlist"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5
               text-sm font-semibold text-white shadow-sm transition-all duration-200 ease-in-out
               hover:bg-blue-700 hover:-translate-y-0.5 hover:shadow-md
               focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      >
        Join the waitlist
      </a>
    </div>

    <p class="reveal mt-4 text-xs text-ink/40">Free to join. No credit card required.</p>

    <a href="/features" class="reveal mt-8 inline-block text-xs text-ink/50 underline underline-offset-4 hover:text-ink/70">
      See what's inside
    </a>
  </div>

  <!-- Floating automation cards — one per corner, one per step of the
       Proposal → Contract → Invoice/Project flow. Absolutely positioned
       via the CLAUDE.md Section 3 decorative-transform exception
       (arbitrary top/left/right/bottom values are allowed here since
       this placement is purely decorative, not content layout). Hidden
       below `lg` so they never crowd the centered headline/CTA column
       on narrower viewports. z-10 keeps them above the cloud-blur
       backdrop and scatter decoration, and above the centered content
       stacking context, matching the "cards scattered around/near the
       content" reference. -->
  <div class="pointer-events-none absolute inset-0 z-10 hidden lg:block" aria-hidden="false">
    <!-- Top-left: Proposal accepted (starts expanded) -->
    <div class="pointer-events-auto absolute left-[2%] top-[6%]">
      <AutomationNotificationCard iconBg="bg-teal-600"
        title="Proposal accepted"
        description="Contract sent to client instantly"
        rotationClass="-rotate-6"
        defaultExpanded={true}
      >
        <Check slot="icon" class="w-4 h-4" stroke-width="2" />
      </AutomationNotificationCard>
    </div>

    <!-- Top-right: Payment received -->
    <div class="pointer-events-auto absolute right-[2%] top-[6%]">
      <AutomationNotificationCard iconBg="bg-amber-500"
        title="Payment received"
        description="Client paid $1,200 for Website Redesign"
        rotationClass="rotate-6"
      >
        <DollarSign slot="icon" class="w-4 h-4" stroke-width="2" />
      </AutomationNotificationCard>
    </div>

    <!-- Bottom-left: Client signed contract -->
    <div class="pointer-events-auto absolute bottom-[6%] left-[2%]">
      <AutomationNotificationCard iconBg="bg-blue-600"
        title="Client signed contract"
        description="Invoice created and sent to client automatically"
        rotationClass="rotate-3"
      >
        <FileText slot="icon" class="w-4 h-4" stroke-width="2" />
      </AutomationNotificationCard>
    </div>

    <!-- Bottom-right: New project created — iconBg flagged above, not
         yet an approved DESIGN_SYSTEM.md accent color; confirm before shipping. -->
    <div class="pointer-events-auto absolute bottom-[6%] right-[2%]">
      <AutomationNotificationCard iconBg="bg-rose-500"
        title="New project created"
        description="Time tracking is now live for this client"
        rotationClass="-rotate-3"
      >
        <FolderOpen slot="icon" class="w-4 h-4" stroke-width="2" />
      </AutomationNotificationCard>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealTargets = document.querySelectorAll('.reveal');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealTargets.forEach((el) => observer.observe(el));
  }
</script>
