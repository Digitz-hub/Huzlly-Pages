---
// src/components/sections/Hero.astro
// Homepage hero. Signature element is the "5 apps -> 1 flow" diagram:
// it makes the core pitch (Huzlly replaces a pile of disconnected tools
// with one connected pipeline) legible at a glance. Real product flow is
// Proposal -> Contract -> Invoice -> Project -> Tasks/Timesheets -> Client
// Portal; condensed to 4 nodes here (Proposal/Contract/Invoice/Project)
// with the tasks/time/portal stages folded into the caption below the
// diagram, since 6 nodes doesn't fit a compact hero diagram legibly.
// NOTE: FAQ.astro's "Product Questions" category now matches this same
// flow — see FLOW_UPDATE_MIGRATION.md for the full migration history.

import { ArrowRight, FileText, PenTool, Receipt, FolderKanban, X } from 'lucide-astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

const scatteredTools = ['Proposal tool', 'E-sign app', 'Invoicing tool', 'Payment processor', 'Form builder'];

const flowSteps = [
  { label: 'Proposal', icon: FileText },
  { label: 'Contract', icon: PenTool },
  { label: 'Invoice', icon: Receipt },
  { label: 'Project', icon: FolderKanban },
];
---

<section class="relative overflow-hidden bg-white px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
  <!-- Ambient accent, sits behind content -->
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 flex justify-center">
    <div class="h-[420px] w-[820px] rounded-full bg-blue-50/70 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-3xl text-center">
    <Badge variant="beta" class="reveal">Closed beta &middot; 50 spots this cohort</Badge>

    <h1 class="reveal mt-6 text-4xl sm:text-6xl font-bold tracking-tight text-gray-900 leading-[1.05]">
      One flow.<br class="hidden sm:block" /> Not five apps.
    </h1>

    <p class="reveal mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto">
      Freelancers stitch proposals, contracts, invoicing, and project setup together across a pile
      of disconnected tools. Huzlly turns that pile into one lean, automatic flow &mdash; built for
      solo freelancers, not agencies paying for seats they don't need.
    </p>

    <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button href="/waitlist" size="lg">
        Join the waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
      <Button href="#how-it-works" variant="outline" size="lg">
        See how it works
      </Button>
    </div>
  </div>

  <!-- Signature: scattered tools collapsing into one connected flow -->
  <div class="reveal mt-16 sm:mt-20 mx-auto max-w-4xl">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-center gap-6 lg:gap-8">
      <!-- Before: scattered apps -->
      <div class="order-1">
        <p class="font-mono text-[11px] uppercase tracking-widest text-gray-400 mb-3 text-center lg:text-right">
          What you're juggling now
        </p>
        <div class="flex flex-wrap justify-center lg:justify-end gap-2">
          {scatteredTools.map((tool) => (
            <span class="flow-chip inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 text-xs font-medium text-gray-500">
              <X class="w-3 h-3 text-gray-400" stroke-width="2" />
              {tool}
            </span>
          ))}
        </div>
      </div>

      <!-- Divider arrow -->
      <div class="order-2 flex justify-center rotate-90 lg:rotate-0">
        <ArrowRight class="w-6 h-6 text-blue-600" stroke-width="1.75" />
      </div>

      <!-- After: one connected flow -->
      <div class="order-3">
        <p class="font-mono text-[11px] uppercase tracking-widest text-blue-600 mb-3 text-center lg:text-left">
          What Huzlly runs instead
        </p>
        <div class="flex items-center justify-center lg:justify-start">
          {flowSteps.map((step, i) => (
            <>
              <div class="flow-chip flex flex-col items-center gap-1.5">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gray-900 text-white shadow-sm">
                  <step.icon class="w-5 h-5" stroke-width="1.75" />
                </span>
                <span class="text-xs font-semibold text-gray-700">{step.label}</span>
              </div>
              {i < flowSteps.length - 1 && (
                <span class="flow-line mx-1.5 sm:mx-2 h-px w-6 sm:w-10 bg-gradient-to-r from-blue-600/70 to-blue-600/20 -mt-5"></span>
              )}
            </>
          ))}
        </div>
      </div>
    </div>

    <p class="reveal mt-6 text-center lg:text-left text-xs font-medium text-gray-400">
      Tasks, time tracking, and an optional client portal &mdash; all inside the project from here.
    </p>
  </div>
</section>

<style>
  /* Scroll-reveal: elements start hidden, .is-visible fades/lifts them in.
     Falls back to always-visible if JS never runs or motion is reduced. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .flow-chip {
    opacity: 0;
    transform: scale(0.94);
  }
  .flow-chip.is-visible {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .flow-line {
    transform: scaleX(0);
    transform-origin: left;
  }
  .flow-line.is-visible {
    transform: scaleX(1);
    transition: transform 0.5s ease 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .flow-chip,
    .flow-line {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('.reveal, .flow-chip, .flow-line');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = el.classList.contains('flow-chip') ? i * 60 : 0;
            setTimeout(() => el.classList.add('is-visible'), delay);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
