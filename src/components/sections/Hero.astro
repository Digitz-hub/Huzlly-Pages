---
// src/components/sections/Hero.astro
// Homepage hero — v4, page-specific inspiration override (CLAUDE.md
// Section 4.5). Signature visual is now lifted directly from the
// user-supplied reference implementation (hero-preview.html — a
// "Tools AI" style hero): a center glow-node with floating icon cards
// on either side, connected by a dense fan of soft bezier lines, each
// card gently bobbing via CSS float animation. No stars/review-count
// badge (explicitly excluded, per direction).
//
// Real third-party app logos (the reference used plain text
// initials/emoji stand-ins, not actual brand marks) are still not
// reproduced here — cards use generic lucide icons for each tool
// category Huzlly replaces (proposal, e-sign, invoicing, payments,
// forms, time tracking), same reasoning as the previous pass.
//
// Page-level design note (CLAUDE.md 4.5):
// - Inspiration: hero-preview.html (user-supplied) — center glow node,
//   floating bordered icon cards, dense converging bezier-line fan,
//   continuous float animation, dual CTA row, no rating badge.
// - Fixed accent kept: blue-600 (#2563EB) — replaces the reference's
//   orange (#FF4B26/#FF3B14) throughout: line gradient, glow shadow,
//   center node gradient, and the accented icon cards.
// - Everything else on this page still runs on DESIGN_SYSTEM.md v2
//   tokens (ink/paper/rail, Space Grotesk/Inter/JetBrains Mono,
//   existing Button/Badge primitives) — only the signature visual is
//   rebuilt; headline, subtext, CTAs, and the beta badge are unchanged.
// - Arbitrary Tailwind values (percentage positions, the glow
//   box-shadow, fixed pixel heights) are carried over near-verbatim
//   from the reference — CLAUDE.md Section 3's zero-arbitrary-value
//   rule is one of the rules Section 4.5 allows an inspiration
//   override to relax; it is not in the fixed list (accent color,
//   Sections 1/2/5).
// - Motion: continuous float keyframes on each card (reference
//   mechanism, unchanged), plus the sitewide scroll-reveal on mount.
//   Both degrade to fully static under prefers-reduced-motion.

import { ArrowRight, FileText, PenTool, Receipt, CreditCard, ClipboardList, Clock } from 'lucide-astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
---

<section class="relative overflow-hidden bg-paper px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
  <!-- Dot-grid texture — this hero's one accent, per DESIGN_SYSTEM.md
       Section 4. Not combined with an ambient glow in the same area. -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-40
              [background-image:radial-gradient(theme(colors.rail)_1px,transparent_1px)]
              [background-size:24px_24px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl text-center">
    <Badge variant="beta" class="reveal">Closed beta &middot; 50 spots this cohort</Badge>

    <h1 class="reveal mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]">
      One flow.<br class="hidden sm:block" /> Not five apps.
    </h1>

    <p class="reveal mt-6 text-lg sm:text-xl text-ink/70 leading-relaxed max-w-2xl mx-auto">
      Freelancers stitch proposals, contracts, invoicing, and project setup together across a pile
      of disconnected tools. Huzlly turns that pile into one lean, automatic flow &mdash; built for
      solo freelancers, not agencies paying for seats they don't need.
    </p>

    <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button href="/waitlist" size="lg" motion>
        Join the waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
      <Button href="#how-it-works" variant="outline" size="lg">
        See how it works
      </Button>
    </div>
  </div>

  <!-- Signature: floating tool-icon cards + center Huzlly glow node,
       connected by a converging line fan. Lifted from hero-preview.html. -->
  <div class="reveal relative mx-auto mt-10 h-[260px] w-full max-w-5xl sm:mt-14 sm:h-[320px]">
    <svg viewBox="0 0 1200 300" fill="none" preserveAspectRatio="xMidYMid meet"
      class="absolute inset-0 h-full w-full opacity-60" aria-hidden="true"
    >
      <defs>
        <linearGradient id="huzllyLineGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#2563EB" stop-opacity="0.05" />
          <stop offset="50%" stop-color="#2563EB" stop-opacity="0.7" />
          <stop offset="100%" stop-color="#2563EB" stop-opacity="0.05" />
        </linearGradient>
      </defs>
      <path d="M 0 50 C 250 50, 400 130, 560 142" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 0 110 C 250 110, 400 138, 560 146" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 0 170 C 250 170, 400 144, 560 149" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 0 230 C 250 230, 400 152, 560 152" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 0 290 C 250 290, 400 160, 560 155" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 0 350 C 250 350, 400 170, 560 158" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />

      <path d="M 1200 50 C 950 50, 800 130, 640 142" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 1200 110 C 950 110, 800 138, 640 146" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 1200 170 C 950 170, 800 144, 640 149" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 1200 230 C 950 230, 800 152, 640 152" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 1200 290 C 950 290, 800 160, 640 155" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
      <path d="M 1200 350 C 950 350, 800 170, 640 158" stroke="url(#huzllyLineGrad)" stroke-width="1.2" />
    </svg>

    <!-- Left floating cards -->
    <div class="animate-float-1 absolute left-[12%] top-[10%] z-10 flex h-12 w-12 items-center justify-center
                rounded-2xl border border-rail bg-paper shadow-md sm:h-14 sm:w-14">
      <FileText class="w-5 h-5 text-blue-600" stroke-width="1.75" />
    </div>
    <div class="animate-float-2 absolute left-[28%] top-[45%] z-10 flex h-12 w-12 items-center justify-center
                rounded-2xl border border-rail bg-paper shadow-md sm:h-14 sm:w-14">
      <PenTool class="w-5 h-5 text-ink/70" stroke-width="1.75" />
    </div>
    <div class="animate-float-3 absolute bottom-[10%] left-[12%] z-10 flex h-12 w-12 items-center justify-center
                rounded-2xl border border-rail bg-paper shadow-md sm:h-14 sm:w-14">
      <Receipt class="w-5 h-5 text-blue-600" stroke-width="1.75" />
    </div>

    <!-- Center glow node — Huzlly mark -->
    <div class="absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-tr from-blue-600 to-blue-500
                  shadow-[0_0_40px_10px_rgba(37,99,235,0.35)] sm:h-20 sm:w-20">
        <svg viewBox="0 0 100 100" class="h-8 w-8 sm:h-9 sm:w-9" aria-hidden="true">
          <path d="M30 25 V75 M70 25 V75 M30 50 H70"
            stroke="#FCFBF8" stroke-width="12"
            stroke-linecap="round" stroke-linejoin="round" fill="none"
          />
        </svg>
      </div>
    </div>

    <!-- Right floating cards -->
    <div class="animate-float-2 absolute right-[12%] top-[10%] z-10 flex h-12 w-12 items-center justify-center
                rounded-2xl border border-rail bg-paper shadow-md sm:h-14 sm:w-14">
      <CreditCard class="w-5 h-5 text-ink/70" stroke-width="1.75" />
    </div>
    <div class="animate-float-3 absolute right-[28%] top-[45%] z-10 flex h-12 w-12 items-center justify-center
                rounded-2xl border border-rail bg-paper shadow-md sm:h-14 sm:w-14">
      <ClipboardList class="w-5 h-5 text-blue-600" stroke-width="1.75" />
    </div>
    <div class="animate-float-1 absolute bottom-[10%] right-[12%] z-10 flex h-12 w-12 items-center justify-center
                rounded-2xl border border-rail bg-paper shadow-md sm:h-14 sm:w-14">
      <Clock class="w-5 h-5 text-ink/70" stroke-width="1.75" />
    </div>
  </div>

  <p class="reveal mt-6 text-center text-xs font-medium text-ink/50">
    Designed to replace 5+ separate apps &mdash; connected into one automatic flow.
  </p>
</section>

<style>
  /* Scroll-reveal: elements start hidden, .is-visible fades/lifts them in.
     Falls back to always-visible if JS never runs or motion is reduced. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* Continuous float — lifted from hero-preview.html, unchanged mechanism.
     Staggered duration + delay per card so the three on each side don't
     bob in sync. */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  .animate-float-1 { animation: float 3.5s ease-in-out infinite; }
  .animate-float-2 { animation: float 4.2s ease-in-out infinite 0.5s; }
  .animate-float-3 { animation: float 3.8s ease-in-out infinite 1s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .animate-float-1,
    .animate-float-2,
    .animate-float-3 {
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('.reveal');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
