---
// src/components/sections/Hero.astro
// Homepage hero — v3, page-specific inspiration override (CLAUDE.md
// Section 4.5). Signature element replaces the old two-column
// "scattered chips -> flow-rail" layout with a single hub-and-spoke
// "merge" diagram: six tool-category nodes fan into a central Huzlly
// mark, echoing the reference inspiration (converging lines into a
// central brand hub). Real third-party app logos (Figma/Notion/Slack
// etc., as shown in the reference) are intentionally NOT reproduced —
// those are trademarked assets. Instead each node uses a generic
// lucide icon representing the *category* of tool it replaces
// (proposal, e-sign, invoicing, payments, forms, time tracking),
// consistent with the site's existing "replaces 5+ apps" positioning.
// No stars/review-count badge from the reference is included, per
// explicit direction.
//
// Page-level design note (CLAUDE.md 4.5):
// - Inspiration: light-mode SaaS hero with a hub-and-spoke "apps merge
//   into one tool" visual + dual CTA row + no rating badge.
// - Fixed accent kept: blue-600 (#2563EB), used for the hub mark and
//   the tier-1 (nearest) line/icon pair.
// - Everything else on this page still runs on DESIGN_SYSTEM.md v2
//   tokens (ink/paper/rail, Space Grotesk/Inter/JetBrains Mono,
//   existing Button/Badge primitives) — only the signature visual is
//   rebuilt; headline, subtext, CTAs, and the beta badge are unchanged.
// - Diagram-only accents: signal teal (#0D9488) and signal amber
//   (#F59E0B), per DESIGN_SYSTEM.md Section 1 ("diagram/illustration
//   use only"), color-code the three line tiers so the fan reads as a
//   real multi-stage system rather than one flat line color.
// - Motion: lines draw in via stroke-dasharray (approved technique,
//   DESIGN_SYSTEM.md 7.5 "Curved connector/rail lines"), nodes fade in
//   staggered; both degrade to a static reduced-motion fallback.

import { ArrowRight, FileText, PenTool, Receipt, CreditCard, ClipboardList, Clock } from 'lucide-astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

// Tier -> full, literal Tailwind class strings. Kept as complete static
// strings (not `text-${tier}-600` interpolation) so Tailwind's scanner
// can find them in the source text — an interpolated template would be
// invisible to the scanner and get purged from the build.
const tierIconClass: Record<string, string> = {
  blue: 'w-6 h-6 text-blue-600',
  teal: 'w-6 h-6 text-teal-600',
  amber: 'w-6 h-6 text-amber-500',
};
const tierHex: Record<string, string> = {
  blue: '#2563EB',
  teal: '#0D9488',
  amber: '#F59E0B',
};

const hub = { x: 400, y: 322 };

const nodesLeft = [
  { id: 'l1', x: 110, y: 258, icon: FileText, tier: 'blue', label: 'Proposal tool' },
  { id: 'l2', x: 168, y: 150, icon: PenTool, tier: 'teal', label: 'E-sign app' },
  { id: 'l3', x: 272, y: 74, icon: Receipt, tier: 'amber', label: 'Invoicing tool' },
];
const nodesRight = [
  { id: 'r1', x: 690, y: 258, icon: CreditCard, tier: 'blue', label: 'Payment processor' },
  { id: 'r2', x: 632, y: 150, icon: ClipboardList, tier: 'teal', label: 'Form builder' },
  { id: 'r3', x: 528, y: 74, icon: Clock, tier: 'amber', label: 'Time tracker' },
];
const allNodes = [...nodesLeft, ...nodesRight];
---

<section class="relative overflow-hidden bg-paper px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
  <!-- Dot-grid texture — this hero's one accent, per DESIGN_SYSTEM.md
       Section 4. Not combined with an ambient glow in the same area. -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-40
              [background-image:radial-gradient(theme(colors.rail)_1px,transparent_1px)]
              [background-size:24px_24px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl text-center">
    <Badge variant="beta" class="reveal">Closed beta &middot; 50 spots this cohort</Badge>

    <h1 class="reveal mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]">
      One flow.<br class="hidden sm:block" /> Not five apps.
    </h1>

    <p class="reveal mt-6 text-lg sm:text-xl text-ink/70 leading-relaxed max-w-2xl mx-auto">
      Freelancers stitch proposals, contracts, invoicing, and project setup together across a pile
      of disconnected tools. Huzlly turns that pile into one lean, automatic flow &mdash; built for
      solo freelancers, not agencies paying for seats they don't need.
    </p>

    <div class="reveal mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button href="/waitlist" size="lg" motion>
        Join the waitlist
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
      <Button href="#how-it-works" variant="outline" size="lg">
        See how it works
      </Button>
    </div>
  </div>

  <!-- Signature: six tool-category nodes fan into a central Huzlly hub -->
  <div class="reveal mt-16 sm:mt-20 mx-auto max-w-4xl">
    <svg viewBox="0 0 800 380" class="w-full h-auto" aria-hidden="true">
      <defs>
        {allNodes.map((node) => (
          <linearGradient id={`line-${node.id}`}
            x1={node.x} y1={node.y} x2={hub.x} y2={hub.y}
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0%" stop-color="#E4E0D8" stop-opacity="0.5" />
            <stop offset="100%" stop-color={tierHex[node.tier]} stop-opacity="0.9" />
          </linearGradient>
        ))}
      </defs>

      {allNodes.map((node) => (
        <path class="connector-line"
          d={`M${node.x},${node.y} L${hub.x},${hub.y}`}
          stroke={`url(#line-${node.id})`}
          stroke-width="1.5"
          fill="none"
          pathLength="1"
        />
      ))}

      <!-- Central Huzlly hub -->
      <g class="flow-chip">
        <circle cx={hub.x} cy={hub.y} r="48" fill="#FCFBF8" />
        <circle cx={hub.x} cy={hub.y} r="40" fill="#14110F" stroke="#E4E0D8" stroke-width="1" />
        <g transform={`translate(${hub.x - 24}, ${hub.y - 24}) scale(0.48)`}>
          <path d="M30 25 V75 M70 25 V75 M30 50 H70"
            stroke="#2563EB" stroke-width="12"
            stroke-linecap="round" stroke-linejoin="round" fill="none"
          />
        </g>
      </g>

      <!-- Six tool nodes -->
      {allNodes.map((node) => {
        const Icon = node.icon;
        return (
          <g class="flow-chip">
            <circle cx={node.x} cy={node.y} r="32" fill="#FCFBF8" />
            <circle cx={node.x} cy={node.y} r="28" fill="#FCFBF8" stroke="#E4E0D8" stroke-width="1.5" />
            <foreignObject x={node.x - 28} y={node.y - 28} width="56" height="56">
              <div xmlns="http://www.w3.org/1999/xhtml" class="flex h-full w-full items-center justify-center">
                <Icon class={tierIconClass[node.tier]} stroke-width="1.75" />
              </div>
            </foreignObject>
          </g>
        );
      })}
    </svg>

    <p class="reveal mt-6 text-center text-xs font-medium text-ink/50">
      Designed to replace 5+ separate apps &mdash; connected into one automatic flow.
    </p>
  </div>
</section>

<style>
  /* Scroll-reveal: elements start hidden, .is-visible fades/lifts them in.
     Falls back to always-visible if JS never runs or motion is reduced. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* Node/hub fade-in — opacity only (no scale/transform) since these are
     SVG <g> elements containing <foreignObject>; avoiding CSS transform
     here sidesteps fill-box/transform-origin inconsistencies across
     browsers for foreignObject bounding boxes. */
  .flow-chip {
    opacity: 0;
  }
  .flow-chip.is-visible {
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  /* Connector-line draw-in — DESIGN_SYSTEM.md 7.5 approved technique:
     plain SVG <path> with a pathLength-normalized dasharray/dashoffset
     draw animation, reusing the existing IntersectionObserver pattern. */
  .connector-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .connector-line.is-visible {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.7s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .flow-chip,
    .connector-line {
      opacity: 1 !important;
      transform: none !important;
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('.reveal, .flow-chip, .connector-line');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            let delay = 0;
            if (el.classList.contains('connector-line')) delay = i * 50;
            if (el.classList.contains('flow-chip')) delay = 300 + i * 60;
            setTimeout(() => el.classList.add('is-visible'), delay);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
