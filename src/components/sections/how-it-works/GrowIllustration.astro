---
// src/components/sections/how-it-works/GrowIllustration.astro
// Ported from reference mockup: card-4-client-directory.html
---

<!--
  Mobile-only (below sm) width fix: the card used to be capped at max-w-[480px] and
  uniformly scaled 0.8x on every breakpoint, which left empty space on the left/right
  on phones (where the container is already narrower than 480px). A later attempt to
  fix this applied a NON-UNIFORM scale on mobile (scale-x-100 scale-y-[0.8]) to get
  full width without changing the fixed mobile box height, but that stretched the
  card's content horizontally while compressing it vertically, causing a distorted
  look. Below sm, the card is no longer scaled at all: the max-width cap is dropped
  (see max-w override below) so the card's own w-full/h-full naturally fills the
  fixed-height outer box at its true, undistorted proportions — no transform is
  applied at this breakpoint. From sm upward, both axes go back to the original
  uniform 0.8 scale (sm:scale-x-[0.8] sm:scale-y-[0.8]), so sm/lg behavior is
  untouched.

  Desktop (lg) sizing note: the outer "relative" box in HowItWorks.astro is now sized,
  at lg only, to the ACTUAL VISIBLE size of this card after the 0.8 scale below
  (24rem x 28.8rem = 480px x 36rem, each times 0.8). To make that possible, this
  canvas is given fixed lg-only dimensions matching the PRE-scale size (30rem x 36rem,
  i.e. 480px x 576px — unchanged from before) instead of stretching to fill its parent
  via inset-0, and is anchored/scaled from the top-left corner (origin-top-left) so it
  scales down to exactly fill the smaller lg box with no leftover space. Mobile/sm keep
  the original inset-0 + origin-top (top center) behavior untouched.
-->
<div
  class="absolute inset-0 lg:inset-auto lg:top-0 lg:left-0 lg:h-[36rem] lg:w-[30rem] flex items-start justify-center p-3 sm:p-4 origin-top lg:origin-top-left sm:scale-x-[0.8] sm:scale-y-[0.8]"
>
  <div
    class="hiw-card4-card flex h-full w-full sm:max-w-[480px] flex-col overflow-y-auto rounded-2xl border border-slate-200 bg-white p-6 transition-[box-shadow,transform] duration-300 ease-out"
  >
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-2.5">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px] bg-electric/10">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-electric">
            <path d="M17 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 5 18.5V20"/>
            <circle cx="9.5" cy="8" r="3.25"/>
            <path d="M16 8.2a3 3 0 1 1 2.4 5.4"/>
            <path d="M19 20v-1.3a3.3 3.3 0 0 0-1.9-3"/>
          </svg>
        </span>
        <span class="font-display text-[15px] font-semibold tracking-[-0.01em] text-slate-900">Client relationships</span>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-electric/20 bg-electric/10 py-[5px] pl-2.5 pr-3 text-[11.5px] font-semibold text-electric">
        <span class="hiw-card4-pill-dot"></span>
        Directory &amp; history
      </span>
    </div>

    <!-- Body -->
    <div class="flex flex-col gap-5">
      <!-- Section A: client directory selector -->
      <div>
        <div class="flex flex-wrap gap-2" id="hiwC4ClientStrip" role="tablist" aria-label="Select a client">
          <button
            type="button"
            class="hiw-card4-client-pill is-active inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-2 font-sans text-[12.5px] font-semibold tracking-[-0.005em] text-slate-500"
            data-client="acme"
            role="tab"
            aria-selected="true"
          >
            <svg class="hiw-card4-check h-[13px] w-[13px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Acme Corp
          </button>
          <button
            type="button"
            class="hiw-card4-client-pill inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-2 font-sans text-[12.5px] font-semibold tracking-[-0.005em] text-slate-500"
            data-client="nexus"
            role="tab"
            aria-selected="false"
          >
            <svg class="hiw-card4-check h-[13px] w-[13px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Nexus Labs
          </button>
          <button
            type="button"
            class="hiw-card4-client-pill inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-2 font-sans text-[12.5px] font-semibold tracking-[-0.005em] text-slate-500"
            data-client="loomis"
            role="tab"
            aria-selected="false"
          >
            <svg class="hiw-card4-check h-[13px] w-[13px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Loomis Co.
          </button>
        </div>
      </div>

      <!-- Section B: selected client context -->
      <div class="flex flex-col gap-2.5 rounded-[14px] border border-slate-200 bg-[#FBFCFE] py-3.5 px-4" id="hiwC4ContextBox" aria-live="polite">
        <div class="flex items-center gap-2.5">
          <div
            class="hiw-card4-avatar flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-gradient-to-br from-slate-900 to-slate-700 font-sans text-[12px] font-semibold tracking-[-0.02em] text-white"
            id="hiwC4CtxAvatar"
          >
            AC
          </div>
          <div class="flex min-w-0 flex-col gap-0.5">
            <span class="text-[14px] font-semibold tracking-[-0.01em] text-slate-900" id="hiwC4CtxName">Acme Corp</span>
            <span class="text-[12px] text-slate-500" id="hiwC4CtxProjects">2 completed projects</span>
          </div>
        </div>

        <div class="text-[12.5px] leading-relaxed text-slate-500">
          <span class="font-sans text-[12px] font-semibold tabular-nums text-slate-900" id="hiwC4CtxBilled">$9,600</span> total billed &middot; <span id="hiwC4CtxTerms">Standard Net-15 terms on file</span>
        </div>
      </div>

      <!-- Section C: next step action -->
      <div class="flex flex-col gap-2.5">
        <div class="hiw-card4-action-strip flex items-center gap-3 rounded-xl border border-electric/[0.18] bg-electric/10 py-3 px-[13px]">
          <div class="hiw-card4-action-icon flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-[9px] border border-electric/20 bg-white text-electric">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" class="h-3.5 w-3.5">
              <path d="M13 2 3 14h7l-1 8 11-14h-8l1-6z"/>
            </svg>
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <div class="truncate text-[13px] font-semibold tracking-[-0.005em] text-slate-900">New Scope &middot; Retainer / Phase 2</div>
            <div class="text-[11.5px] leading-snug text-slate-500" id="hiwC4CtxActionSub">Start next project with Acme &mdash; pre-filled details &amp; rates</div>
          </div>
          <button
            type="button"
            class="hiw-card4-draft-btn inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-[9px] border border-electric bg-electric px-3.5 py-2.5 font-sans text-[12px] font-semibold text-white"
            id="hiwC4DraftBtn"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-[13px] w-[13px] shrink-0">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Draft proposal
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-auto shrink-0 border-t border-[#EDF1F5] pt-4">
      <p class="text-[12.5px] leading-relaxed text-slate-500">Client preferences, history, and payment terms saved for seamless repeat work.</p>
    </div>
  </div>
</div>

<style>
  .hiw-card4-card {
    max-height: 100%;
  }

  .hiw-card4-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3B4EFF;
    flex-shrink: 0;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(59, 78, 255, 0.15);
  }

  /* Client selector pills */
  .hiw-card4-client-pill {
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease, transform 0.15s ease;
  }

  .hiw-card4-client-pill:hover {
    border-color: #cbd5e1;
    background: #fafbfc;
    transform: translateY(-1px);
  }

  .hiw-card4-client-pill:active {
    transform: translateY(0) scale(0.98);
  }

  .hiw-card4-client-pill.is-active {
    border-color: rgba(59, 78, 255, 0.35);
    background: #EEF0FF;
    color: #2A3ACC;
  }

  .hiw-card4-check {
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .hiw-card4-client-pill.is-active .hiw-card4-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Selected-client context avatar recolors on switch */
  .hiw-card4-avatar {
    transition: background 0.2s ease;
  }

  /* Next-step action strip */
  .hiw-card4-action-strip {
    transition: border-color 0.2s ease;
  }
  .hiw-card4-action-strip:hover {
    border-color: rgba(59, 78, 255, 0.32);
  }

  .hiw-card4-draft-btn {
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(59, 78, 255, 0.15);
    transition: background 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease;
  }
  .hiw-card4-draft-btn:hover {
    background: #2A3ACC;
    border-color: #2A3ACC;
    box-shadow: 0 4px 10px -2px rgba(59, 78, 255, 0.4);
    transform: translateY(-1px);
  }
  .hiw-card4-draft-btn:active {
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(59, 78, 255, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-card4-card,
    .hiw-card4-client-pill,
    .hiw-card4-check,
    .hiw-card4-avatar,
    .hiw-card4-action-strip,
    .hiw-card4-draft-btn {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    type ClientKey = 'acme' | 'nexus' | 'loomis';

    interface ClientInfo {
      name: string;
      avatar: string;
      projects: string;
      billed: string;
      terms: string;
    }

    const clients: Record<ClientKey, ClientInfo> = {
      acme: {
        name: 'Acme Corp',
        avatar: 'AC',
        projects: '2 completed projects',
        billed: '$9,600',
        terms: 'Standard Net-15 terms on file',
      },
      nexus: {
        name: 'Nexus Labs',
        avatar: 'NL',
        projects: '1 completed project',
        billed: '$3,200',
        terms: 'Net-30 terms on file',
      },
      loomis: {
        name: 'Loomis Co.',
        avatar: 'LC',
        projects: '3 completed projects',
        billed: '$14,750',
        terms: 'Standard Net-15 terms on file',
      },
    };

    const strip = document.getElementById('hiwC4ClientStrip');
    const ctxAvatar = document.getElementById('hiwC4CtxAvatar');
    const ctxName = document.getElementById('hiwC4CtxName');
    const ctxProjects = document.getElementById('hiwC4CtxProjects');
    const ctxBilled = document.getElementById('hiwC4CtxBilled');
    const ctxTerms = document.getElementById('hiwC4CtxTerms');
    const ctxActionSub = document.getElementById('hiwC4CtxActionSub');
    const draftBtn = document.getElementById('hiwC4DraftBtn');

    if (
      strip &&
      ctxAvatar &&
      ctxName &&
      ctxProjects &&
      ctxBilled &&
      ctxTerms &&
      ctxActionSub
    ) {
      const pills = Array.from(strip.querySelectorAll<HTMLButtonElement>('.hiw-card4-client-pill'));

      const selectClient = (key: string) => {
        const client = clients[key as ClientKey];
        if (!client) return;

        pills.forEach((pill) => {
          const active = pill.getAttribute('data-client') === key;
          pill.classList.toggle('is-active', active);
          pill.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        ctxAvatar.textContent = client.avatar;
        ctxName.textContent = client.name;
        ctxProjects.textContent = client.projects;
        ctxBilled.textContent = client.billed;
        ctxTerms.textContent = client.terms;
        ctxActionSub.textContent = 'Start next project with ' + client.name.split(' ')[0] + ' — pre-filled details & rates';
      };

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const key = pill.getAttribute('data-client');
          if (key) selectClient(key);
        });
      });
    }

    draftBtn?.addEventListener('click', () => {
      draftBtn.blur();
    });
  })();
</script>
