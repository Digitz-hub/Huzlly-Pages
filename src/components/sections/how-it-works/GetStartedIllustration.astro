---
// src/components/sections/how-it-works/GetStartedIllustration.astro
// Ported from reference mockup: card-1-workflow-onboarding.html
---

<!--
  Mobile-only (below sm) width fix: the card used to be capped at max-w-[480px] and
  uniformly scaled 0.8x on every breakpoint, which left empty space on the left/right
  on phones (where the container is already narrower than 480px). A later attempt to
  fix this applied a NON-UNIFORM scale on mobile (scale-x-100 scale-y-[0.8]) to get
  full width without changing the fixed mobile box height, but that stretched the
  card's content horizontally while compressing it vertically, causing a distorted
  look. Below sm, the card is no longer scaled at all: the max-width cap is dropped
  (see max-w override below) so the card's own w-full/h-full naturally fills the
  fixed-height outer box at its true, undistorted proportions — no transform is
  applied at this breakpoint. From sm upward, both axes go back to the original
  uniform 0.8 scale (sm:scale-x-[0.8] sm:scale-y-[0.8]), so sm/lg behavior is
  untouched.

  Desktop (lg) sizing note: the outer "relative" box in HowItWorks.astro is now sized,
  at lg only, to the ACTUAL VISIBLE size of this card after the 0.8 scale below
  (24rem x 28.8rem = 480px x 36rem, each times 0.8). To make that possible, this
  canvas is given fixed lg-only dimensions matching the PRE-scale size (30rem x 36rem,
  i.e. 480px x 576px — unchanged from before) instead of stretching to fill its parent
  via inset-0, and is anchored/scaled from the top-left corner (origin-top-left) so it
  scales down to exactly fill the smaller lg box with no leftover space. Mobile/sm keep
  the original inset-0 + origin-top (top center) behavior untouched.
-->
<div
  class="absolute inset-0 lg:inset-auto lg:top-0 lg:left-0 lg:h-[36rem] lg:w-[30rem] flex items-start justify-center p-3 sm:p-4 origin-top lg:origin-top-left sm:scale-x-[0.8] sm:scale-y-[0.8]"
>
  <div
    class="hiw-card1-flow-card flex h-full w-full sm:max-w-[480px] flex-col overflow-y-auto rounded-2xl border border-slate-200 bg-white p-6 transition-[box-shadow,transform] duration-300 ease-out"
    tabindex="0"
  >
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between gap-3">
      <span class="font-display text-[15px] font-semibold tracking-[-0.01em] text-slate-900">Client onboarding</span>
      <span class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-electric/20 bg-electric/10 py-[5px] pl-2.5 pr-3 text-[11.5px] font-semibold text-electric">
        Auto-converted
      </span>
    </div>

    <!-- Workflow -->
    <div class="hiw-card1-workflow relative flex flex-col" id="hiwC1Workflow">
      <div class="hiw-card1-track-line" id="hiwC1TrackLine"></div>
      <div class="hiw-card1-track-dot" id="hiwC1TrackDot"></div>

      <!-- Node 1: Proposal -->
      <div class="relative z-[2] flex gap-4">
        <div class="flex shrink-0 flex-col items-center pt-px">
          <div class="hiw-card1-marker" id="hiwC1Marker1" aria-hidden="true">
            <svg class="hiw-card1-check-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>
        <div class="min-w-0 flex-1 pb-[26px]">
          <div class="text-[13.5px] font-semibold leading-snug tracking-[-0.005em] text-slate-900">Brand Redesign Proposal</div>
          <div class="mt-[3px] text-[12.5px] leading-relaxed text-slate-500">
            <span class="font-sans tabular-nums text-[12.5px] text-slate-500">$4,800</span> · Accepted by client
          </div>
        </div>
      </div>

      <!-- Node 2: Contract -->
      <div class="relative z-[2] flex gap-4">
        <div class="flex shrink-0 flex-col items-center pt-px">
          <div class="hiw-card1-marker" id="hiwC1Marker2" aria-hidden="true">
            <svg class="hiw-card1-check-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>
        <div class="min-w-0 flex-1 pb-[26px]">
          <div class="text-[13.5px] font-semibold leading-snug tracking-[-0.005em] text-slate-900">Services Agreement</div>
          <div class="mt-[3px] text-[12.5px] leading-relaxed text-slate-500">Signed · e-signature captured</div>
        </div>
      </div>

      <!-- Node 3: Project Workspace -->
      <div class="relative z-[2] flex gap-4">
        <div class="flex shrink-0 flex-col items-center pt-px">
          <div class="hiw-card1-marker" id="hiwC1Marker3" aria-hidden="true">
            <span class="hiw-card1-pulse-core"></span>
          </div>
        </div>
        <div class="min-w-0 flex-1 pb-0.5">
          <div class="text-[13.5px] font-semibold leading-snug tracking-[-0.005em] text-slate-900">Acme Corp Workspace</div>
          <div class="mt-[3px] text-[12.5px] leading-relaxed text-slate-500">Active · milestones &amp; billing ready</div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-auto shrink-0 border-t border-[#EDF1F5] pt-4">
      <p class="text-[12.5px] leading-relaxed text-slate-500">One seamless flow, zero manual back-and-forth.</p>
    </div>
  </div>
</div>

<style>
  .hiw-card1-flow-card {
    max-height: 100%;
  }

  /* Single continuous track spanning node1 -> node3 marker centers. */
  .hiw-card1-track-line {
    position: absolute;
    width: 2px;
    background: #e2e8f0;
    z-index: 1;
    top: 0;
    height: 0;
    left: 0;
  }

  /* The single traveling glowing dot. */
  .hiw-card1-track-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3B4EFF;
    box-shadow: 0 0 8px rgba(59, 78, 255, 0.6), 0 0 2px rgba(59, 78, 255, 0.9);
    z-index: 2;
    opacity: 0;
    top: 0;
    left: 0;
    transition: top 2.2s cubic-bezier(0.45, 0, 0.55, 1), opacity 0.3s ease;
  }

  .hiw-card1-marker {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    color: transparent;
    position: relative;
    z-index: 2;
    transition: background 0.45s ease, border-color 0.45s ease;
  }

  .hiw-card1-check-icon {
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .hiw-card1-marker.is-check {
    background: #3B4EFF;
    border-color: #3B4EFF;
    color: #fff;
  }
  .hiw-card1-marker.is-check .hiw-card1-check-icon {
    opacity: 1;
    transform: scale(1);
  }

  .hiw-card1-marker.is-active {
    background: #ffffff;
    border-color: #3B4EFF;
  }

  .hiw-card1-pulse-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3B4EFF;
    position: relative;
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .hiw-card1-marker.is-active .hiw-card1-pulse-core {
    opacity: 1;
    transform: scale(1);
  }
  .hiw-card1-marker.is-active .hiw-card1-pulse-core::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: rgba(59, 78, 255, 0.3);
    animation: hiw-card1-pulse-ring 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes hiw-card1-pulse-ring {
    0% {
      transform: scale(0.5);
      opacity: 0.9;
    }
    75% {
      transform: scale(2);
      opacity: 0;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-card1-flow-card,
    .hiw-card1-track-dot,
    .hiw-card1-marker,
    .hiw-card1-check-icon,
    .hiw-card1-pulse-core,
    .hiw-card1-pulse-core::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  (function () {
    const workflow = document.getElementById('hiwC1Workflow');
    const trackLine = document.getElementById('hiwC1TrackLine');
    const trackDot = document.getElementById('hiwC1TrackDot');
    const marker1 = document.getElementById('hiwC1Marker1');
    const marker2 = document.getElementById('hiwC1Marker2');
    const marker3 = document.getElementById('hiwC1Marker3');

    if (!workflow || !trackLine || !trackDot || !marker1 || !marker2 || !marker3) return;

    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const pos = { x: 0, y1: 0, y2: 0, y3: 0 };

    function sleep(ms: number) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    // Computes an element's cumulative offset (top/left) relative to a
    // given ancestor by walking up the offsetParent chain and summing
    // offsetTop/offsetLeft at each step. Unlike getBoundingClientRect(),
    // these values live in each ancestor's own untransformed local layout
    // space, so they aren't affected by CSS transforms (e.g. scale()) on
    // any ancestor between el and ancestor.
    function offsetRelativeTo(el: HTMLElement, ancestor: HTMLElement) {
      let top = 0, left = 0;
      let node: HTMLElement | null = el;
      while (node && node !== ancestor) {
        top += node.offsetTop;
        left += node.offsetLeft;
        node = node.offsetParent as HTMLElement | null;
      }
      return { top, left };
    }

    function measure() {
      const o1 = offsetRelativeTo(marker1!, workflow!);
      const o2 = offsetRelativeTo(marker2!, workflow!);
      const o3 = offsetRelativeTo(marker3!, workflow!);

      const centerX = o1.left + marker1!.offsetWidth / 2;
      pos.x = centerX;
      pos.y1 = o1.top + marker1!.offsetHeight / 2;
      pos.y2 = o2.top + marker2!.offsetHeight / 2;
      pos.y3 = o3.top + marker3!.offsetHeight / 2;

      trackLine!.style.left = centerX - 1 + 'px';
      trackLine!.style.top = pos.y1 + 'px';
      trackLine!.style.height = pos.y3 - pos.y1 + 'px';

      trackDot!.style.left = centerX - 3 + 'px';
    }

    function resetMarkers() {
      marker1!.classList.remove('is-check', 'is-active');
      marker2!.classList.remove('is-check', 'is-active');
      marker3!.classList.remove('is-active', 'is-check');
    }

    function setDot(top: number, transitionOverride?: string) {
      trackDot!.style.transition = transitionOverride || 'top 2.2s cubic-bezier(.45,0,.55,1), opacity 0.3s ease';
      trackDot!.style.top = top + 'px';
    }

    async function runLoop() {
      measure();

      while (true) {
        // Phase: reset / idle — dot parked at node 1, hidden
        resetMarkers();
        setDot(pos.y1, 'top 0s, opacity 0.3s ease');
        trackDot!.style.opacity = '0';
        // force reflow so the next state change animates cleanly
        void trackDot!.offsetHeight;

        await sleep(300);

        // Phase 0: Node 1 lights up (accepted)
        marker1!.classList.add('is-check');
        trackDot!.style.opacity = '1';
        await sleep(450);

        // Phase 1: travel node1 -> node2
        setDot(pos.y2);
        await sleep(2200);

        // Phase 2: Node 2 lights up (signed)
        marker2!.classList.add('is-check');
        await sleep(450);

        // Phase 3: travel node2 -> node3
        setDot(pos.y3);
        await sleep(2200);

        // Phase 4: Node 3 unlocks (active, pulsing)
        marker3!.classList.add('is-active');
        trackDot!.style.transition = 'opacity 0.3s ease';
        trackDot!.style.opacity = '0';

        // Phase 5: hold completed pipeline, then loop
        await sleep(1500);
      }
    }

    function staticFinalState() {
      measure();
      marker1!.classList.add('is-check');
      marker2!.classList.add('is-check');
      marker3!.classList.add('is-active');
      trackDot!.style.opacity = '0';
    }

    window.addEventListener('resize', measure);
    window.addEventListener('load', () => {
      if (reduceMotion) {
        staticFinalState();
      } else {
        runLoop();
      }
    });

    if (document.readyState === 'complete') {
      if (reduceMotion) {
        staticFinalState();
      } else {
        runLoop();
      }
    }
  })();
</script>
