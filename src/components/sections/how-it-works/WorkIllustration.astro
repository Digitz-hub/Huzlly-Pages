---
// src/components/sections/how-it-works/WorkIllustration.astro
// Card 02 ("Work") bespoke illustration — workspace panel with header
// dots + title bar + 3-row task checklist (2 checked, 1 unchecked) +
// progress bar, ported from huzlly-how-it-works.html's .card--02 SVG.
// Extracted verbatim from FeaturesSummary.astro's Step 3 inline version
// during the Step 6 structure-cleanup pass — markup/classes unchanged,
// just relocated. Now unified onto the same blue signal color as every
// other card: the header-dot accent uses a blue-600/blue-300/blue-200
// ramp, and everything else maps to blue-600/blue-100/blue-50.
---

<svg
  class="absolute inset-0 h-full w-full"
  viewBox="0 0 400 220"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {/* Workspace panel */}
  <rect x="76" y="34" width="248" height="152" rx="14" class="fill-white stroke-blue-100" stroke-width="1.5" />
  {/* Panel header dots */}
  <circle cx="96" cy="52" r="3.2" class="fill-blue-200" opacity="0.8" />
  <circle cx="108" cy="52" r="3.2" class="fill-blue-300" opacity="0.8" />
  <circle cx="120" cy="52" r="3.2" class="fill-blue-600" opacity="0.8" />
  {/* Title bar */}
  <rect x="96" y="64" width="70" height="7" rx="3.5" class="fill-blue-600" opacity="0.85" />
  <line x1="96" y1="78" x2="304" y2="78" class="stroke-blue-50" stroke-width="1.5" />

  {/* Task row 1 — checked */}
  <rect x="96" y="90" width="14" height="14" rx="4" class="fill-blue-50 stroke-blue-600" stroke-width="1.5" />
  <path d="M99.5 97 l3 3 l6 -6.5" class="stroke-blue-600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  <rect x="120" y="94.5" width="120" height="5" rx="2.5" class="fill-blue-100" />

  {/* Task row 2 — checked */}
  <rect x="96" y="114" width="14" height="14" rx="4" class="fill-blue-50 stroke-blue-600" stroke-width="1.5" />
  <path d="M99.5 121 l3 3 l6 -6.5" class="stroke-blue-600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  <rect x="120" y="118.5" width="96" height="5" rx="2.5" class="fill-blue-100" />

  {/* Task row 3 — unchecked */}
  <rect x="96" y="138" width="14" height="14" rx="4" class="fill-white stroke-rail" stroke-width="1.5" />
  <rect x="120" y="142.5" width="108" height="5" rx="2.5" class="fill-blue-50" />

  {/* Progress bar */}
  <rect x="96" y="164" width="208" height="6" rx="3" class="fill-blue-50" />
  <rect x="96" y="164" width="132" height="6" rx="3" class="fill-blue-600" />
</svg>
