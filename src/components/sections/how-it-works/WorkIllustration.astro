---
// src/components/sections/how-it-works/WorkIllustration.astro
// Ported from reference mockup: card-2-project-delivery.html
---

<div class="absolute inset-0 flex items-center justify-center p-3 sm:p-4" style="transform: scale(0.8); transform-origin: center;">
  <div
    class="hiw-card2-card flex h-full w-full max-w-[480px] flex-col overflow-y-auto rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_12px_32px_-10px_rgba(15,23,42,0.10)] transition-[box-shadow,transform] duration-300 ease-out"
    role="region"
    aria-label="Project delivery and execution workspace"
  >
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px] bg-slate-100">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0 text-slate-700">
            <path d="M3 7C3 5.89543 3.89543 5 5 5H9.58579C9.851 5 10.1054 5.10536 10.2929 5.29289L11.7071 6.70711C11.8946 6.89464 12.149 7 12.4142 7H19C20.1046 7 21 7.89543 21 9V17C21 18.1046 20.1046 19 19 19H5C3.89543 19 3 18.1046 3 17V7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="font-display text-[15px] font-semibold tracking-[-0.01em] text-slate-900">Project hub</span>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-emerald-100 bg-emerald-50 py-[5px] pl-2.5 pr-3 text-[11.5px] font-semibold text-emerald-600">
        <span class="hiw-card2-dot-pulse"></span>
        Live sync
      </span>
    </div>

    <!-- Project row -->
    <div class="mb-5">
      <div class="mb-2 font-display text-base font-bold tracking-[-0.01em] text-slate-900">
        Acme Corp <span class="mx-0.5 font-normal text-slate-500">·</span> Brand System
      </div>
      <div class="mb-1.5 flex items-center justify-between">
        <span class="text-[12.5px] font-medium text-slate-500">Milestones</span>
        <span class="font-sans text-[12.5px] tabular-nums text-slate-900">3 of 5 complete</span>
      </div>
      <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-[#EEF2F6]">
        <div class="hiw-card2-progress-fill h-full rounded-full bg-gradient-to-r from-emerald-500 to-emerald-600"></div>
      </div>
    </div>

    <!-- Task & time block -->
    <div class="mb-3 rounded-2xl border border-slate-200 bg-[#FBFCFE] p-3">
      <div class="flex items-center gap-2.5 rounded-[10px] px-1 py-2 transition-colors duration-150 hover:bg-slate-900/[0.02]">
        <span class="flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-md bg-emerald-600 text-white">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-[11px] w-[11px]">
            <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-slate-500 line-through decoration-slate-300">Design tokens &amp; typography</span>
        <span class="shrink-0 whitespace-nowrap rounded-full bg-slate-100 px-2 py-[3px] text-[11px] font-semibold text-slate-500">Completed</span>
      </div>
      <div class="mt-0.5 flex items-center gap-2.5 rounded-[10px] px-1 py-2 transition-colors duration-150 hover:bg-slate-900/[0.02]">
        <span class="hiw-card2-checkbox-progress"></span>
        <span class="min-w-0 flex-1 truncate text-[13.5px] font-semibold text-slate-900">Figma UI components</span>
        <span class="hiw-card2-timer-pill inline-flex shrink-0 items-center gap-[5px] whitespace-nowrap rounded-full border border-emerald-100 bg-emerald-50 px-2.5 py-[3px] font-sans text-[11px] tabular-nums font-semibold text-emerald-700">
          03:42:15
        </span>
      </div>
    </div>

    <!-- Client portal node -->
    <div class="hiw-card2-client-node relative rounded-2xl border border-emerald-100 bg-gradient-to-b from-[#FBFDFC] to-[#F6FBF9] px-3.5 py-3">
      <div class="mb-2.5 flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-slate-500">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-emerald-600">
          <path d="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        Client Portal · Recently Visited
      </div>
      <div class="flex items-center gap-2.5">
        <span class="flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 font-sans text-xs font-bold text-white">SK</span>
        <div class="min-w-0 flex-1">
          <div class="text-[13.5px] font-semibold text-slate-900">Sarah K.</div>
          <div class="truncate text-[12.5px] leading-relaxed text-slate-500">Viewed latest prototype 12m ago</div>
        </div>
        <span class="shrink-0 whitespace-nowrap rounded-full bg-emerald-100 px-2 py-[3px] text-[11px] font-semibold text-emerald-700">Auto-updated</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-auto shrink-0 border-t border-[#EDF1F5] pt-4">
      <p class="text-[12.5px] leading-relaxed text-slate-500">Organize work, log hours, and keep clients in sync automatically.</p>
    </div>
  </div>
</div>

<style>
  .hiw-card2-card {
    max-height: 100%;
  }
  .hiw-card2-card:hover {
    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.05), 0 20px 40px -12px rgba(15, 23, 42, 0.14);
    transform: translateY(-2px);
  }

  .hiw-card2-dot-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #059669;
    position: relative;
    flex-shrink: 0;
    display: inline-block;
  }
  .hiw-card2-dot-pulse::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: #059669;
    opacity: 0.35;
    animation: hiw-card2-pulse-ring 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes hiw-card2-pulse-ring {
    0% {
      transform: scale(0.6);
      opacity: 0.5;
    }
    70% {
      transform: scale(1.8);
      opacity: 0;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .hiw-card2-progress-fill {
    width: 60%;
    position: relative;
    animation: hiw-card2-fill-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes hiw-card2-fill-in {
    from {
      width: 0%;
    }
    to {
      width: 60%;
    }
  }
  .hiw-card2-progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 24px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5));
  }

  .hiw-card2-checkbox-progress {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 2px solid #059669;
    background: #ecfdf5;
    position: relative;
  }
  .hiw-card2-checkbox-progress::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #059669;
    animation: hiw-card2-soft-pulse 1.6s ease-in-out infinite;
  }

  @keyframes hiw-card2-soft-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  .hiw-card2-timer-pill {
    position: relative;
  }
  .hiw-card2-timer-pill::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #059669;
    animation: hiw-card2-soft-pulse 1.4s ease-in-out infinite;
  }

  .hiw-card2-client-node::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 24px;
    width: 1px;
    height: 12px;
    background: #e2e8f0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-card2-dot-pulse::before,
    .hiw-card2-checkbox-progress::before,
    .hiw-card2-timer-pill::before,
    .hiw-card2-progress-fill {
      animation: none;
    }
    .hiw-card2-progress-fill {
      width: 60%;
    }
  }
</style>
