---
// src/components/sections/WaitlistFormCard.astro

import { ArrowRight, Mail } from 'lucide-astro';
import Button from '../ui/Button.astro';
---

<div id="waitlist-split-card" class="split-card relative mx-auto w-full max-w-md overflow-hidden rounded-3xl border border-white/40 bg-white/25 p-8 shadow-[0_8px_32px_rgba(2,6,23,0.18)] backdrop-blur-2xl sm:p-10" style="display: none;">
  <h2 class="text-center font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
    Be first in when a spot opens
  </h2>
  <p class="text-pretty mt-3 text-center text-ink/70 leading-relaxed max-w-sm mx-auto">
    We'll email you the moment a spot opens - no spam.
  </p>

  <form id="waitlist-form" class="mt-8 flex flex-col gap-2 w-full" novalidate>
    <div>
      <label for="waitlist-email" class="mb-1.5 inline-block text-sm font-medium text-ink/70">Email</label>
      <div class="relative">
        <Mail class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink/35" stroke-width="1.75" />
        <input id="waitlist-email"
          name="email"
          type="email"
          required
          placeholder="you@studio.com"
          autocomplete="email"
          class="w-full rounded-xl border border-white/50 bg-white/40 pl-10 pr-4 py-2.5 text-sm text-ink placeholder:text-ink/40 shadow-sm backdrop-blur-md transition-colors hover:border-white/70 focus-visible:bg-white/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600/60"
        />
      </div>
      <p id="waitlist-error" class="mt-1.5 text-sm text-red-600 hidden"></p>
    </div>

    <!-- Honeypot: hidden from real visitors, irresistible to bots that fill every field. -->
    <div class="sr-only" aria-hidden="true">
      <label for="waitlist-company">Company</label>
      <input id="waitlist-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <Button type="submit" size="lg" class="group mt-7 w-full hover:!bg-ink" ariaLabel="Join waitlist">
      Join waitlist
      <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" stroke-width="1.75" />
    </Button>

    <p class="mt-1 text-center text-xs leading-snug text-ink/50">
      By joining the waitlist, you agree to our <a href="/terms" class="underline underline-offset-2 hover:text-ink">Terms of Service</a> and <a href="/privacy" class="underline underline-offset-2 hover:text-ink">Privacy Policy</a>.
    </p>
  </form>
</div>

<style>
  /* DEBUG: entrance/idle/leave animation removed — .split-card is now
     visible by default with no transform. */
  .split-card {
  }
  @media (prefers-reduced-motion: reduce) {
    .split-card {
      opacity: 1;
      transform: none;
    }
  }
</style>
