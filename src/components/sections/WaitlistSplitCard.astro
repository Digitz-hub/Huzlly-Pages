---
// src/components/sections/WaitlistSplitCard.astro
// Used only on src/pages/waitlist.astro — replaces the page's former
// stacked hero-section + WaitlistSignupForm.astro with a single floating
// split card (brand/value panel + signup form panel).
//
// PER-PAGE INSPIRATION OVERRIDE — CLAUDE.md Section 4.5
// Design source: user-supplied reference screenshot of a two-column,
// rounded, floating signup modal (soft pastel gradient panel on the left
// with logo/headline/stat-block/benefit rows, clean white form panel on
// the right with a centered badge, heading, stacked labeled inputs, and a
// full-width solid CTA). DESIGN_SYSTEM.md v2 tokens (ink/paper/rail as a
// strict palette, dot-grid/flow-rail motifs) are NOT the source for this
// component's layout, background treatment, or card shape — see the chat
// design note for the exact tokens used here.
//
// Fixed regardless of the override (Section 4.5's non-negotiable list):
// blue-600 accent (badge, stat accents, focus rings, headline highlight),
// all copy/facts from SITE_IDENTITY_AND_AEO.md (proof points carry
// "designed to" qualifying language since they're pre-launch targets, per
// Section 3 of that file), full-file delivery / no split tags / no inline
// styles, and the ui/ Button and Badge primitives (used below rather than
// hand-rolled markup).
//
// Structural note: the ink/paper/rail tokens are still used for text and
// hairlines where they read naturally (ink for body text, rail for
// borders) — the override permits deviation, it doesn't forbid reuse.
//
// v2 polish pass: elevation shadow + ambient page glow so the card lifts
// off the flat paper background, text-balance/text-pretty on headline and
// body copy to fix awkward line wraps, panel divider on desktop, refined
// input/button states (shadow, focus ring, hover-lift via Button's
// `motion` prop) — no new layout/color tokens introduced.

import { ArrowLeft, ArrowRight, Check, Zap, Clock, ShieldCheck, MailCheck, Users, Rocket, Compass, Mail } from 'lucide-astro';
import Button from '../ui/Button.astro';

const bullets = [
  { icon: Zap, bold: 'Automatic handoff', rest: 'from proposal to project, no manual step in between.' },
  { icon: Clock, bold: 'Save 5–8 hrs/week', rest: 'by automating client onboarding, billing, and status updates.' },
  { icon: ShieldCheck, bold: 'Per-client control', rest: "over what's shared in the client portal." },
];

// "What happens now?" stepper — shown in place of the whole split card
// once the waitlist form succeeds. Uses the DESIGN_SYSTEM.md signal-color
// trio (blue-600 / teal-600 / amber-500) for the three step icons instead
// of the reference screenshot's purple/cyan/pink, so it stays on-brand.
const nextSteps = [
  { icon: MailCheck, title: 'Confirmation sent', desc: "Check your inbox — we've just emailed you a confirmation.", gradient: 'from-blue-500 to-blue-600' },
  { icon: Users, title: "You're queued", desc: 'One of 50 spots this cohort — requests are reviewed in order.', gradient: 'from-teal-500 to-teal-600' },
  { icon: Rocket, title: 'Invite on opening', desc: "We'll email the moment your spot opens — no need to check back.", gradient: 'from-amber-500 to-amber-600' },
];
---

<section class="waitlist-stage relative flex h-full w-full items-center justify-center px-2 py-2 sm:px-4 sm:py-3">
  <!-- Ambient glow so the card visibly lifts off the flat paper background -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[70%] w-[85%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-100/40 blur-3xl" aria-hidden="true"></div>

  <div id="waitlist-split-card" class="split-card mx-auto w-full max-w-5xl overflow-hidden rounded-3xl border border-rail bg-white lg:grid lg:h-full lg:max-h-full lg:grid-cols-2 lg:divide-x lg:divide-rail">
    <!-- Left panel: brand + value -->
    <div class="relative flex h-full flex-col justify-center gap-8 overflow-hidden bg-gradient-to-br from-blue-50 via-teal-50 to-white p-8 sm:p-10 lg:p-14">
      <!-- Ambient pastel accents (decorative, contained within the panel) -->
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-teal-200/40 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-blue-200/30 blur-3xl" aria-hidden="true"></div>

      <!-- Logo: normal flow on mobile/tablet (panel height = content height there,
           so absolute positioning would collide with the heading below it).
           Pinned to the panel's top-left corner only at lg, where the 2-col grid
           gives the panel real spare height to pin against. -->
      <a href="/" class="group relative inline-flex items-center gap-2 lg:absolute lg:left-14 lg:top-14" aria-label="Back to Huzlly home">
        <ArrowLeft class="w-3.5 h-3.5 text-ink/40 transition-transform group-hover:-translate-x-0.5 group-hover:text-ink/70" stroke-width="2" />
        <span class="h-2 w-2 rounded-full bg-blue-600" aria-hidden="true"></span>
        <span class="font-display text-lg font-semibold text-ink">Huzlly</span>
      </a>

      <div class="relative">
        <h1 class="text-balance font-display text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-ink leading-[1.08]">
          Be first in when a <span class="text-blue-600">spot opens</span>.
        </h1>
      </div>

      <div class="relative mt-6 space-y-4">
        {bullets.map((bullet) => (
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-white/90 text-blue-600 shadow-sm ring-1 ring-blue-100">
              <bullet.icon class="w-4 h-4" stroke-width="1.75" />
            </span>
            <p class="text-sm lg:text-base text-ink/80 leading-snug">
              <strong class="font-semibold text-ink">{bullet.bold}</strong> {bullet.rest}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Right panel: signup form -->
    <div class="relative flex flex-col justify-center overflow-hidden bg-white p-8 sm:p-10 lg:p-14">
      <!-- Ambient wash so the right panel doesn't read as flat/empty next to
           the left panel's gradient — same token family (blue-50, low
           opacity, contained), just a single quiet accent rather than the
           left panel's fuller teal/blue treatment. -->
      <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-72 w-72 -translate-x-1/2 -translate-y-1/3 rounded-full bg-blue-50/80 blur-3xl" aria-hidden="true"></div>

      <h2 class="text-center font-sans text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-ink">
        Get early access
      </h2>
      <p class="text-pretty mt-3 text-center text-ink/70 leading-relaxed max-w-sm mx-auto">
        We'll email you the moment a spot opens - no spam.
      </p>

      <form id="waitlist-form" class="mt-8 flex flex-col gap-2 max-w-md w-full mx-auto" novalidate>
        <div>
          <label for="waitlist-email" class="mb-1.5 block text-sm font-medium text-ink/70">Email</label>
          <div class="relative">
            <Mail class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink/35" stroke-width="1.75" />
            <input id="waitlist-email"
              name="email"
              type="email"
              required
              placeholder="you@studio.com"
              autocomplete="email"
              class="w-full rounded-xl border border-rail bg-paper/60 pl-10 pr-4 py-2.5 text-sm text-ink placeholder:text-ink/40 shadow-sm transition-colors hover:border-ink/20 focus-visible:border-blue-600 focus-visible:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600/20"
            />
          </div>
          <p id="waitlist-error" class="mt-1.5 text-sm text-red-600 hidden"></p>
        </div>

        <!-- Honeypot: hidden from real visitors, irresistible to bots that fill every field. -->
        <div class="sr-only" aria-hidden="true">
          <label for="waitlist-company">Company</label>
          <input id="waitlist-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <Button type="submit" size="lg" motion class="group mt-7 w-full" ariaLabel="Join waitlist">
          Join waitlist
          <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" stroke-width="1.75" />
        </Button>

        <p class="mt-1 text-center text-xs leading-snug text-ink/50">
          By joining the waitlist, you agree to our <a href="/terms" class="underline underline-offset-2 hover:text-ink">Terms of Service</a> and <a href="/privacy" class="underline underline-offset-2 hover:text-ink">Privacy Policy</a>.
        </p>
      </form>

      <div class="mx-auto mt-7 w-full max-w-md" aria-hidden="true">
        <div class="h-px w-full bg-rail"></div>
      </div>

      <p class="mt-5 text-center text-sm">
        <span class="font-medium text-ink">Already reserved your spot?</span>
        <button type="button" id="waitlist-already-reserved" class="font-medium text-blue-600 underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600/20 rounded">
          See what happens next
        </button>
      </p>
    </div>
  </div>

  <!-- "What happens now?" panel — swapped in for #waitlist-split-card on
       successful submit (see script below). Same slot, same footprint,
       centered stepper instead of the two-column form layout. -->
  <div id="waitlist-next-steps" class="next-steps hidden relative mx-auto w-full max-w-3xl flex-col items-center rounded-3xl border border-rail bg-white px-8 py-14 text-center sm:px-14 sm:py-16">
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
      <Check class="w-6 h-6" stroke-width="2" />
    </span>
    <h2 class="mt-5 font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink" id="waitlist-success-title">
      You're on the list.
    </h2>
    <p class="text-pretty mt-3 text-ink/70 max-w-sm">Here's what happens now.</p>

    <div class="mt-12 flex w-full flex-col items-center gap-10 sm:flex-row sm:items-start sm:justify-center sm:gap-2">
      {nextSteps.map((step, i) => (
        <>
          <div class="flex flex-col items-center gap-4 sm:w-40">
            <span class={`flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${step.gradient} text-white shadow-sm`}>
              <step.icon class="w-6 h-6" stroke-width="1.75" />
            </span>
            <div>
              <p class="font-display text-base font-semibold text-ink">{step.title}</p>
              <p class="mt-1 text-sm text-ink/70 leading-snug">{step.desc}</p>
            </div>
          </div>
          {i < nextSteps.length - 1 && (
            <div class="hidden shrink sm:flex sm:w-12 items-center justify-center pt-7" aria-hidden="true">
              <svg width="100%" height="2" viewBox="0 0 48 2" preserveAspectRatio="none">
                <line x1="0" y1="1" x2="48" y2="1" stroke="#E4E0D8" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>

    <div class="mx-auto mt-12 w-full max-w-xs" aria-hidden="true">
      <div class="h-px w-full bg-rail"></div>
    </div>

    <Button href="/features" variant="accent" class="group mt-6" ariaLabel="Explore Huzlly features">
      <Compass class="w-3.5 h-3.5 transition-transform group-hover:rotate-45" stroke-width="1.75" />
      Explore features
    </Button>

    <button type="button" id="waitlist-go-back" class="mt-3 text-xs font-medium text-ink/50 underline-offset-2 hover:text-ink/70 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600/20 rounded">
      Go back
    </button>
  </div>
</section>

<style>
  /* Single one-shot entrance for the whole card — subtle, not stacked
     with per-element stagger since the reference is a calm, static layout.
     Mandatory reduced-motion fallback per DESIGN_SYSTEM.md Section 6.
     IMPORTANT: this rule only ever holds the ONE-SHOT entrance. The
     persistent floating loop lives in the separate `.is-idle` class
     below, added by JS only once this entrance finishes. Keeping them
     apart is what fixes the repeated-toggle bug: previously both were
     combined in one `animation` shorthand here, so whenever JS removed
     the transient `.screen-leave`/`.screen-enter` override class, the
     cascade fell back to *this* rule and restarted split-card-in from
     opacity:0 every time — that restart, not a failed `animationend`,
     was the visible "blank flash then snap" on the 2nd+ toggle. */
  .split-card {
    opacity: 0;
    transform: translateY(10px);
    animation: split-card-in 1.1s ease-out forwards;
    transition: transform 0.4s ease;
    will-change: transform;
  }
  @keyframes split-card-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Subtle floating effect once settled — a light continuous hover so the
     card reads as elevated above the page background rather than flush
     against it. Deliberately its own class (not merged into `.split-card`)
     and defined here — BEFORE `.screen-leave`/`.screen-enter` further
     down — so those transient classes still win the cascade on
     `animation` while a toggle is in flight, and so removing them
     afterward falls back to this quiet loop instead of the entrance
     keyframes above. Toggled on/off by JS (see script below), only on
     desktop and only once the initial entrance has finished. */
  @media (min-width: 1024px) {
    .is-idle {
      animation: split-card-float 9s ease-in-out infinite;
    }
    @keyframes split-card-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-4px); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .split-card {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .is-idle {
      animation: none;
    }
  }

  /* Next-steps panel: same one-shot fade-up as the split card, triggered
     the moment it's unhidden via JS rather than on page load. */
  .next-steps.is-entering {
    opacity: 0;
    transform: translateY(10px);
    animation: split-card-in 0.9s ease-out forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .next-steps.is-entering {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* Screen-to-screen transition (JS-triggered via switchScreens() below) —
     used both for split-card → next-steps on submit and the reverse on
     "Go back". Separate from the one-shot page-load entrances above:
     these fire every time, not just once, and apply to whichever panel
     is currently leaving/entering. Single-class selectors, defined after
     .split-card / .is-idle so they win on the shared `animation` property
     while active; once JS removes them, the element falls back to
     `.is-idle`'s quiet loop rather than `.split-card`'s entrance keyframes
     — see the note above `.is-idle` for why that ordering matters. */
  .screen-leave {
    animation: screen-leave 0.4s ease-in forwards;
  }
  .screen-enter {
    animation: screen-enter 0.6s ease-out forwards;
  }
  @keyframes screen-leave {
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes screen-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen-leave,
    .screen-enter {
      animation: none;
    }
  }

  /* Stage height crossfade — the form panel and the next-steps panel
     have different natural heights, so swapping which one is visible
     used to make this section's box snap instantly to the new height.
     JS (switchScreens below) locks the stage to its current height right
     before a swap, then animates it to the incoming panel's height — this
     transition is what makes that resize glide instead of jump. */
  .waitlist-stage {
    transition: min-height 0.35s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .waitlist-stage {
      transition: none;
    }
  }
</style>

<script>
  const form = document.getElementById('waitlist-form');
  const errorEl = document.getElementById('waitlist-error');
  const splitCard = document.getElementById('waitlist-split-card');
  const nextSteps = document.getElementById('waitlist-next-steps');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const emailInput = document.getElementById('waitlist-email') as HTMLInputElement | null;
  const successTitle = document.getElementById('waitlist-success-title');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktopViewport = () => window.matchMedia('(min-width: 1024px)').matches;

  // Hands the split card off from its one-shot entrance animation to the
  // persistent `.is-idle` float loop. Called once after the initial
  // page-load entrance finishes, and again after the card re-enters via
  // switchScreens() ("Go back") — never by letting the browser's own
  // cascade fall back to it, which is what used to silently restart the
  // entrance keyframes instead (see the CSS note on `.is-idle`).
  function settleSplitCard() {
    if (!splitCard || prefersReducedMotion) return;
    if (isDesktopViewport()) {
      splitCard.classList.add('is-idle');
    } else {
      splitCard.classList.remove('is-idle');
    }
  }

  if (splitCard && !prefersReducedMotion) {
    splitCard.addEventListener('animationend', (event) => {
      if (event.animationName === 'split-card-in') settleSplitCard();
    }, { once: true });
  }

  // Swap `border-rail` <-> `border-red-500` rather than stacking a second
  // border-color utility on top — two classes setting the same property at
  // equal specificity is exactly what broke the split-card/next-steps
  // toggle earlier, so this always removes the one it's not using.
  function setEmailInvalid(invalid) {
    if (!emailInput) return;
    if (invalid) {
      emailInput.classList.remove('border-rail');
      emailInput.classList.add('border-red-500');
    } else {
      emailInput.classList.remove('border-red-500');
      emailInput.classList.add('border-rail');
    }
  }

  // Clear the error state as soon as the person starts fixing the email.
  emailInput?.addEventListener('input', () => {
    errorEl?.classList.add('hidden');
    setEmailInvalid(false);
  });

  // Mobile keyboard fix: once the on-screen keyboard opens, the viewport
  // shrinks and this input (sitting inside the lower half of the split
  // card) can end up covered by the keyboard. The `overflow-hidden` that
  // used to sit on the page's <main> (mobile) has been removed for this
  // reason — that's what made the page unscrollable in the first place.
  //
  // Driven off `visualViewport`'s `resize` event rather than the input's
  // own `focus` event: focus only fires on an actual focus transition,
  // but Android's back button dismisses the keyboard WITHOUT blurring the
  // input — so tapping the still-focused input again to reopen the
  // keyboard fires no `focus` event at all, and a focus-only listener
  // would silently stop working after that. `visualViewport.resize`
  // fires on every keyboard open/close regardless of focus state, so it
  // keeps nudging the input back into view each time the keyboard
  // reopens. Falls back to the old focus-based nudge on browsers without
  // `visualViewport` (older Safari).
  function nudgeEmailIntoView() {
    if (!emailInput || document.activeElement !== emailInput) return;
    emailInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', () => {
      window.setTimeout(nudgeEmailIntoView, 50);
    });
  } else {
    emailInput?.addEventListener('focus', () => {
      window.setTimeout(nudgeEmailIntoView, 300);
    });
  }

  // Animated swap between the split-card (screen 1) and next-steps
  // (screen 2) panels — used for both directions (submit → next-steps,
  // "Go back" → split-card). `fromEl` fades/slides out first, then
  // `toEl` is unhidden and fades/slides in, so the two never render
  // stacked/overlapping mid-transition. `toDisplay` is the display value
  // to apply to `toEl` once it's shown ('flex' for next-steps, '' for
  // split-card so its own responsive `lg:grid` etc. classes take over
  // instead of a hardcoded value).
  function switchScreens(fromEl, toEl, toDisplay) {
    if (!fromEl || !toEl) return;

    // The form panel and the next-steps panel have different natural
    // heights, so swapping which one is visible used to snap the shared
    // stage instantly to the new height. Lock the stage at its current
    // height first, then (once the incoming panel is laid out) animate
    // toward its height instead — the `.waitlist-stage` CSS transition
    // above does the actual gliding.
    const stage = fromEl.closest('section');
    if (stage) {
      stage.style.minHeight = `${stage.getBoundingClientRect().height}px`;
    }

    const enterToEl = () => {
      toEl.classList.remove('hidden');
      toEl.style.display = toDisplay;

      if (stage) {
        if (prefersReducedMotion) {
          stage.style.minHeight = '';
        } else {
          // Wait a frame so toEl has its final layout before measuring.
          requestAnimationFrame(() => {
            stage.style.minHeight = `${toEl.getBoundingClientRect().height}px`;
          });
          stage.addEventListener('transitionend', () => {
            stage.style.minHeight = '';
          }, { once: true });
        }
      }

      if (prefersReducedMotion) return;
      toEl.classList.add('screen-enter');
      toEl.addEventListener('animationend', () => {
        toEl.classList.remove('screen-enter');
        if (toEl === splitCard) settleSplitCard();
      }, { once: true });
    };

    if (prefersReducedMotion) {
      fromEl.style.display = 'none';
      enterToEl();
      return;
    }

    fromEl.classList.add('screen-leave');
    fromEl.addEventListener('animationend', () => {
      fromEl.style.display = 'none';
      fromEl.classList.remove('screen-leave');
      enterToEl();
    }, { once: true });
  }

  // "Already reserved your spot?" — bypasses the form/API entirely and
  // jumps straight to the next-steps screen, same as a real duplicate
  // response would (title reads "You're already on the list.").
  const alreadyReservedBtn = document.getElementById('waitlist-already-reserved');
  alreadyReservedBtn?.addEventListener('click', () => {
    showSuccess(true);
  });

  function showError(message, emailInvalid = false) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    setEmailInvalid(emailInvalid);
  }

  function showSuccess(duplicate) {
    if (successTitle) {
      successTitle.textContent = duplicate ? "You're already on the list." : "You're on the list.";
    }
    switchScreens(splitCard, nextSteps, 'flex');
  }

  // "Go back" on the next-steps screen — same animated swap as
  // showSuccess, just reversed.
  const goBackBtn = document.getElementById('waitlist-go-back');
  goBackBtn?.addEventListener('click', () => {
    switchScreens(nextSteps, splitCard, '');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    setEmailInvalid(false);

    const companyInput = document.getElementById('waitlist-company') as HTMLInputElement;
    const email = emailInput ? emailInput.value.trim() : '';

    if (!EMAIL_RE.test(email)) {
      showError('Enter a valid email address to join the waitlist.', true);
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, company: companyInput ? companyInput.value : '' }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showError('Something went wrong on our end — try again in a moment.');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      showSuccess(Boolean(data.duplicate));
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
