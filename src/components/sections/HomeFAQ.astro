---
// src/components/sections/HomeFAQ.astro

import { Icon } from 'astro-icon/components';
import { ArrowRight } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import FAQAccordion from './FAQAccordion.astro';
import type { FAQItem } from './FAQAccordion.astro';

const items: FAQItem[] = [
  {
    question: 'What is Huzlly?',
    answer:
      'Huzlly is an all-in-one platform for managing your freelance business. You can manage clients, projects, tasks, contracts, invoices, payments, and client communication from one place.',
  },
  {
    question: 'Who is Huzlly for?',
    answer:
      'Huzlly is built for freelancers and independent professionals who want a simpler way to manage the business side of their work - without juggling everything manually.',
  },
  {
    question: 'What can I manage with Huzlly?',
    answer:
      'You can manage the workflow around your freelance work, including clients, projects, tasks, proposals, contracts, invoices, payments, client portals, and more.',
  },
  {
    question: 'Does Huzlly automate repetitive work?',
    answer:
      'Yes. Huzlly is designed to automate parts of your workflow, such as moving work forward after a client accepts, sending payment reminders, and keeping clients updated - so you spend less time on admin.',
  },
  {
    question: 'Can my clients use Huzlly too?',
    answer:
      'Yes. Huzlly includes a client portal where clients can access relevant project information, documents, invoices, and updates without needing access to your entire workspace.',
  },
  {
    question: 'Is Huzlly free?',
    answer:
      'Huzlly is currently in closed beta. You can join the waitlist to get access as beta availability opens up.',
  },
];
---

<section id="faq" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="flex justify-center mb-16">
      <div class="inline-flex w-fit items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]">
        <Icon name="ph:question-duotone" class="text-base" aria-hidden="true" />
        Questions? We've Got Answers.
      </div>
    </div>
    <div class="grid grid-cols-1 gap-y-10 lg:grid-cols-2 lg:gap-x-12 lg:items-start">
      <div class="flex flex-col text-left">
        <h2 class="font-display mt-2 text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
          Frequently Asked Questions
        </h2>
        <p class="mt-4 text-lg text-ink/70">
          From managing your work to getting paid, here's what you need to know about Huzlly.
        </p>
      </div>

      <div>
        <FAQAccordion items={items} />
      </div>
    </div>

    <Card variant="highlighted" class="mt-10 !bg-gray-100 !shadow-none">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-xl sm:text-2xl font-semibold leading-snug text-ink font-display">Have More Questions?</h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-ink/70">Find more answers about Huzlly, its features, and how it works.</p>
        </div>
        <Button
          href="/faq"
          variant="primary"
          class="!border-0 !bg-blue-600 !text-white hover:!bg-blue-700 active:!bg-blue-800 flex-shrink-0"
        >
          View FAQs
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </div>
    </Card>
  </div>
</section>
