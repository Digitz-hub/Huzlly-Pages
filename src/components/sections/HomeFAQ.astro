---
// src/components/sections/HomeFAQ.astro

import { ArrowRight } from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import FAQAccordion from './FAQAccordion.astro';
import type { FAQItem } from './FAQAccordion.astro';

// Curated, homepage-specific subset — distinct from the full category
// breakdown on /faq (see faq.astro). Short list aimed at the handful of
// questions someone lands on the homepage still holding, before they've
// even reached the waitlist CTA above.
const items: FAQItem[] = [
  {
    question: 'What exactly does Huzlly do?',
    answer:
      'Huzlly connects the client workflow freelancers usually piece together by hand — proposals, contracts, invoicing, and project setup — into one automated flow, so approval triggers the contract and signing triggers the invoice and project automatically.',
  },
  {
    question: 'Is Huzlly only for agencies or teams?',
    answer:
      'No. Huzlly is built single-user first for solo freelancers — designers, writers, consultants, coaches — not for agencies or teams that need multi-seat collaboration or approval chains.',
  },
  {
    question: 'How much does Huzlly cost?',
    answer:
      'Huzlly runs on a free tier plus one flat-rate paid upgrade, with no per-seat fees or hidden tiers. See <a href="/pricing">pricing for lean freelance software</a> for the full breakdown.',
  },
  {
    question: 'Can clients see their project status without emailing me?',
    answer:
      'Yes — the client portal is off by default and controlled per client, and freelancers choose whether each client can view project and task progress, message them directly, or view and download their contracts, proposals, and invoices.',
  },
  {
    question: 'When can I actually start using Huzlly?',
    answer:
      'Huzlly is currently pre-launch in a closed beta with an initial cohort of 50 freelancers. Join the waitlist to get early access as new spots open up.',
  },
];
---

<section id="faq" class="scroll-mt-20 border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <SectionHeader
      eyebrow="FAQ"
      title="Quick answers before you sign up"
      subtitle="A few things freelancers usually want cleared up before joining the waitlist. More detail on every category lives on the full FAQ page."
    />

    <div class="mt-10">
      <FAQAccordion items={items} />
    </div>

    <div class="mt-8 text-center">
      <Button href="/faq" variant="outline">
        View all FAQs
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </Button>
    </div>
  </div>
</section>
