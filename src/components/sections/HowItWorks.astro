---
// src/components/sections/HowItWorks.astro

import {
  FileText,
  PenTool,
  Rocket,
  FolderKanban,
  CheckSquare,
  Clock,
  Users,
  Receipt,
  CreditCard,
  Package,
  Archive,
  Repeat,
} from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';

// Full literal class strings per signal (Tailwind JIT needs literal
// substrings to detect classes — no template-literal color interpolation).
// chipBg pairs with `icon` to color each card's floating chip badges
// (e.g. blue chips = bg-blue-50 + text-blue-600).
//
// `glow` / `glowPos` drive the single ambient illustration-glow blob (see
// reference huzlly-how-it-works.html .illustration-glow rules) — one big
// radial-gradient contained to the illustration box (glowPos/inset resolve
// against that box's own dimensions, and its overflow-hidden clips the
// glow to its bounds — it does not spread across the rest of the card).
// Color fades from saturated to transparent, positioned differently per
// card. Tailwind's class:list can't express an arbitrary radial-gradient
// with a dynamic center + color, so this is applied via inline `style`
// instead of a class. `glow` is the actual saturated signal hex
// (blue-600/teal-600/amber-500/green-600, matching Tailwind's default
// palette — see tailwind.config.mjs), NOT the light -50 tints used for
// chipBg — light tints are what made the old corner blobs disappear under
// blur.
//
// `glowOpacity` is per-signal (not a shared Tailwind opacity-[…] class
// anymore). All four signals now sit at the reference's 0.28 — green-600 is
// a proper saturated color like blue/teal/amber, so it doesn't need the
// dialed-down opacity the old neutral-ink treatment needed.
const signalStyles: Record<string, { glow: string; glowPos: string; glowOpacity: string; icon: string; chipBg: string }> = {
  blue: { glow: '#2563eb', glowPos: '34% 38%', glowOpacity: '0.28', icon: 'text-blue-600', chipBg: 'bg-blue-50' },
  teal: { glow: '#0d9488', glowPos: '66% 30%', glowOpacity: '0.28', icon: 'text-teal-600', chipBg: 'bg-teal-50' },
  amber: { glow: '#f59e0b', glowPos: '34% 66%', glowOpacity: '0.28', icon: 'text-amber-500', chipBg: 'bg-amber-50' },
  green: { glow: '#16a34a', glowPos: '50% 50%', glowOpacity: '0.28', icon: 'text-green-600', chipBg: 'bg-green-50' },
};

// Common chip-pill classes, shared by every card. Sizing is intentionally
// mobile-first and compacts below the `sm:` breakpoint (Step 6 responsive
// pass) — at `sm:` and above every value matches the pre-refactor markup
// exactly (px-3 py-1.5 text-xs, h-5 w-5 icon circle, h-3 w-3 icon glyph,
// gap-1.5), so tablet/desktop look is unchanged. Below `sm:`, padding/
// gap/font/icon size step down one notch so chips don't crowd each other
// or the illustration on narrow phones (<400px).
//
// Each chip is three nested elements instead of one, so its motion
// sources never fight over the same element's `transform` — see the
// per-chip markup below for why each needs its own layer:
//   1. position layer  — absolute + chip.position
//   2. float layer      — chip-float-el (the idle bob keyframe animation)
//   3. pill layer        — chipClasses below + the hover-scale utilities
// `chipClasses` holds ONLY the visual-pill + inner-layout styling (no
// `chip-float-el`, `pointer-events-none`, or `absolute` — those live on
// the position/float layers). A running CSS animation always overrides a
// same-property `:hover` transform on its own element regardless of
// specificity (author !important aside) — so `chip-float-el` and
// `hover:scale-*` can't safely share an element. Three layers, three
// separate transforms, composing visually through normal parent/child
// nesting instead of all fighting for one `transform` property.
const chipClasses =
  'inline-flex items-center gap-1 sm:gap-1.5 whitespace-nowrap rounded-full border border-rail bg-white/90 px-2 py-1 sm:px-3 sm:py-1.5 text-[11px] sm:text-xs font-[Outfit] font-semibold text-ink shadow-sm backdrop-blur-sm transition-transform duration-200 ease-out hover:scale-105';
const chipIconWrapClasses = 'flex h-4 w-4 sm:h-5 sm:w-5 shrink-0 items-center justify-center rounded-full';
const chipIconGlyphClasses = 'h-2.5 w-2.5 sm:h-3 sm:w-3';

// One `chips` entry (Grow stage's "Repeat Work") uses a `translate-x-*`
// utility inside its `position` string (`bottom-4 left-1/2
// -translate-x-1/2`, for centering under a `left-1/2` anchor) — a
// transform. It can't just stay on the position layer arbitrarily: it
// has to land on the pill layer specifically (chipClasses' element),
// because Tailwind's translate/scale utilities all compose into one
// `transform` via shared `--tw-*` custom properties — so
// `-translate-x-1/2` sitting alongside `hover:scale-105` on that same
// pill layer composes safely (translate + hover-scale both apply
// together).
// This helper splits any transform-utility tokens out of a chip's
// `position` string so they land on the pill layer while plain offset
// tokens (left/right/top/bottom/inset-*) stay on the position layer.
function splitChipPosition(position: string) {
  const tokens = position.split(' ');
  const transform = tokens.filter((t) => /^-?(translate|rotate|skew|scale)-/.test(t));
  const offset = tokens.filter((t) => !transform.includes(t));
  return { offset: offset.join(' '), transform: transform.join(' ') };
}

const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: 'Turn prospects into projects.',
    body: 'Create professional proposals, get agreements signed, and set everything up to start working with your client.',
    signal: 'blue',
    illustration: GetStartedIllustration,
    chips: [
      { icon: FileText, label: 'Proposal', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: PenTool, label: 'Contract', position: 'right-4 top-16', delay: '0.6s' },
      { icon: Rocket, label: 'Project Setup', position: 'bottom-4 left-10', delay: '1.2s' },
    ],
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Manage every project in one place.',
    body: 'Organize projects and tasks, track your time, and keep clients updated with their own dedicated portal.',
    signal: 'blue',
    illustration: WorkIllustration,
    chips: [
      { icon: FolderKanban, label: 'Projects', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: CheckSquare, label: 'Tasks', position: 'right-4 top-12', delay: '0.4s' },
      { icon: Clock, label: 'Time Tracking', position: 'bottom-14 left-3', delay: '0.9s' },
      { icon: Users, label: 'Client Portal', position: 'bottom-4 right-8', delay: '1.3s' },
    ],
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: 'Finish the work. Get paid.',
    body: 'Send invoices, collect payments, and keep your billing organized from project completion to payment.',
    signal: 'blue',
    illustration: GetPaidIllustration,
    chips: [
      { icon: Receipt, label: 'Invoice', position: 'right-4 top-3.5', delay: '0s' },
      { icon: CreditCard, label: 'Payment', position: 'bottom-14 right-3.5', delay: '0.5s' },
      { icon: Package, label: 'Delivery', position: 'bottom-4 left-4', delay: '1s' },
    ],
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Turn great work into repeat business.',
    body: 'Keep your client relationships, projects, and history organized so you can stay focused on growing your freelance business.',
    signal: 'blue',
    illustration: GrowIllustration,
    chips: [
      { icon: Users, label: 'Clients', position: 'left-4 top-3.5', delay: '0s' },
      { icon: Archive, label: 'Past Projects', position: 'right-5 top-4', delay: '0.5s' },
      { icon: Repeat, label: 'Repeat Work', position: 'bottom-4 left-1/2 -translate-x-1/2', delay: '1s' },
    ],
  },
];
---

<!-- BACKGROUND: solid white (#FFFFFF) across the whole section — no
     gradient or teal tint. -->
<section id="how-it-works" class="scroll-mt-20 border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <SectionHeader eyebrow="How it works"
      title="Four stages. Zero handoffs."
      subtitle="Each stage of your client relationship flows into the next automatically — you only touch what actually needs a human."
    />

    {/*
      v3 "how it works" restructure. Moves away from Card.astro's 4-up grid
      to 4 full-width horizontal rows, one per `stages` entry, each split
      into a ~60% text column and a ~40% illustration-box column, with a
      thin `border-t border-rail` divider between consecutive rows.
      Card.astro itself is untouched — it's still used elsewhere (the "why
      lean" reasons cards in WhyLean.astro, and other pages) — this section
      just stops importing/rendering it.

      Fixed left/right layout (no more zigzag): the text column is always
      `lg:order-1` (left) and the illustration column is always
      `lg:order-2` (right) at `lg:`, for every row — this used to alternate
      by row index (`isEven`) but no longer does. Mobile always shows the
      illustration box above the text regardless of which stage it is, via
      the mobile-first `order-1`/`order-2` base classes below — those are
      unchanged; only the `lg:` overrides stopped alternating.

      Illustration column (this pass): the glow span / <Illustration /> /
      floating-chips markup is the same logic the old Card-based version
      used — `signalStyles`, `chipClasses`, `chipIconWrapClasses`,
      `chipIconGlyphClasses`, and each stage's `illustration`/`chips`
      fields are unchanged, just reconnected inside the new row layout
      instead of inside a Card.

      Chips split: the illustration box is an outer `relative` box holding
      two kinds of children: the glow + `<Illustration />` in their own
      wrapper div, and the chips, as siblings of that div instead of
      children of it — see the `chipClasses` comment near the top of this
      file for why each chip needs 3 nested layers instead of 1 to keep
      the idle-float and hover-grow transforms from fighting each other.
      Not on the row wrapper and not on the text column, which both stay
      static per prior decision.
    */}
    <div class="mt-14">
      {stages.map((step, index) => {
        const s = signalStyles[step.signal];
        const Illustration = step.illustration;

        return (
          <div class="border-t border-rail py-14 first:border-t-0 first:pt-0 sm:py-16">
            <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-16">
              {/* Text column: ~60% width on desktop. Column itself
                  doesn't move — it's static. */}
              <div class="order-2 flex flex-col justify-center lg:order-1 lg:w-[60%] lg:shrink-0">
                <div class="flex items-center gap-4">
                  <span
                    class="font-[Outfit] text-[64px] font-[800] leading-none text-transparent [-webkit-text-stroke:1.5px_#14110f4d] sm:text-[80px]"
                  >
                    {step.number}.
                  </span>
                  <span
                    class="h-1 w-10 shrink-0 rounded-full"
                    style={`background-color: ${s.glow}`}
                    aria-hidden="true"
                  ></span>
                </div>

                <h3 class="mt-5 font-[Outfit] text-[28px] font-bold leading-snug tracking-[-0.015em] text-ink">{step.headline}</h3>

                <p class="mt-4 max-w-lg font-[Outfit] text-[15.5px] leading-[1.65] text-ink/70">{step.body}</p>
              </div>

              {/* Illustration column: ~40% width on desktop. No
                  `overflow-hidden`/`rounded-xl`/background anywhere in
                  this column (per explicit direction) — there's no
                  visible boxed container around the glow/illustration/
                  chips, so the glow-pulse-el blur bleeds outward past the
                  old box edges instead of being clipped to them;
                  `relative` on the outer box below still gives the
                  glow/illustration/chips their shared positioning
                  context. */}
              <div class="order-1 lg:order-2 lg:w-[40%] lg:shrink-0">
                {/* Outer box: just the positioning context + sizing.
                    Holds two kinds of children: the illustration wrapper
                    below, and the chips (siblings of it, not
                    descendants). */}
                <div class="relative h-56 sm:h-64 lg:h-72">
                  {/* Illustration wrapper: `absolute inset-0` fills the
                      outer box exactly like the old single div's own
                      `h-56 sm:h-64 lg:h-72` did, just one level down. */}
                  <div class="absolute inset-0">
                    <span
                      class="glow-pulse-el pointer-events-none absolute inset-[-10%] z-0 rounded-full blur-[46px]"
                      style={`background: radial-gradient(circle at ${s.glowPos}, ${s.glow} 0%, transparent 48%); opacity: ${s.glowOpacity};`}
                      aria-hidden="true"
                    ></span>

                    <Illustration />
                  </div>

                  {/* Chips: siblings of the illustration wrapper, so they
                      float independently of it. Each is 3 nested layers —
                      see the `chipClasses`/`splitChipPosition` comments
                      above for why, and why a chip's own `position`
                      string gets split across two of those layers rather
                      than sitting on one. */}
                  {step.chips.map((chip) => {
                    const { offset, transform } = splitChipPosition(chip.position);
                    return (
                      <div class:list={['pointer-events-none absolute', offset]}>
                        <div class="chip-float-el inline-block" style={`animation-delay: ${chip.delay}`}>
                          <div class:list={[chipClasses, transform]}>
                            <span class:list={[chipIconWrapClasses, s.chipBg, s.icon]}>
                              <chip.icon class={chipIconGlyphClasses} stroke-width="2.2" />
                            </span>
                            {chip.label}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
