---
// src/components/sections/HowItWorks.astro

import { ChevronDown, Check, ArrowRight } from 'lucide-astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';

// Only the accent color is still read (for the accordion's active-state
// --accent CSS variable) now that the illustrations are self-contained cards.
const signalStyles: Record<string, { glow: string }> = {
  blue: { glow: '#2563eb' },
  teal: { glow: '#0d9488' },
  amber: { glow: '#f59e0b' },
  green: { glow: '#16a34a' },
};

export const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: "It tracks the yes, so you don't have to.",
    bodyItems: [
      'Tracks who accepted your proposal',
      'Sends the contract you set up',
      'Creates the project in your dashboard',
    ],
    signal: 'blue',
    illustration: GetStartedIllustration,
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Helps you keep it all in one place.',
    lead: 'No more switching between tools.',
    bodyItems: [
      'Keep every project organized',
      'Manage tasks without the mess',
      'Track time as you go',
    ],
    closing: 'Everything lives in one place, ready to use the moment you need it for invoicing or to share updates with a client.',
    signal: 'blue',
    illustration: WorkIllustration,
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: "It chases the payment, so you don't have to.",
    lead: "No more chasing clients for money that's already yours.",
    bodyItems: [
      'Send professional invoices',
      'Auto-remind clients until they pay',
      "Know the moment you're paid",
    ],
    closing: "Invoice out, payment in - the awkward part's on us.",
    signal: 'blue',
    illustration: GetPaidIllustration,
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Never lose touch with a good client again.',
    lead: 'No more digging through old chats to remember a client.',
    bodyItems: [
      'See past projects and preferences in one place',
      'Reach out for repeat work in one click',
      'Know exactly who to reach out to',
    ],
    closing: 'The next project starts with someone who already knows you.',
    signal: 'blue',
    illustration: GrowIllustration,
  },
];

export const stageSummaries = stages.map(({ stage, headline }) => ({ stage, headline }));
---

<section id="how-it-works" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl lg:max-w-5xl text-center">
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink">How freelancers run their business on Huzlly</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-ink/70">No spreadsheets, no scattered tools, no chasing down what's overdue — just one workspace that keeps up with the work.</p>
    </div>

    <div id="how-it-works-track" class="mt-20">
      <div id="how-it-works-sticky" class="lg:flex lg:items-start">
        <div class="flex w-full flex-col gap-10 lg:flex-row lg:items-start lg:gap-12">
          <div class="order-2 flex flex-col justify-center lg:order-1 lg:w-1/2 lg:shrink-0">
            <div class="acc-list relative" role="tablist" aria-orientation="vertical">
              <div class="acc-line pointer-events-none absolute top-[38px] bottom-[38px] left-[18px] w-px -translate-x-1/2 bg-rail" aria-hidden="true"></div>
              {stages.map((step, index) => {
                const s = signalStyles[step.signal];
                const panelId = `how-it-works-panel-${index}`;

                return (
                  <div
                    class="acc-item"
                    class:list={[index === 0 && 'is-active']}
                    data-index={index}
                    style={`--accent: ${s.glow};`}
                  >
                    <button
                      type="button"
                      class="acc-trigger group flex w-full items-start gap-5 py-5 text-left"
                      role="tab"
                      aria-expanded={index === 0 ? 'true' : 'false'}
                      aria-controls={panelId}
                    >
                      <span class="acc-badge relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-rail bg-white font-mono text-sm text-ink/40 transition-colors duration-300">
                        {step.number}
                      </span>
                      <span class="flex flex-1 items-center justify-between gap-4">
                        <span class="flex flex-col">
                          <p class="font-mono text-xs uppercase tracking-widest text-blue-600 mb-1">
                            {step.stage}
                          </p>
                          <h3 class="acc-title m-0 font-display text-xl font-semibold leading-snug tracking-[-0.01em] text-ink sm:text-2xl">
                            {step.headline}
                          </h3>
                        </span>
                        <ChevronDown class="acc-chevron h-5 w-5 shrink-0 text-ink/30" stroke-width="2.2" />
                      </span>
                    </button>
                    <div class="acc-panel" id={panelId}>
                      <div class="acc-panel-inner overflow-hidden">
                        {step.bodyItems && (step.lead || step.closing) ? (
                          <div class="acc-desc max-w-md pb-6 pl-[calc(2.25rem+1.25rem)]">
                            {step.lead && (
                              <p class="font-mono text-[15.5px] leading-[1.65] text-ink/70">
                                {step.lead}
                              </p>
                            )}
                            <ul class:list={['space-y-2', step.lead && 'mt-3']}>
                              {step.bodyItems.map((item) => (
                                <li class="flex items-start gap-2.5 font-mono text-[15.5px] leading-[1.65] text-ink/70">
                                  <Check class="mt-[3px] h-4 w-4 shrink-0 text-[var(--accent,currentColor)]" stroke-width="2.5" />
                                  <span>{item}</span>
                                </li>
                              ))}
                            </ul>
                            {step.closing && (
                              <p class="mt-3 font-mono text-[15.5px] leading-[1.65] text-ink/70">
                                {step.closing}
                              </p>
                            )}
                          </div>
                        ) : step.bodyItems ? (
                          <ul class="acc-desc max-w-md space-y-2 pb-6 pl-[calc(2.25rem+1.25rem)] font-mono text-[15.5px] leading-[1.65] text-ink/70">
                            {step.bodyItems.map((item) => (
                              <li class="flex items-start gap-2.5">
                                <Check class="mt-[3px] h-4 w-4 shrink-0 text-[var(--accent,currentColor)]" stroke-width="2.5" />
                                <span>{item}</span>
                              </li>
                            ))}
                          </ul>
                        ) : (
                          <p class="acc-desc max-w-md pb-6 pl-[calc(2.25rem+1.25rem)] font-mono text-[15.5px] leading-[1.65] text-ink/70">
                            {step.body}
                          </p>
                        )}
                      </div>
                    </div>
                    {index !== stages.length - 1 && (
                      <div class="ml-[calc(2.25rem+1.25rem)] border-b border-rail" aria-hidden="true"></div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <div class="hidden lg:block lg:order-2 lg:w-1/2 lg:shrink-0">
            <div class="stage-box relative h-[32rem] sm:h-[34rem] lg:h-[36rem]">
              {stages.map((step, index) => {
                const Illustration = step.illustration;

                return (
                  <div
                    class="stage-item absolute inset-0"
                    class:list={[index === 0 && 'is-active']}
                    data-index={index}
                  >
                    <Illustration />
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href="/features" class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 rounded-md">
        See the full feature breakdown
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </a>
    </div>
  </div>
</section>

<style>
  .acc-trigger {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .acc-trigger:focus-visible {
    outline: 2px solid var(--accent, currentColor);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .acc-item.is-active .acc-panel {
    grid-template-rows: 1fr;
  }

  .acc-desc {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease 0.08s, transform 0.35s ease 0.08s;
  }
  .acc-item.is-active .acc-desc {
    opacity: 1;
    transform: translateY(0);
  }

  .acc-chevron {
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), color 0.35s ease;
  }
  .acc-item.is-active .acc-chevron {
    transform: rotate(180deg);
    color: var(--accent, currentColor);
  }

  .acc-badge {
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }
  .acc-item.is-active .acc-badge {
    border-color: #2563eb;
    background-color: #2563eb;
    color: #fff;
  }

  .acc-line {
    z-index: 0;
  }

  .stage-item {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stage-item.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-panel,
    .acc-desc,
    .acc-chevron,
    .stage-item {
      transition: none !important;
    }
  }
</style>

<script>
  (function () {
    const track = document.getElementById('how-it-works-track');
    if (!track) return;

    const items = Array.from(track.querySelectorAll('.acc-item'));
    const stageItems = Array.from(track.querySelectorAll('.stage-item'));
    const stepCount = items.length;
    if (stepCount === 0) return;

    let activeIndex = 0;

    function setActive(index: number) {
      index = Math.min(stepCount - 1, Math.max(0, index));
      if (index === activeIndex && items[index].classList.contains('is-active')) return;
      activeIndex = index;

      items.forEach((item, i) => {
        const isActive = i === index;
        item.classList.toggle('is-active', isActive);
        const trigger = item.querySelector('.acc-trigger');
        trigger?.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });

      stageItems.forEach((stage, i) => {
        stage.classList.toggle('is-active', i === index);
      });
    }

    items.forEach((item, i) => {
      const trigger = item.querySelector('.acc-trigger');
      trigger?.addEventListener('click', () => {
        setActive(i);
      });
    });

    setActive(0);
  })();
</script>
