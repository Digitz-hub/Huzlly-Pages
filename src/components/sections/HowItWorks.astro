---
// src/components/sections/HowItWorks.astro

import { ChevronDown } from 'lucide-astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';

// Only the accent color is still read (for the accordion's active-state
// --accent CSS variable) now that the illustrations are self-contained cards.
const signalStyles: Record<string, { glow: string }> = {
  blue: { glow: '#2563eb' },
  teal: { glow: '#0d9488' },
  amber: { glow: '#f59e0b' },
  green: { glow: '#16a34a' },
};

const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: 'Turn prospects into projects.',
    body: 'Create professional proposals, get agreements signed, and set everything up to start working with your client.',
    signal: 'blue',
    illustration: GetStartedIllustration,
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Manage every project in one place.',
    body: 'Organize projects and tasks, track your time, and keep clients updated with their own dedicated portal.',
    signal: 'blue',
    illustration: WorkIllustration,
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: 'Finish the work. Get paid.',
    body: 'Send invoices, collect payments, and keep your billing organized from project completion to payment.',
    signal: 'blue',
    illustration: GetPaidIllustration,
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Turn great work into repeat business.',
    body: 'Keep your client relationships, projects, and history organized so you can stay focused on growing your freelance business.',
    signal: 'blue',
    illustration: GrowIllustration,
  },
];
---

<section id="how-it-works" class="scroll-mt-20 border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <div id="how-it-works-track" class="mt-14">
      <div id="how-it-works-sticky" class="lg:flex lg:items-center">
        <div class="flex w-full flex-col gap-10 lg:flex-row lg:items-center lg:gap-12">
          <div class="order-2 flex flex-col justify-center lg:order-1 lg:w-1/2 lg:shrink-0">
            <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">Four stages. Zero handoffs.</h2>
            <p class="mt-4 max-w-md font-[Outfit] text-base text-ink/70">Each stage of your client relationship flows into the next automatically — you only touch what actually needs a human.</p>
            <div class="acc-list mt-8 border-t border-rail" role="tablist" aria-orientation="vertical">
              {stages.map((step, index) => {
                const s = signalStyles[step.signal];
                const panelId = `how-it-works-panel-${index}`;

                return (
                  <div
                    class="acc-item border-b border-rail"
                    class:list={[index === 0 && 'is-active']}
                    data-index={index}
                    style={`--accent: ${s.glow};`}
                  >
                    <button
                      type="button"
                      class="acc-trigger group flex w-full items-center gap-5 py-5 text-left"
                      role="tab"
                      aria-expanded={index === 0 ? 'true' : 'false'}
                      aria-controls={panelId}
                    >
                      <span class="acc-number shrink-0 font-mono text-sm text-ink/40 transition-colors duration-300">
                        {step.number}.
                      </span>
                      <span class="flex flex-1 items-center justify-between gap-4">
                        <span class="acc-title font-display text-xl font-bold leading-snug tracking-[-0.01em] text-ink sm:text-2xl">
                          {step.headline}
                        </span>
                        <ChevronDown class="acc-chevron h-5 w-5 shrink-0 text-ink/30" stroke-width="2.2" />
                      </span>
                    </button>
                    <div class="acc-panel" id={panelId}>
                      <div class="acc-panel-inner overflow-hidden">
                        <p class="acc-desc max-w-md pb-6 pl-[calc(2rem+1.25rem)] font-[Outfit] text-[15.5px] leading-[1.65] text-ink/70">
                          {step.body}
                        </p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="hidden lg:order-2 lg:w-1/2 lg:shrink-0 min-[1080px]:block">
            <div class="stage-box relative h-[32rem] sm:h-[34rem] lg:h-[36rem]">
              {stages.map((step, index) => {
                const Illustration = step.illustration;

                return (
                  <div
                    class="stage-item absolute inset-0"
                    class:list={[index === 0 && 'is-active']}
                    data-index={index}
                  >
                    <Illustration />
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .acc-trigger {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .acc-trigger:focus-visible {
    outline: 2px solid var(--accent, currentColor);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .acc-item.is-active .acc-panel {
    grid-template-rows: 1fr;
  }

  .acc-desc {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease 0.08s, transform 0.35s ease 0.08s;
  }
  .acc-item.is-active .acc-desc {
    opacity: 1;
    transform: translateY(0);
  }

  .acc-chevron {
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), color 0.35s ease;
  }
  .acc-item.is-active .acc-chevron {
    transform: rotate(180deg);
    color: var(--accent, currentColor);
  }

  .acc-item.is-active .acc-number {
    color: var(--accent, currentColor);
  }

  .stage-item {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stage-item.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-panel,
    .acc-desc,
    .acc-chevron,
    .stage-item {
      transition: none !important;
    }
  }
</style>

<script>
  (function () {
    const track = document.getElementById('how-it-works-track');
    if (!track) return;

    const items = Array.from(track.querySelectorAll('.acc-item'));
    const stageItems = Array.from(track.querySelectorAll('.stage-item'));
    const stepCount = items.length;
    if (stepCount === 0) return;

    let activeIndex = 0;

    function setActive(index: number) {
      index = Math.min(stepCount - 1, Math.max(0, index));
      if (index === activeIndex && items[index].classList.contains('is-active')) return;
      activeIndex = index;

      items.forEach((item, i) => {
        const isActive = i === index;
        item.classList.toggle('is-active', isActive);
        const trigger = item.querySelector('.acc-trigger');
        trigger?.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });

      stageItems.forEach((stage, i) => {
        stage.classList.toggle('is-active', i === index);
      });
    }

    items.forEach((item, i) => {
      const trigger = item.querySelector('.acc-trigger');
      trigger?.addEventListener('click', () => {
        setActive(i);
      });
    });

    setActive(0);
  })();
</script>
