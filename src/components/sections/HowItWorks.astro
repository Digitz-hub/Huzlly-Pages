---
// src/components/sections/HowItWorks.astro

import { Check, ArrowRight } from 'lucide-astro';
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';

// The accent color is read per-row to drive the `--accent` CSS variable,
// which colors that row's Check icons and number badge (previously it
// only drove the accordion's active-state styling).
const signalStyles: Record<string, { glow: string }> = {
  blue: { glow: '#2563eb' },
  teal: { glow: '#0d9488' },
  amber: { glow: '#f59e0b' },
  green: { glow: '#16a34a' },
};

export const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: "It tracks the yes, so you don't have to.",
    bodyItems: [
      'Tracks who accepted your proposal',
      'Sends the contract you set up',
      'Creates the project in your dashboard',
    ],
    signal: 'blue',
    illustration: GetStartedIllustration,
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Helps you keep it all in one place.',
    lead: 'No more switching between tools.',
    bodyItems: [
      'Keep every project organized',
      'Manage tasks without the mess',
      'Track time as you go',
    ],
    closing: 'Everything lives in one place, ready to use the moment you need it for invoicing or to share updates with a client.',
    signal: 'blue',
    illustration: WorkIllustration,
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: "It chases the payment, so you don't have to.",
    lead: "No more chasing clients for money that's already yours.",
    bodyItems: [
      'Send professional invoices',
      'Auto-remind clients until they pay',
      "Know the moment you're paid",
    ],
    closing: "Invoice out, payment in - the awkward part's on us.",
    signal: 'blue',
    illustration: GetPaidIllustration,
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Never lose touch with a good client again.',
    lead: 'No more digging through old chats to remember a client.',
    bodyItems: [
      'See past projects and preferences in one place',
      'Reach out for repeat work in one click',
      'Know exactly who to reach out to',
    ],
    closing: 'The next project starts with someone who already knows you.',
    signal: 'blue',
    illustration: GrowIllustration,
  },
];

export const stageSummaries = stages.map(({ stage, headline }) => ({ stage, headline }));
---

<section id="how-it-works" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl lg:max-w-5xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]">
        <Icon name="ph:check-circle-duotone" class="text-base" aria-hidden="true" />
        Here's what it looks like when it's all in one place.
      </div>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink">Every part of your freelance business, working together.</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-ink/70">From the first proposal to the final payment, everything stays linked - all connected, all in sync.</p>
    </div>

    <div id="how-it-works-track" class="mt-20">
      {stages.map((step, index) => {
        const s = signalStyles[step.signal];
        const Illustration = step.illustration;
        const isEven = index % 2 === 0;

        return (
          <div
            class="py-8 sm:py-10 bg-red-500/10 outline outline-2 outline-red-500"
            style={`--accent: ${s.glow};`}
          >
            <div class:list={['flex flex-col gap-10 lg:gap-16', isEven ? 'lg:flex-row' : 'lg:flex-row-reverse']}>
              {/* Text side */}
              <div class="flex flex-col lg:w-1/2 lg:shrink-0 bg-blue-500/10 outline outline-2 outline-blue-500">
                <div class="inline-flex w-fit items-center gap-2.5 rounded-full border border-[#d7deff] bg-[#eef1ff] py-1 pl-1 pr-4">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-600 font-mono text-[11px] font-semibold text-white">
                    {step.number}
                  </span>
                  <span class="font-mono text-xs uppercase tracking-widest text-ink/70">
                    {step.stage}
                  </span>
                </div>

                <h3 class="mt-5 font-display text-2xl font-semibold leading-snug tracking-[-0.01em] text-ink sm:text-3xl">
                  {step.headline}
                </h3>

                {step.bodyItems && (step.lead || step.closing) ? (
                  <div class="mt-4 max-w-md">
                    {step.lead && (
                      <p class="font-mono text-[15.5px] leading-[1.65] text-ink/70">
                        {step.lead}
                      </p>
                    )}
                    <ul class:list={['space-y-2', step.lead && 'mt-3']}>
                      {step.bodyItems.map((item) => (
                        <li class="flex items-start gap-2.5 font-mono text-[15.5px] leading-[1.65] text-ink/70">
                          <Check class="mt-[3px] h-4 w-4 shrink-0 text-[var(--accent,currentColor)]" stroke-width="2.5" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    {step.closing && (
                      <p class="mt-3 font-mono text-[15.5px] leading-[1.65] text-ink/70">
                        {step.closing}
                      </p>
                    )}
                  </div>
                ) : step.bodyItems ? (
                  <ul class="mt-4 max-w-md space-y-2 font-mono text-[15.5px] leading-[1.65] text-ink/70">
                    {step.bodyItems.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <Check class="mt-[3px] h-4 w-4 shrink-0 text-[var(--accent,currentColor)]" stroke-width="2.5" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-4 max-w-md font-mono text-[15.5px] leading-[1.65] text-ink/70">
                    {step.body}
                  </p>
                )}

                <div class="mt-auto pt-7">
                  <Button href="/features" variant="outline" size="sm">
                    Learn More
                    <ArrowRight class="w-4 h-4" stroke-width="1.75" />
                  </Button>
                </div>
              </div>

              {/* Illustration side */}
              <div class="lg:w-1/2 lg:shrink-0 bg-green-500/10 outline outline-2 outline-green-500">
                <div class="relative h-[32rem] sm:h-[34rem] lg:h-[36rem]">
                  <Illustration />
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-10 text-center">
      <a href="/features" class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 rounded-md">
        See the full feature breakdown
        <ArrowRight class="w-4 h-4" stroke-width="1.75" />
      </a>
    </div>
  </div>
</section>
