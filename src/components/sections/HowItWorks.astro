---
// src/components/sections/HowItWorks.astro

import {
  FileText,
  PenTool,
  Rocket,
  FolderKanban,
  CheckSquare,
  Clock,
  Users,
  Receipt,
  CreditCard,
  Package,
  Archive,
  Repeat,
  ChevronDown,
} from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';


const signalStyles: Record<string, { glow: string; glowPos: string; glowOpacity: string; icon: string; chipBg: string }> = {
  blue: { glow: '#2563eb', glowPos: '34% 38%', glowOpacity: '0.28', icon: 'text-blue-600', chipBg: 'bg-blue-50' },
  teal: { glow: '#0d9488', glowPos: '66% 30%', glowOpacity: '0.28', icon: 'text-teal-600', chipBg: 'bg-teal-50' },
  amber: { glow: '#f59e0b', glowPos: '34% 66%', glowOpacity: '0.28', icon: 'text-amber-500', chipBg: 'bg-amber-50' },
  green: { glow: '#16a34a', glowPos: '50% 50%', glowOpacity: '0.28', icon: 'text-green-600', chipBg: 'bg-green-50' },
};

const chipClasses =
  'inline-flex items-center gap-1 sm:gap-1.5 whitespace-nowrap rounded-full border border-rail bg-white/90 px-2 py-1 sm:px-3 sm:py-1.5 text-[11px] sm:text-xs font-[Outfit] font-semibold text-ink shadow-sm backdrop-blur-sm transition-transform duration-200 ease-out hover:scale-105';
const chipIconWrapClasses = 'flex h-4 w-4 sm:h-5 sm:w-5 shrink-0 items-center justify-center rounded-full';
const chipIconGlyphClasses = 'h-2.5 w-2.5 sm:h-3 sm:w-3';

function splitChipPosition(position: string) {
  const tokens = position.split(' ');
  const transform = tokens.filter((t) => /^-?(translate|rotate|skew|scale)-/.test(t));
  const offset = tokens.filter((t) => !transform.includes(t));
  return { offset: offset.join(' '), transform: transform.join(' ') };
}

const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: 'Turn prospects into projects.',
    body: 'Create professional proposals, get agreements signed, and set everything up to start working with your client.',
    signal: 'blue',
    illustration: GetStartedIllustration,
    chips: [
      { icon: FileText, label: 'Proposal', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: PenTool, label: 'Contract', position: 'right-4 top-16', delay: '0.6s' },
      { icon: Rocket, label: 'Project Setup', position: 'bottom-4 left-10', delay: '1.2s' },
    ],
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Manage every project in one place.',
    body: 'Organize projects and tasks, track your time, and keep clients updated with their own dedicated portal.',
    signal: 'blue',
    illustration: WorkIllustration,
    chips: [
      { icon: FolderKanban, label: 'Projects', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: CheckSquare, label: 'Tasks', position: 'right-4 top-12', delay: '0.4s' },
      { icon: Clock, label: 'Time Tracking', position: 'bottom-14 left-3', delay: '0.9s' },
      { icon: Users, label: 'Client Portal', position: 'bottom-4 right-8', delay: '1.3s' },
    ],
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: 'Finish the work. Get paid.',
    body: 'Send invoices, collect payments, and keep your billing organized from project completion to payment.',
    signal: 'blue',
    illustration: GetPaidIllustration,
    chips: [
      { icon: Receipt, label: 'Invoice', position: 'right-4 top-3.5', delay: '0s' },
      { icon: CreditCard, label: 'Payment', position: 'bottom-14 right-3.5', delay: '0.5s' },
      { icon: Package, label: 'Delivery', position: 'bottom-4 left-4', delay: '1s' },
    ],
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Turn great work into repeat business.',
    body: 'Keep your client relationships, projects, and history organized so you can stay focused on growing your freelance business.',
    signal: 'blue',
    illustration: GrowIllustration,
    chips: [
      { icon: Users, label: 'Clients', position: 'left-4 top-3.5', delay: '0s' },
      { icon: Archive, label: 'Past Projects', position: 'right-5 top-4', delay: '0.5s' },
      { icon: Repeat, label: 'Repeat Work', position: 'bottom-4 left-1/2 -translate-x-1/2', delay: '1s' },
    ],
  },
];
---

<section id="how-it-works" class="scroll-mt-20 border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <SectionHeader eyebrow="How it works"
      title="Four stages. Zero handoffs."
      subtitle="Each stage of your client relationship flows into the next automatically — you only touch what actually needs a human."
      titleClass="text-4xl sm:text-5xl lg:text-6xl"
      maxWidthClass="max-w-5xl"
    />

    {/*
      v4 "how it works" restructure. Replaces the v3 "4 stacked rows"
      layout with a scroll-driven left-accordion / right-sticky-stage
      pattern (interaction ported from a reference mockup; visuals are
      this project's own — no reference colors/fonts/content).

      `stages`, `signalStyles`, and the chip helpers above are all
      unchanged from v3 — same data, same illustration imports, same
      chip logic. Only the layout/animation wrapping them changed:
      instead of one full-width row per stage, every stage's text now
      lives in one accordion item on the left (`.acc-item`, only one
      expanded at a time) and every stage's illustration now lives in
      one absolutely-stacked layer on the right (`.stage-item`, only
      one visible at a time), cross-fading as the accordion selection
      changes.

      `#how-it-works-track` / `#how-it-works-sticky` implement the
      scroll-hijack: at `lg:` and up, the track is a tall (220vh)
      wrapper and the sticky inner element pins to the viewport while
      wheel ticks step the active stage one at a time (see the
      `<script>` at the bottom of this file); below `lg:`, none of
      that height/sticky styling applies (Tailwind's responsive
      classes simply don't kick in), so the section sits in normal
      document flow as a plain click-to-expand accordion with the
      illustration stage stacked above it — same mobile-first
      `order-1`/`order-2` convention the old row layout used for its
      text/illustration stacking order.

      Illustration layer markup (glow span + `<Illustration />` +
      floating chips) is copied as-is from the old per-row version,
      just moved from "one per row" to "one per stacked `.stage-item`
      layer" — see the comment further down for specifics. No card
      border/background/shadow/padding was added around it, per
      direction: it still just floats with its glow, same as before.
    */}
    <div id="how-it-works-track" class="mt-14 lg:h-[220vh]">
      {/* Sticky inner wrapper. `lg:overflow-hidden` keeps the
          cross-fading stage layers from ever peeking past this box
          while pinned; everything below `lg:` is unaffected (no
          sticky, no fixed height, no overflow clipping). */}
      <div id="how-it-works-sticky" class="lg:sticky lg:top-0 lg:flex lg:h-screen lg:items-center lg:overflow-hidden">
        <div class="flex w-full flex-col gap-10 lg:flex-row lg:items-center lg:gap-16">
          {/* Left column: accordion. Mobile-first `order-2` (below the
              stage on small screens) / `lg:order-1` (left column on
              desktop) — the reverse of the stage column below, same
              convention the old row layout used for text vs.
              illustration ordering. */}
          <div class="order-2 flex flex-col justify-center lg:order-1 lg:w-[60%] lg:shrink-0">
            <div class="acc-list border-t border-rail" role="tablist" aria-orientation="vertical">
              {stages.map((step, index) => {
                const s = signalStyles[step.signal];
                const panelId = `how-it-works-panel-${index}`;

                return (
                  <div
                    class="acc-item border-b border-rail"
                    class:list={[index === 0 && 'is-active']}
                    data-index={index}
                    style={`--accent: ${s.glow};`}
                  >
                    <button
                      type="button"
                      class="acc-trigger group flex w-full items-center gap-5 py-6 text-left"
                      role="tab"
                      aria-expanded={index === 0 ? 'true' : 'false'}
                      aria-controls={panelId}
                    >
                      <span class="acc-number shrink-0 font-[Outfit] text-[64px] font-[800] leading-none text-transparent [-webkit-text-stroke:1.5px_#14110f4d] sm:text-[80px]">
                        {step.number}.
                      </span>
                      <span class="flex flex-1 items-center justify-between gap-4">
                        <span class="acc-title font-display text-xl font-bold leading-snug tracking-[-0.01em] text-ink sm:text-2xl">
                          {step.headline}
                        </span>
                        <ChevronDown class="acc-chevron h-5 w-5 shrink-0 text-ink/30" stroke-width="2.2" />
                      </span>
                    </button>
                    <div class="acc-panel" id={panelId}>
                      <div class="acc-panel-inner overflow-hidden">
                        <p class="acc-desc max-w-md pb-7 pl-[calc(64px+1.25rem)] font-[Outfit] text-[15.5px] leading-[1.65] text-ink/70 sm:pl-[calc(80px+1.25rem)]">
                          {step.body}
                        </p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Right column: sticky illustration stage. Mobile-first
              `order-1` (above the accordion on small screens) /
              `lg:order-2` (right column on desktop) — matches the old
              row layout's illustration-above-text mobile ordering. */}
          <div class="order-1 lg:order-2 lg:w-[40%] lg:shrink-0">
            <div class="stage-box relative h-64 sm:h-72 lg:h-[26rem]">
              {stages.map((step, index) => {
                const s = signalStyles[step.signal];
                const Illustration = step.illustration;

                return (
                  <div
                    class="stage-item absolute inset-0"
                    class:list={[index === 0 && 'is-active']}
                    data-index={index}
                  >
                    {/* Illustration wrapper: `absolute inset-0` fills
                        this layer exactly like the old per-row
                        version's own inner wrapper did — same glow
                        span + `<Illustration />` pairing, unchanged. */}
                    <div class="absolute inset-0">
                      <span
                        class="glow-pulse-el pointer-events-none absolute inset-[-10%] z-0 rounded-full blur-[46px]"
                        style={`background: radial-gradient(circle at ${s.glowPos}, ${s.glow} 0%, transparent 48%); opacity: ${s.glowOpacity};`}
                        aria-hidden="true"
                      ></span>

                      <Illustration />
                    </div>

                    {/* Chips: siblings of the illustration wrapper,
                        same 3-nested-layer split as before, just
                        scoped to this stacked layer instead of a row. */}
                    {step.chips.map((chip) => {
                      const { offset, transform } = splitChipPosition(chip.position);
                      return (
                        <div class:list={['pointer-events-none absolute', offset]}>
                          <div class="chip-float-el inline-block" style={`animation-delay: ${chip.delay}`}>
                            <div class:list={[chipClasses, transform]}>
                              <span class:list={[chipIconWrapClasses, s.chipBg, s.icon]}>
                                <chip.icon class={chipIconGlyphClasses} stroke-width="2.2" />
                              </span>
                              {chip.label}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Accordion: collapse/expand ---------- */

  .acc-trigger {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .acc-trigger:focus-visible {
    outline: 2px solid var(--accent, currentColor);
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* grid-rows 0fr -> 1fr collapse/expand technique, same as the
     reference mockup this interaction was ported from. */
  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .acc-item.is-active .acc-panel {
    grid-template-rows: 1fr;
  }

  .acc-desc {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease 0.08s, transform 0.35s ease 0.08s;
  }
  .acc-item.is-active .acc-desc {
    opacity: 1;
    transform: translateY(0);
  }

  .acc-chevron {
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), color 0.35s ease;
  }
  .acc-item.is-active .acc-chevron {
    transform: rotate(180deg);
    color: var(--accent, currentColor);
  }

  /* Each stage's own signalStyles color accents its own number, not a
     single fixed accent — `--accent` is set per `.acc-item` above. */
  .acc-item.is-active .acc-number {
    -webkit-text-stroke-color: var(--accent, #14110f4d);
  }

  /* ---------- Sticky stage: cross-fade between layers ---------- */

  .stage-item {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stage-item.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-panel,
    .acc-desc,
    .acc-chevron,
    .stage-item {
      transition: none !important;
    }
  }
</style>

<script>
  // Ports the reference mockup's wheel-driven "scroll-hijack" behavior:
  // while `#how-it-works-track` is pinned in the viewport (desktop
  // only), each wheel tick steps the active accordion item/stage layer
  // one at a time; scrolling past the first or last item releases the
  // page to scroll normally again. Clicking an accordion item always
  // activates it directly and, on desktop, smooth-scrolls the section
  // into its pinned position if it isn't already there.
  //
  // Compatibility note: this site runs Lenis (see src/scripts/lenis.ts)
  // for sitewide smooth-wheel scrolling, which also listens for native
  // `wheel` events on `window`. To keep the two from fighting over the
  // same event when a step is being consumed here, this handler is
  // registered with `capture: true` and calls `stopPropagation()` only
  // on the ticks it actually intercepts — every other tick (off-screen,
  // mobile, or at the first/last item) is left completely alone and
  // reaches Lenis exactly as it would if this component didn't exist.
  (function () {
    const track = document.getElementById('how-it-works-track');
    if (!track) return;

    const items = Array.from(track.querySelectorAll('.acc-item'));
    const stageItems = Array.from(track.querySelectorAll('.stage-item'));
    const stepCount = items.length;
    if (stepCount === 0) return;

    const LOCK_MS = 400;
    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    let activeIndex = 0;
    let isDesktop = desktopQuery.matches;
    let isLocked = false;

    function setActive(index: number) {
      index = Math.min(stepCount - 1, Math.max(0, index));
      if (index === activeIndex && items[index].classList.contains('is-active')) return;
      activeIndex = index;

      items.forEach((item, i) => {
        const isActive = i === index;
        item.classList.toggle('is-active', isActive);
        const trigger = item.querySelector('.acc-trigger');
        trigger?.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });

      stageItems.forEach((stage, i) => {
        stage.classList.toggle('is-active', i === index);
      });
    }

    // ---- Is the sticky section currently pinned in view? ----

    function isEngaged() {
      const rect = track.getBoundingClientRect();
      return rect.top <= 1 && rect.bottom >= window.innerHeight - 1;
    }

    function getTrackTop() {
      const rect = track.getBoundingClientRect();
      return rect.top + window.scrollY;
    }

    // ---- Wheel-driven single-step-per-tick snapping ----

    function onWheel(e: WheelEvent) {
      if (!isDesktop) return;
      if (!isEngaged()) return; // outside the pinned range: let Lenis/the page scroll normally

      const goingDown = e.deltaY > 0;
      const atLastStep = activeIndex === stepCount - 1;
      const atFirstStep = activeIndex === 0;

      // at either edge, release control so the page can continue
      // scrolling past (or above) the section instead of trapping the user
      if (goingDown && atLastStep) return;
      if (!goingDown && atFirstStep) return;

      e.preventDefault();
      e.stopPropagation(); // keep this tick from also reaching Lenis's own wheel handler

      if (isLocked) return;
      isLocked = true;
      setActive(activeIndex + (goingDown ? 1 : -1));
      setTimeout(() => {
        isLocked = false;
      }, LOCK_MS);
    }

    window.addEventListener('wheel', onWheel, { passive: false, capture: true });

    // ---- Click-to-select with manual override ----

    function ensureEngaged() {
      if (!isDesktop) return;
      if (isEngaged()) return;
      const targetY = getTrackTop() + 1;
      window.scrollTo({ top: targetY, behavior: reducedMotionQuery.matches ? 'auto' : 'smooth' });
    }

    items.forEach((item, i) => {
      const trigger = item.querySelector('.acc-trigger');
      trigger?.addEventListener('click', () => {
        setActive(i);
        ensureEngaged();
      });
    });

    function handleDesktopChange(e: MediaQueryListEvent) {
      isDesktop = e.matches;
    }
    if (typeof desktopQuery.addEventListener === 'function') {
      desktopQuery.addEventListener('change', handleDesktopChange);
    } else {
      // Safari < 14 fallback
      desktopQuery.addListener(handleDesktopChange);
    }

    setActive(0);
  })();
</script>
