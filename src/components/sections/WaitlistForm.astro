---
// src/components/sections/WaitlistForm.astro

import { ArrowRight } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

export interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Get early access',
  subheading = "Huzlly is in closed beta. Join the waitlist and we'll email you when a spot opens — no sales calls, no spam, unsubscribe any time.",
} = Astro.props;
---

<section class="border-t border-rail bg-[linear-gradient(180deg,#FFFFFF_0%,#FFFDF5_20%,#FEF6E4_100%)] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <Card variant="highlighted" class="p-8 sm:p-12 text-center">
      <Badge variant="beta" class="mx-auto">50 spots this cohort</Badge>

      <h2 class="mt-5 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink">
        {heading}
      </h2>
      <p class="mt-4 text-ink/70 leading-relaxed max-w-md mx-auto">
        {subheading}
      </p>

      <div class="mt-8">
        <Button href="/waitlist" size="lg" motion>
          Join the waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </div>
    </Card>
  </div>
</section>
