---
// src/components/sections/WaitlistForm.astro
// Homepage + /waitlist page email capture. Submits to the Cloudflare
// Pages Function at functions/api/waitlist.js, which writes to a KV
// namespace bound as WAITLIST_KV. See that file for the storage format,
// and the project setup notes for how to create/bind the namespace.

import { ArrowRight, Check } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

export interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Get early access',
  subheading = "Huzlly is in closed beta. Join the waitlist and we'll email you when a spot opens — no sales calls, no spam, unsubscribe any time.",
} = Astro.props;
---

<section class="bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <Card variant="highlighted" class="p-8 sm:p-12 text-center">
      <Badge variant="beta" class="mx-auto">50 spots this cohort</Badge>

      <h2 class="mt-5 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
        {heading}
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed max-w-md mx-auto">
        {subheading}
      </p>

      <form id="waitlist-form" class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto" novalidate>
        <label for="waitlist-email" class="sr-only">Email address</label>
        <input
          id="waitlist-email"
          name="email"
          type="email"
          required
          placeholder="you@studio.com"
          autocomplete="email"
          class="flex-1 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
        />

        <!-- Honeypot: hidden from real visitors, irresistible to bots that fill every field. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="waitlist-company">Company</label>
          <input id="waitlist-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          id="waitlist-submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 active:bg-gray-950 transition-colors duration-200 ease-in-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 whitespace-nowrap disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span class="submit-label">Join waitlist</span>
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </button>
      </form>

      <p id="waitlist-error" class="mt-3 text-sm text-red-600 hidden"></p>

      <div id="waitlist-success" class="mt-8 hidden flex-col items-center gap-2">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
          <Check class="w-5 h-5" stroke-width="2" />
        </span>
        <p class="text-sm font-semibold text-gray-900" id="waitlist-success-title">You're on the list.</p>
        <p class="text-sm text-gray-600">We'll email you when your spot opens up.</p>
      </div>
    </Card>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form');
  const errorEl = document.getElementById('waitlist-error');
  const successEl = document.getElementById('waitlist-success');
  const submitBtn = document.getElementById('waitlist-submit');
  const successTitle = document.getElementById('waitlist-success-title');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(message) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  function showSuccess(duplicate) {
    if (successTitle) {
      successTitle.textContent = duplicate ? "You're already on the list." : "You're on the list.";
    }
    form?.classList.add('hidden');
    successEl?.classList.remove('hidden');
    successEl?.classList.add('flex');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');

    const emailInput = document.getElementById('waitlist-email');
    const companyInput = document.getElementById('waitlist-company');
    const email = emailInput.value.trim();

    if (!EMAIL_RE.test(email)) {
      showError('Enter a valid email address to join the waitlist.');
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, company: companyInput ? companyInput.value : '' }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showError("Something went wrong on our end — try again in a moment.");
        submitBtn?.removeAttribute('disabled');
        return;
      }

      showSuccess(Boolean(data.duplicate));
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
