---
// src/components/sections/WhyLean.astro

import { Feather, Zap, Tag, Layers } from 'lucide-astro';
import Card from '../ui/Card.astro';

const reasons = [
  {
    icon: Feather,
    title: 'Nothing you don\u2019t use',
    body: 'Built for one freelancer running one flow, not a scaled-down version of enterprise software.',
  },
  {
    icon: Zap,
    title: 'Live in minutes',
    body: 'No consultant, no onboarding call. Connect your flow and it runs the same day.',
  },
  {
    icon: Tag,
    title: 'One flat price',
    body: 'No per-seat fees, no usage tiers to track. What you see is what you pay.',
  },
];

const quickWins = [
  { icon: Feather, label: 'Nothing you don\u2019t use' },
  { icon: Zap, label: 'Live in minutes' },
  { icon: Tag, label: 'One flat price' },
  { icon: Layers, label: 'Everything in one place' },
];
---

<!--
  v2.2 "Why lean" redesign (per user-supplied inspiration, discussed and
  confirmed before build): moves from the centered SectionHeader + flat
  3-up grid to a left copy / right asymmetric-card layout (1 wide card on
  top, 2 half-width cards below), plus a new full-width 4-item quick-wins
  strip beneath. Structure/composition borrowed from the inspiration
  reference (persona-card layout with a top visual block + text below,
  bottom icon+label strip) — palette stays entirely on the sitewide
  ink/paper/rail + blue-600 signal color, no imported gradient hues, so it
  reads as this site's design language rather than a copy-pasted look.

  Left column is NOT built with the shared SectionHeader component this
  time — SectionHeader is a centered-only pattern (see its own
  `mx-auto ... text-center` wrapper) and this layout needs a left-aligned
  eyebrow/heading/subtitle stacked beside the cards, not above them. Markup
  below intentionally mirrors SectionHeader's type scale/eyebrow styling by
  hand so it still reads as the same header pattern, just left-aligned.
-->
<!-- Flat bg-white instead of the old blue-tinted top-to-bottom gradient
     (#EAF1FC → #F2F7FE → #FFFFFF): with TheShift/HowItWorks also in the
     blue-tint family, this section was blending into the same repeated
     wash. A flat white backdrop differentiates it while staying neutral
     — the single blue-600 card-glow inside the reasons cards (see that
     block's own comment) is untouched, it's a separate deliberate choice.
     `border-t border-rail` adds a thin seam at the top now that there's
     no gradient to soften the transition from HowItWorks above. -->
<section class="border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="lg:col-span-2">
        <span class="inline-flex items-center rounded-full border border-rail bg-paper px-3 py-1 font-mono text-xs uppercase tracking-widest text-blue-600">
          Why lean
        </span>
        <h2 class="font-display mt-4 text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
          Built for one freelancer, not a whole team
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-ink/70">
          Bonsai and HoneyBook grew into agency platforms. Huzlly stayed built for the person doing the work.
        </p>
      </div>

      <div class="lg:col-span-3">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {reasons.map((reason, index) => (
            <Card variant="elevated" class={index === 0 ? 'sm:col-span-2 !bg-white' : '!bg-white'}>
              {/*
                Visual block: same containment technique as the
                "how it works" illustration boxes (overflow-hidden
                rounded-xl + a radial-gradient glow via inline `style`,
                Tailwind can't express an arbitrary-position radial
                gradient as a class) — but deliberately a single fixed
                blue-600 glow across all 3 cards here, not per-card signal
                colors, per explicit user direction (this section reads as
                one consistent group, not 3 differently-themed stages like
                "how it works").
              */}
              <div class="relative h-32 overflow-hidden rounded-xl bg-gradient-to-b from-paper to-white sm:h-40">
                <span
                  class="pointer-events-none absolute inset-[-10%] rounded-full blur-[46px]"
                  style="background: radial-gradient(circle at 50% 50%, #2563eb 0%, transparent 55%); opacity: 0.18;"
                  aria-hidden="true"
                ></span>
                <span class="relative z-10 flex h-full items-center justify-center">
                  <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink text-paper">
                    <reason.icon class="h-6 w-6" stroke-width="1.75" />
                  </span>
                </span>
              </div>
              <h3 class="mt-5 text-xl font-semibold leading-snug text-ink font-display">{reason.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{reason.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:mt-12">
      {quickWins.map((item) => (
        <div class="flex flex-col items-start gap-3 rounded-2xl bg-white p-5">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-paper">
            <item.icon class="h-5 w-5" stroke-width="1.75" />
          </span>
          <p class="text-sm font-medium leading-snug text-ink">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
