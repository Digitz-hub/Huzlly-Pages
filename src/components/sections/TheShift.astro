---
// src/components/sections/TheShift.astro

import DashboardPreview from '../ui/DashboardPreview.astro';

---

<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/duotone/style.css" />

<section id="the-shift" class="scroll-mt-20 relative border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <div class="inline-flex items-center gap-2 rounded-full border border-[#d7deff] bg-[#eef1ff] px-4 py-1.5 text-sm font-medium text-[#3f5ce0]">
      <i class="ph-duotone ph-warning-circle text-base" aria-hidden="true"></i>
      Why freelancing feels harder than it should
    </div>

    <h2 class="mt-6 text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl font-display">
      Freelancing was never supposed to feel this complicated.
    </h2>

    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/70">
      Five friction points quietly eat your time, your money, and your focus before a single invoice gets paid.
    </p>

    <DashboardPreview class="mt-14" />
  </div>
</section>
