---
// src/components/sections/TheShift.astro
// v2 restructure: moves from a 3-row problem/solution split-panel layout to
// a two-part structure — a 3-card challenge/solution grid, plus a single
// "Featured Solution" panel beneath it — per user-supplied reference
// screenshot. Structure/composition (card grid + featured panel below it)
// is borrowed from that reference; palette/components stay entirely on
// this site's own system (Card.astro/Button.astro/Badge.astro, ink/paper/
// rail + blue-600/red-600/green-600), not a literal copy of the
// reference's own colors or photography treatment.
//
// Content shape is unchanged from v1 in substance — same 3 challenges
// (tool fragmentation, manual/chasing admin, cost/complexity) — just
// reshaped from `pairs` ({ problem, solution }) into `challenges`
// ({ icon, title, problem, solution }), since each is now its own card
// with a title/icon instead of a row in a shared split-panel.
//
// Card grid (Part 1): each card is `<Card variant="elevated">` with a
// `border border-rail` override passed via the `class` prop, scoped to
// just this instance — Card.astro itself is untouched, so `elevated`'s
// shared border-less styling stays sitewide-consistent elsewhere (per its
// own header comment). Red-600 marks the "problem" half of each card
// (icon chip + title), blue-600 marks the "Our Solution" label — same
// muted-vs-signal contrast intent as v1, just using the site's red/blue
// signal pairing instead of a muted-ink/blue-600 pairing, to read clearly
// inside a bordered card instead of an open split-panel row.
//
// Featured panel (Part 2): NOT built with Card.astro — it needs an
// edge-to-edge image bleeding to the container's own rounded corners on
// one side, which doesn't fit Card.astro's fixed `p-6` padding on every
// edge. Built as a plain 2-column grid instead (text | image), reusing
// this section's own established left-content/right-visual reveal
// convention (`dp-reveal-left` / `dp-reveal-right`) rather than one
// shared `dp-reveal-up` on the whole panel, since it isn't a single
// atomic unit the way the small challenge cards are.
//
// Scroll-reveal: still wired up via one shared `initScrollReveal('#the-
// shift .dp-reveal', ...)` call in the script tag below — unchanged from
// v1. `dp-reveal-up` (new to this file) is confirmed to already exist as
// a sitewide modifier in src/styles/scroll-reveal.css; not touched here.

import { ArrowRight, Layers, Clock, Tag, Check } from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

const challenges = [
  {
    icon: Layers,
    title: 'Scattered Client Work',
    problem: 'Client files scattered across email, Drive, and WhatsApp.',
    solution: 'Everything lives in one shared workspace.',
  },
  {
    icon: Clock,
    title: 'Manual Admin Work',
    problem: 'Chasing signatures, invoices, and status updates by hand.',
    solution: 'Proposals, contracts, and invoices move themselves.',
  },
  {
    icon: Tag,
    title: 'Per-Seat Pricing',
    problem: 'Enterprise platforms charging per seat for tools you don\u2019t use.',
    solution: 'One flat price, built for a freelancer of one.',
  },
];

const checklist = [
  'Centralized client and project workspace',
  'Automated proposal-to-payment flow',
  'One flat price, no per-seat fees',
];
---

<!-- Flat bg-white instead of the old white→blue-tint→white gradient:
     with Hero, HowItWorks, and WhyLean all carrying soft blue-tinted
     gradients, this section (right after Hero) was reading as "another
     blue gradient" in the scroll. A flat neutral backdrop breaks that
     repetition and lets this section's own red-600/blue-600 challenge-
     card duotone read more clearly. `border-t border-rail` adds a thin
     seam at the top since there's no longer a white-fade to soften the
     transition from Hero. -->
<section id="the-shift" class="scroll-mt-20 relative border-t border-rail bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <SectionHeader eyebrow="The Shift"
      title="Stop Managing Client Work Across a Dozen Different Places."
      subtitle="Huzlly gives freelancers one simple workspace to organize client work, share project information, and deliver a better client experience."
    />

    {/* Part 1: 3-card challenge/solution grid. Each card pairs a muted
        red "problem" half with a blue "Our Solution" half, separated by
        a plain divider — same content as v1's split-panel rows, just
        reshaped into standalone cards. `border border-rail` is passed
        via Card's `class` prop rather than edited into Card.astro itself,
        so this stays a one-off override for this section only. */}
    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {challenges.map((challenge, index) => {
        const revealDirection =
          index === 0 ? 'dp-reveal-left' : index === challenges.length - 1 ? 'dp-reveal-right' : 'dp-reveal-up';
        return (
        <Card variant="elevated" class={`!bg-white dp-reveal ${revealDirection}`}>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 text-red-600">
            <challenge.icon class="h-5 w-5" stroke-width="2" />
          </span>

          <h3 class="mt-4 text-lg font-semibold text-red-600">{challenge.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">{challenge.problem}</p>

          <div class="my-5 border-t border-rail"></div>

          <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">Our Solution</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">{challenge.solution}</p>

          <Button variant="accent" href="/waitlist" class="mt-4">
            Learn more <ArrowRight class="h-3.5 w-3.5" stroke-width="2" />
          </Button>
        </Card>
        );
      })}
    </div>

    {/* Part 2: Featured Solution panel. Plain div, not Card.astro (see
        header comment for why) — text column reveals from the left,
        image column from the right, matching this section's existing
        left-content/right-visual convention rather than one shared
        `dp-reveal-up` on the whole panel. */}
    <div class="relative mt-10 overflow-hidden rounded-2xl bg-white lg:mt-12">
      <div class="dp-reveal dp-reveal-up flex max-w-2xl flex-col justify-center p-8 sm:p-10 lg:p-12">
        <Badge variant="beta" class="w-fit">Featured Solution</Badge>

        <h3 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          One flow, not five apps.
        </h3>

        <p class="mt-3 text-base leading-relaxed text-ink/70">
          One workspace replaces the scattered files, manual chasing, and per-seat platforms freelancers put up with today — automated from proposal to payment, at a single flat price.
        </p>

        <ul class="mt-5 flex flex-col gap-2.5">
          {checklist.map((item) => (
            <li class="flex items-center gap-2.5 text-sm text-ink/80">
              <Check class="h-4 w-4 shrink-0 text-green-600" stroke-width="2.2" />
              {item}
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap gap-3">
          <Button variant="primary" href="/waitlist">Join waitlist</Button>
          <Button variant="outline" href="#how-it-works">See how it works</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initScrollReveal } from '../../scripts/scroll-reveal';

  initScrollReveal('#the-shift .dp-reveal', { completionFraction: 1 });
</script>
