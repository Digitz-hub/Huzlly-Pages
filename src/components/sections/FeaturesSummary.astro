---
// src/components/sections/FeaturesSummary.astro
// Homepage features summary: the four-stage lifecycle explained in card
// form, plus a short "why lean, not bloated" strip pulled from the same
// positioning used in FAQAccordion's Comparisons category. Deep-dive
// copy stays on /features — this is the summary version.
//
// v2.1 card redesign (per user-supplied inspiration, CLAUDE.md Section 4.5):
// "how it works" cards move from the plain icon-chip layout to a numbered-
// badge + headline + bespoke per-card SVG illustration + floating chip
// layout. Structure/composition is from the inspiration reference
// (huzlly-how-it-works.html); palette stays on the sitewide ink/paper/rail
// + signal-color system so it reads as this site's design language, not a
// copy-pasted foreign look. Each card's illustration lives in its own
// component under ./how-it-works/ (GetStartedIllustration.astro,
// WorkIllustration.astro, GetPaidIllustration.astro, GrowIllustration.astro)
// — the shared Card/badge/headline/glow/chip/description markup below is
// written once and driven by the `stages` data array.
//
// Content note: copy moves from the granular automation-trigger framing
// (Proposal/Contract/Invoice/Project) to a 4-stage lifecycle framing
// (Get Started/Work/Get Paid/Grow), per explicit user direction — this is
// a deliberate content decision made with awareness that it diverges from
// SITE_IDENTITY_AND_AEO.md's canonical flow language; AEO/schema follow-up
// is being handled separately by the user, not silently reconciled here.
//
// Color note: the design system only defines three approved signal colors
// (blue-600 / teal-600 / amber-500) — see AutomationNotificationCard.astro's
// comment. With 4 cards, the 4th ("Grow") intentionally uses the neutral
// ink/rail treatment instead of inventing a new hue. Flagged per CLAUDE.md
// Section 3 rather than silently picking a new color.

import {
  FileText,
  PenTool,
  Rocket,
  FolderKanban,
  CheckSquare,
  Clock,
  Users,
  Receipt,
  CreditCard,
  Package,
  Archive,
  Repeat,
  Tag,
  Zap,
  Feather,
} from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';

// Full literal class strings per signal (Tailwind JIT needs literal
// substrings to detect classes — no template-literal color interpolation).
// chipBg pairs with `icon` to color each card's floating chip badges
// (e.g. blue chips = bg-blue-50 + text-blue-600).
//
// `glow` / `glowPos` drive the single ambient illustration-glow blob (see
// reference huzlly-how-it-works.html .illustration-glow rules) — one big
// radial-gradient covering the whole illustration box, saturated color
// fading to transparent, positioned differently per card. Tailwind's
// class:list can't express an arbitrary radial-gradient with a dynamic
// center + color, so this is applied via inline `style` instead of a class.
// `glow` is the actual saturated signal hex (blue-600/teal-600/amber-500,
// matching tailwind.config.mjs), NOT the light -50 tints used for chipBg —
// light tints are what made the old corner blobs disappear under blur.
// The `ink` glow hex is a saturated dark-neutral stand-in (Tailwind's
// rgb()-tuple custom-color format can't be dropped straight into a gradient
// stop) — double-check it against the real ink hex in tailwind.config.mjs
// and adjust if it doesn't match exactly.
const signalStyles: Record<string, { glow: string; glowPos: string; icon: string; chipBg: string }> = {
  blue: { glow: '#2563eb', glowPos: '34% 38%', icon: 'text-blue-600', chipBg: 'bg-blue-50' },
  teal: { glow: '#0d9488', glowPos: '66% 30%', icon: 'text-teal-600', chipBg: 'bg-teal-50' },
  amber: { glow: '#f59e0b', glowPos: '34% 66%', icon: 'text-amber-500', chipBg: 'bg-amber-50' },
  ink: { glow: '#33312e', glowPos: '50% 50%', icon: 'text-ink/70', chipBg: 'bg-rail/40' },
};

// Common chip-pill classes, shared by every card. Sizing is intentionally
// mobile-first and compacts below the `sm:` breakpoint (Step 6 responsive
// pass) — at `sm:` and above every value matches the pre-refactor markup
// exactly (px-3 py-1.5 text-xs, h-5 w-5 icon circle, h-3 w-3 icon glyph,
// gap-1.5), so tablet/desktop look is unchanged. Below `sm:`, padding/
// gap/font/icon size step down one notch so chips don't crowd each other
// or the illustration on narrow phones (<400px).
const chipClasses =
  'chip-float-el pointer-events-none absolute inline-flex items-center gap-1 sm:gap-1.5 whitespace-nowrap rounded-full border border-rail bg-paper/90 px-2 py-1 sm:px-3 sm:py-1.5 text-[11px] sm:text-xs font-medium text-ink shadow-sm backdrop-blur-sm';
const chipIconWrapClasses = 'flex h-4 w-4 sm:h-5 sm:w-5 shrink-0 items-center justify-center rounded-full';
const chipIconGlyphClasses = 'h-2.5 w-2.5 sm:h-3 sm:w-3';

const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: 'Turn prospects into projects.',
    body: 'Create professional proposals, get agreements signed, and set everything up to start working with your client.',
    signal: 'blue',
    illustration: GetStartedIllustration,
    chips: [
      { icon: FileText, label: 'Proposal', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: PenTool, label: 'Contract', position: 'right-4 top-16', delay: '0.6s' },
      { icon: Rocket, label: 'Project Setup', position: 'bottom-4 left-10', delay: '1.2s' },
    ],
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Manage every project in one place.',
    body: 'Organize projects and tasks, track your time, and keep clients updated with their own dedicated portal.',
    signal: 'teal',
    illustration: WorkIllustration,
    chips: [
      { icon: FolderKanban, label: 'Projects', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: CheckSquare, label: 'Tasks', position: 'right-4 top-12', delay: '0.4s' },
      { icon: Clock, label: 'Time Tracking', position: 'bottom-14 left-3', delay: '0.9s' },
      { icon: Users, label: 'Client Portal', position: 'bottom-4 right-8', delay: '1.3s' },
    ],
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: 'Finish the work. Get paid.',
    body: 'Send invoices, collect payments, and keep your billing organized from project completion to payment.',
    signal: 'amber',
    illustration: GetPaidIllustration,
    chips: [
      { icon: Receipt, label: 'Invoice', position: 'right-4 top-3.5', delay: '0s' },
      { icon: CreditCard, label: 'Payment', position: 'bottom-14 right-3.5', delay: '0.5s' },
      { icon: Package, label: 'Delivery', position: 'bottom-4 left-4', delay: '1s' },
    ],
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Turn great work into repeat business.',
    body: 'Keep your client relationships, projects, and history organized so you can stay focused on growing your freelance business.',
    signal: 'ink',
    illustration: GrowIllustration,
    chips: [
      { icon: Users, label: 'Clients', position: 'left-4 top-3.5', delay: '0s' },
      { icon: Archive, label: 'Past Projects', position: 'right-5 top-4', delay: '0.5s' },
      { icon: Repeat, label: 'Repeat Work', position: 'bottom-4 left-1/2 -translate-x-1/2', delay: '1s' },
    ],
  },
];

const reasons = [
  {
    icon: Feather,
    title: 'Nothing you don\u2019t use',
    body: 'Built for one freelancer running one flow, not a scaled-down version of enterprise software.',
  },
  {
    icon: Zap,
    title: 'Live in minutes',
    body: 'No consultant, no onboarding call. Connect your flow and it runs the same day.',
  },
  {
    icon: Tag,
    title: 'One flat price',
    body: 'No per-seat fees, no usage tiers to track. What you see is what you pay.',
  },
];
---

<section id="how-it-works" class="scroll-mt-20 bg-white px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <SectionHeader eyebrow="How it works"
      title="Four stages. Zero handoffs."
      subtitle="Each stage of your client relationship flows into the next automatically — you only touch what actually needs a human."
    />

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {stages.map((step) => {
        const s = signalStyles[step.signal];
        const Illustration = step.illustration;

        return (
          <Card variant="flat-lift">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-ink font-display text-sm font-semibold text-paper">
                {step.number}
              </span>
              <span class="font-mono text-xs uppercase tracking-widest text-ink/50">{step.stage}</span>
            </div>

            <h3 class="mt-4 font-display text-xl font-semibold leading-snug text-ink sm:text-2xl">
              {step.headline}
            </h3>

            <div class="relative mt-5 h-48 overflow-hidden rounded-xl bg-gradient-to-b from-paper to-white sm:h-56">
              <span
                class="glow-pulse-el pointer-events-none absolute inset-[-10%] z-0 rounded-full blur-[46px] opacity-[0.28]"
                style={`background: radial-gradient(circle at ${s.glowPos}, ${s.glow} 0%, transparent 48%);`}
                aria-hidden="true"
              ></span>

              <Illustration />

              {step.chips.map((chip) => (
                <div
                  class:list={[chipClasses, chip.position]}
                  style={`animation-delay: ${chip.delay}`}
                >
                  <span class:list={[chipIconWrapClasses, s.chipBg, s.icon]}>
                    <chip.icon class={chipIconGlyphClasses} stroke-width="2.2" />
                  </span>
                  {chip.label}
                </div>
              ))}
            </div>

            <p class="mt-4 text-sm leading-relaxed text-ink/70">{step.body}</p>
          </Card>
        );
      })}
    </div>
  </div>
</section>

<section class="bg-paper px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow="Why lean"
      title="Built for one freelancer, not a whole team"
      subtitle="Bonsai and HoneyBook grew into agency platforms. Huzlly stayed built for the person doing the work."
    />

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {reasons.map((reason) => (
        <Card variant="elevated" class="text-center sm:text-left">
          <span class="mx-auto sm:mx-0 flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-paper">
            <reason.icon class="w-5 h-5" stroke-width="1.75" />
          </span>
          <h3 class="mt-4 text-xl font-semibold text-ink leading-snug">{reason.title}</h3>
          <p class="mt-2 text-sm text-ink/70 leading-relaxed">{reason.body}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
