---
// src/components/sections/FeaturesSummary.astro
// Homepage features summary: the four-stage lifecycle explained in card
// form, plus a short "why lean, not bloated" strip pulled from the same
// positioning used in FAQAccordion's Comparisons category. Deep-dive
// copy stays on /features — this is the summary version.
//
// v2.1 card redesign (per user-supplied inspiration, CLAUDE.md Section 4.5):
// "how it works" cards move from the plain icon-chip layout to a numbered-
// badge + headline + bespoke per-card SVG illustration + floating chip
// layout. Structure/composition is from the inspiration reference
// (huzlly-how-it-works.html); palette stays on the sitewide ink/paper/rail
// + signal-color system so it reads as this site's design language, not a
// copy-pasted foreign look. Each card's illustration lives in its own
// component under ./how-it-works/ (GetStartedIllustration.astro,
// WorkIllustration.astro, GetPaidIllustration.astro, GrowIllustration.astro)
// — the shared Card/badge/headline/glow/chip/description markup below is
// written once and driven by the `stages` data array.
//
// Content note: copy moves from the granular automation-trigger framing
// (Proposal/Contract/Invoice/Project) to a 4-stage lifecycle framing
// (Get Started/Work/Get Paid/Grow), per explicit user direction — this is
// a deliberate content decision made with awareness that it diverges from
// SITE_IDENTITY_AND_AEO.md's canonical flow language; AEO/schema follow-up
// is being handled separately by the user, not silently reconciled here.
//
// Color note: the design system only defines three approved signal colors
// (blue-600 / teal-600 / amber-500) — see AutomationNotificationCard.astro's
// comment. Card 04 ("Grow") originally used the neutral ink/rail treatment
// instead of inventing a new hue, flagged per CLAUDE.md Section 3.
// User then explicitly requested Card 04 use a distinct color (green-600,
// from Tailwind's default palette) instead of the neutral ink treatment —
// this does deviate from AutomationNotificationCard.astro's 3-signal-color
// convention, per the user's direct instruction, not silently reconciled
// here. If that convention gets revisited, this card is the one to check.

import {
  FileText,
  PenTool,
  Rocket,
  FolderKanban,
  CheckSquare,
  Clock,
  Users,
  Receipt,
  CreditCard,
  Package,
  Archive,
  Repeat,
  Tag,
  Zap,
  Feather,
  Layers,
} from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import GetStartedIllustration from './how-it-works/GetStartedIllustration.astro';
import WorkIllustration from './how-it-works/WorkIllustration.astro';
import GetPaidIllustration from './how-it-works/GetPaidIllustration.astro';
import GrowIllustration from './how-it-works/GrowIllustration.astro';

// Full literal class strings per signal (Tailwind JIT needs literal
// substrings to detect classes — no template-literal color interpolation).
// chipBg pairs with `icon` to color each card's floating chip badges
// (e.g. blue chips = bg-blue-50 + text-blue-600).
//
// `glow` / `glowPos` drive the single ambient illustration-glow blob (see
// reference huzlly-how-it-works.html .illustration-glow rules) — one big
// radial-gradient contained to the illustration box (glowPos/inset resolve
// against that box's own dimensions, and its overflow-hidden clips the
// glow to its bounds — it does not spread across the rest of the card).
// Color fades from saturated to transparent, positioned differently per
// card. Tailwind's class:list can't express an arbitrary radial-gradient
// with a dynamic center + color, so this is applied via inline `style`
// instead of a class. `glow` is the actual saturated signal hex
// (blue-600/teal-600/amber-500/green-600, matching Tailwind's default
// palette — see tailwind.config.mjs), NOT the light -50 tints used for
// chipBg — light tints are what made the old corner blobs disappear under
// blur.
//
// `glowOpacity` is per-signal (not a shared Tailwind opacity-[…] class
// anymore). All four signals now sit at the reference's 0.28 — green-600 is
// a proper saturated color like blue/teal/amber, so it doesn't need the
// dialed-down opacity the old neutral-ink treatment needed.
const signalStyles: Record<string, { glow: string; glowPos: string; glowOpacity: string; icon: string; chipBg: string }> = {
  blue: { glow: '#2563eb', glowPos: '34% 38%', glowOpacity: '0.28', icon: 'text-blue-600', chipBg: 'bg-blue-50' },
  teal: { glow: '#0d9488', glowPos: '66% 30%', glowOpacity: '0.28', icon: 'text-teal-600', chipBg: 'bg-teal-50' },
  amber: { glow: '#f59e0b', glowPos: '34% 66%', glowOpacity: '0.28', icon: 'text-amber-500', chipBg: 'bg-amber-50' },
  green: { glow: '#16a34a', glowPos: '50% 50%', glowOpacity: '0.28', icon: 'text-green-600', chipBg: 'bg-green-50' },
};

// Common chip-pill classes, shared by every card. Sizing is intentionally
// mobile-first and compacts below the `sm:` breakpoint (Step 6 responsive
// pass) — at `sm:` and above every value matches the pre-refactor markup
// exactly (px-3 py-1.5 text-xs, h-5 w-5 icon circle, h-3 w-3 icon glyph,
// gap-1.5), so tablet/desktop look is unchanged. Below `sm:`, padding/
// gap/font/icon size step down one notch so chips don't crowd each other
// or the illustration on narrow phones (<400px).
//
// Untilt-chips split (this pass): each chip is now three nested elements
// instead of one, so its three motion sources never fight over the same
// element's `transform` — see the per-chip markup below for why each
// needs its own layer:
//   1. position layer  — absolute + chip.position + dp-reveal/direction
//   2. float layer      — chip-float-el (the idle bob keyframe animation)
//   3. pill layer        — chipClasses below + the hover-scale utilities
// `chipClasses` now holds ONLY the visual-pill + inner-layout styling
// (no more `chip-float-el`, `pointer-events-none`, or `absolute` — those
// moved to the position/float layers). Two motion sources can't safely
// share an element here: `.dp-reveal-left/-right`'s `!important` transform
// (see scroll-reveal.css) would silently freeze `chip-float-el`'s
// keyframe-driven transform if they were on the same element (identical
// mechanism to the Card.astro hover conflict documented there), and
// separately, a running CSS animation always overrides a same-property
// `:hover` transform on its own element regardless of specificity (author
// !important aside) — so `chip-float-el` and `hover:scale-*` can't safely
// share an element either. Three layers, three separate transforms,
// composing visually through normal parent/child nesting instead of all
// fighting for one `transform` property.
const chipClasses =
  'inline-flex items-center gap-1 sm:gap-1.5 whitespace-nowrap rounded-full border border-rail bg-paper/90 px-2 py-1 sm:px-3 sm:py-1.5 text-[11px] sm:text-xs font-medium text-ink shadow-sm backdrop-blur-sm transition-transform duration-200 ease-out hover:scale-105';
const chipIconWrapClasses = 'flex h-4 w-4 sm:h-5 sm:w-5 shrink-0 items-center justify-center rounded-full';
const chipIconGlyphClasses = 'h-2.5 w-2.5 sm:h-3 sm:w-3';

// One `chips` entry (Grow stage's "Repeat Work") uses a `translate-x-*`
// utility inside its `position` string (`bottom-4 left-1/2
// -translate-x-1/2`, for centering under a `left-1/2` anchor) — a
// transform, same as `dp-reveal-left/-right`'s `!important` transform.
// Unlike the chip-float-el/hover-scale case above, this one can't just
// move to its own layer arbitrarily: it has to land on the pill layer
// specifically (chipClasses' element), not the position layer, because
// Tailwind's translate/scale utilities all compose into one `transform`
// via shared `--tw-*` custom properties — so `-translate-x-1/2` sitting
// alongside `hover:scale-105` on that same pill layer composes safely
// (translate + hover-scale both apply together), whereas putting it on
// the position layer would collide with `dp-reveal-left/-right`'s
// hardcoded `!important` transform the same way `hover:scale-*` would.
// This helper splits any transform-utility tokens out of a chip's
// `position` string so they land on the pill layer while plain offset
// tokens (left/right/top/bottom/inset-*) stay on the position layer.
function splitChipPosition(position: string) {
  const tokens = position.split(' ');
  const transform = tokens.filter((t) => /^-?(translate|rotate|skew|scale)-/.test(t));
  const offset = tokens.filter((t) => !transform.includes(t));
  return { offset: offset.join(' '), transform: transform.join(' ') };
}

const stages = [
  {
    number: '01',
    stage: 'Get Started',
    headline: 'Turn prospects into projects.',
    body: 'Create professional proposals, get agreements signed, and set everything up to start working with your client.',
    signal: 'blue',
    illustration: GetStartedIllustration,
    chips: [
      { icon: FileText, label: 'Proposal', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: PenTool, label: 'Contract', position: 'right-4 top-16', delay: '0.6s' },
      { icon: Rocket, label: 'Project Setup', position: 'bottom-4 left-10', delay: '1.2s' },
    ],
  },
  {
    number: '02',
    stage: 'Work',
    headline: 'Manage every project in one place.',
    body: 'Organize projects and tasks, track your time, and keep clients updated with their own dedicated portal.',
    signal: 'teal',
    illustration: WorkIllustration,
    chips: [
      { icon: FolderKanban, label: 'Projects', position: 'left-3.5 top-3.5', delay: '0s' },
      { icon: CheckSquare, label: 'Tasks', position: 'right-4 top-12', delay: '0.4s' },
      { icon: Clock, label: 'Time Tracking', position: 'bottom-14 left-3', delay: '0.9s' },
      { icon: Users, label: 'Client Portal', position: 'bottom-4 right-8', delay: '1.3s' },
    ],
  },
  {
    number: '03',
    stage: 'Get Paid',
    headline: 'Finish the work. Get paid.',
    body: 'Send invoices, collect payments, and keep your billing organized from project completion to payment.',
    signal: 'amber',
    illustration: GetPaidIllustration,
    chips: [
      { icon: Receipt, label: 'Invoice', position: 'right-4 top-3.5', delay: '0s' },
      { icon: CreditCard, label: 'Payment', position: 'bottom-14 right-3.5', delay: '0.5s' },
      { icon: Package, label: 'Delivery', position: 'bottom-4 left-4', delay: '1s' },
    ],
  },
  {
    number: '04',
    stage: 'Grow',
    headline: 'Turn great work into repeat business.',
    body: 'Keep your client relationships, projects, and history organized so you can stay focused on growing your freelance business.',
    signal: 'green',
    illustration: GrowIllustration,
    chips: [
      { icon: Users, label: 'Clients', position: 'left-4 top-3.5', delay: '0s' },
      { icon: Archive, label: 'Past Projects', position: 'right-5 top-4', delay: '0.5s' },
      { icon: Repeat, label: 'Repeat Work', position: 'bottom-4 left-1/2 -translate-x-1/2', delay: '1s' },
    ],
  },
];

const reasons = [
  {
    icon: Feather,
    title: 'Nothing you don\u2019t use',
    body: 'Built for one freelancer running one flow, not a scaled-down version of enterprise software.',
  },
  {
    icon: Zap,
    title: 'Live in minutes',
    body: 'No consultant, no onboarding call. Connect your flow and it runs the same day.',
  },
  {
    icon: Tag,
    title: 'One flat price',
    body: 'No per-seat fees, no usage tiers to track. What you see is what you pay.',
  },
];

// Bottom quick-wins strip (v2.2 "Why lean" redesign, per user-supplied
// inspiration reference — asymmetric persona-card layout + a compact
// bottom strip of one-line wins). Per explicit user direction, this strip
// is the 3 `reasons` above restated as short scannable one-liners (same
// icon + title, description dropped) PLUS one net-new 4th item —
// "Everything in one place" — added specifically to cover the
// no-tool-switching / all-in-one angle that isn't covered by the existing
// 3 (which cover cost/speed/simplicity, not consolidation). Deliberately
// NOT four brand-new items: user confirmed "4th item" (singular addition),
// not a fully distinct second content set.
const quickWins = [
  { icon: Feather, label: 'Nothing you don\u2019t use' },
  { icon: Zap, label: 'Live in minutes' },
  { icon: Tag, label: 'One flat price' },
  { icon: Layers, label: 'Everything in one place' },
];
---

<!-- BACKGROUND (updated this pass): blue tint now starts easing in earlier
     (white hold trimmed from 10% to 5%) and reaches a denser/more
     saturated tint than before (#EAF1FC vs previous #F0F4FC end-stop,
     with the mid-stop #F2F7FE also bumped closer to that end tone) — per
     feedback that the tint should start higher up and read a bit stronger,
     while still holding a short pure-white band at the very top for the
     Hero seam. -->
<section id="how-it-works" class="scroll-mt-20 bg-[linear-gradient(180deg,#FFFFFF_0%,#FFFFFF_5%,#F2F7FE_40%,#EAF1FC_100%)] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <SectionHeader eyebrow="How it works"
      title="Four stages. Zero handoffs."
      subtitle="Each stage of your client relationship flows into the next automatically — you only touch what actually needs a human."
    />

    {/*
      v3 "how it works" restructure. Moves away from Card.astro's 4-up grid
      to 4 full-width horizontal rows, one per `stages` entry, each split
      into a ~60% text column and a ~40% illustration-box column, with a
      thin `border-t border-rail` divider between consecutive rows.
      Card.astro itself is untouched — it's still used elsewhere (the "why
      lean" reasons cards below, and other pages) — this section just
      stops importing/rendering it.

      Zigzag: even index (stages 1 & 3, i.e. index 0 & 2) put text on the
      left / illustration box on the right at `lg:`; odd index (stages 2 &
      4, i.e. index 1 & 3) flip that. Mobile always shows the illustration
      box above the text regardless of which stage it is — done with
      `order-1`/`order-2` as the base (mobile-first) ordering, then only
      the even-index rows need an `lg:` override to swap text back to
      order-1/left; the odd-index rows already match the mobile order, so
      no `lg:` override is needed there (see inline comment below).

      Illustration column (this pass): the glow span / <Illustration /> /
      floating-chips markup is the same logic the old Card-based version
      used — `signalStyles`, `chipClasses`, `chipIconWrapClasses`,
      `chipIconGlyphClasses`, and each stage's `illustration`/`chips`
      fields are unchanged, just reconnected inside the new row layout
      instead of inside a Card. Reveal direction alternates by row index
      the same way it alternated by grid column before.

      Untilt-chips split (this pass): the illustration box is no longer
      one `js-tilt-card` div wrapping everything — it's now an outer
      `relative` box (no tilt/reveal of its own) holding two kinds of
      children: the glow + `<Illustration />`, wrapped in their own
      `js-tilt-card`+`dp-reveal` div; and the chips, as siblings of that
      div instead of children of it. Chips previously tilted rigidly with
      the illustration since they shared its `js-tilt-card`; now they sit
      outside it, so mouse-tilt only ever applies to the illustration.
      Each chip still gets its own `dp-reveal`/`dp-reveal-left`/
      `dp-reveal-right` scroll-in (not just the illustration), plus an
      idle float and a hover-grow — see the `chipClasses` comment near
      the top of this file for why each chip needs 3 nested layers
      instead of 1 to keep those three transforms from fighting each
      other. Not on the row wrapper and not on the text column, which
      both stay static per prior decision.
    */}
    <div class="mt-14">
      {stages.map((step, index) => {
        const s = signalStyles[step.signal];
        const Illustration = step.illustration;
        const isEven = index % 2 === 0;
        const revealDirection = index % 2 === 0 ? 'dp-reveal-left' : 'dp-reveal-right';

        return (
          <div class="border-t border-rail py-14 first:border-t-0 first:pt-0 sm:py-16">
            <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-16">
              {/* Text column: ~60% width on desktop. No animation classes
                  here — this column stays static per this step's scope. */}
              <div
                class={`order-2 flex flex-col justify-center lg:w-[60%] lg:shrink-0 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}
              >
                <div class="flex items-center gap-4">
                  <span
                    class="font-display text-7xl font-semibold leading-none text-transparent [-webkit-text-stroke:1.5px_#14110f4d] sm:text-8xl"
                  >
                    {step.number}.
                  </span>
                  <span
                    class="h-1 w-10 shrink-0 rounded-full"
                    style={`background-color: ${s.glow}`}
                    aria-hidden="true"
                  ></span>
                </div>

                <h3 class="mt-5 font-display text-2xl font-semibold leading-snug text-ink sm:text-3xl">
                  {step.headline}
                </h3>

                <p class="mt-4 max-w-lg text-base leading-relaxed text-ink/70">{step.body}</p>
              </div>

              {/* Illustration column: ~40% width on desktop. `js-tilt-card`
                  lives on the illustration wrapper two levels down (see
                  below), scoped to just the glow+Illustration, not the
                  row/text column and not the chips — same reasoning as
                  the prior Card-based version (see the <script> comment
                  below): `tilt-card.ts` sets `transform` directly on
                  mousemove, and detects `dp-reveal` on that same element
                  to switch to writing `--tilt-rx/-ry/-scale` custom
                  properties instead so `scroll-reveal.css`'s
                  `.dp-reveal-left/-right` rules can compose the slide-in
                  translate with the live tilt. No `overflow-hidden`/
                  `rounded-xl`/background anywhere in this column (per
                  explicit direction) — there's no visible boxed container
                  around the glow/illustration/chips, so the glow-pulse-el
                  blur bleeds outward past the old box edges instead of
                  being clipped to them; `relative` on the outer box below
                  still gives the glow/illustration/chips their shared
                  positioning context. */}
              <div
                class={`order-1 lg:w-[40%] lg:shrink-0 ${isEven ? 'lg:order-2' : 'lg:order-1'}`}
              >
                {/* Outer box: just the positioning context + sizing now —
                    no tilt, no reveal of its own. Holds two kinds of
                    children: the tilt+reveal illustration wrapper below,
                    and the chips (siblings of it, not descendants), so
                    the chips no longer inherit the illustration's
                    mouse-tilt rotation. */}
                <div class="relative h-56 sm:h-64 lg:h-72">
                  {/* Illustration wrapper: keeps js-tilt-card + dp-reveal
                      together (tilt-card.ts requires both on the same
                      element — see its `classList.contains('dp-reveal')`
                      check — to compose tilt into the reveal transform
                      instead of fighting it). `absolute inset-0` fills
                      the outer box exactly like the old single div's own
                      `h-56 sm:h-64 lg:h-72` did, just one level down. */}
                  <div
                    class={`dp-reveal ${revealDirection} js-tilt-card absolute inset-0`}
                  >
                    <span
                      class="glow-pulse-el pointer-events-none absolute inset-[-10%] z-0 rounded-full blur-[46px]"
                      style={`background: radial-gradient(circle at ${s.glowPos}, ${s.glow} 0%, transparent 48%); opacity: ${s.glowOpacity};`}
                      aria-hidden="true"
                    ></span>

                    <Illustration />
                  </div>

                  {/* Chips: siblings of the tilt/illustration wrapper, so
                      they float independently instead of tilting rigidly
                      with it. Each is 3 nested layers — see the
                      `chipClasses`/`splitChipPosition` comments above for
                      why, and why a chip's own `position` string gets
                      split across two of those layers rather than sitting
                      on one. */}
                  {step.chips.map((chip) => {
                    const { offset, transform } = splitChipPosition(chip.position);
                    return (
                      <div
                        class:list={['pointer-events-none absolute', offset, 'dp-reveal', revealDirection]}
                      >
                        <div class="chip-float-el inline-block" style={`animation-delay: ${chip.delay}`}>
                          <div class:list={[chipClasses, transform]}>
                            <span class:list={[chipIconWrapClasses, s.chipBg, s.icon]}>
                              <chip.icon class={chipIconGlyphClasses} stroke-width="2.2" />
                            </span>
                            {chip.label}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- Mouse-follow 3D tilt + scroll-scrub reveal — see the `js-tilt-card`
     and `dp-reveal`/`dp-reveal-left`/`dp-reveal-right` notes on the
     illustration box above. Both scoped to just those 4 illustration
     boxes (`#how-it-works .dp-reveal` / `#how-it-works .js-tilt-card`),
     not the row wrapper, not the text column, and not the 3 "why lean"
     reason cards below, which keep their existing plain elevated-card
     hover with no reveal. tilt-card.ts / scroll-reveal.ts themselves are
     unchanged (out of scope for this pass) — same extraction pattern,
     both reused as-is from HeroDashboardPreview. `completionFraction: 0.7`
     matches HeroDashboardPreview's own bento-card setup exactly, same as
     before the row restructure. Tilt intensity (`maxTilt`/`scale`) is
     bumped above the library defaults for just this call — see the note
     on the `initTiltCard` call itself below for the current values and
     why.

     `initTiltCard` below is scoped to `'#how-it-works .js-tilt-card'`
     rather than the bare `.js-tilt-card` class — this illustration box
     has no background/border/overflow-hidden anymore (per the earlier
     change that let the glow spread freely instead of being boxed in),
     so tilt-card.ts's directional lifted box-shadow (see its own header
     comment) would otherwise render as a stray visible rectangle with
     nothing else to justify it. `{ shadowMaxOffset: 0, shadowBlur: 0 }`
     zeroes that shadow out for just this call (tilt-card.ts always writes
     SOME box-shadow value — see `applyTilt`/`resetTilt` — so 0/0 is what
     makes it fully invisible rather than omitting the option, which would
     fall back to the 22px/36px defaults). Scoping the selector to
     `#how-it-works` also means any options change here can't affect any
     other `.js-tilt-card` element elsewhere on the site (e.g.
     HeroDashboardPreview), which still gets its own call with the
     library defaults.

     `maxTilt: 17` / `scale: 1.25` (this call only, per explicit request
     for a more pronounced hover effect on just this illustration box) —
     up from the library defaults of 10 / 1.03 that this call used to rely
     on implicitly. trackMs/leaveMs/perspective are left at their defaults
     (150ms / 600ms / 800px); the larger rotation/scale didn't need a
     different easing duration to stay smooth in testing, and per the
     scoping above, changing them here still can't touch any other
     `.js-tilt-card` caller. tilt-card.ts itself is unchanged. -->
<script>
  import { initTiltCard } from '../../scripts/tilt-card';
  import { initScrollReveal } from '../../scripts/scroll-reveal';

  initTiltCard('#how-it-works .js-tilt-card', { maxTilt: 17, scale: 1.25, shadowMaxOffset: 0, shadowBlur: 0 });
  initScrollReveal('#how-it-works .dp-reveal', { completionFraction: 0.7 });
</script>

<!--
  v2.2 "Why lean" redesign (per user-supplied inspiration, discussed and
  confirmed before build): moves from the centered SectionHeader + flat
  3-up grid to a left copy / right asymmetric-card layout (1 wide card on
  top, 2 half-width cards below), plus a new full-width 4-item quick-wins
  strip beneath. Structure/composition borrowed from the inspiration
  reference (persona-card layout with a top visual block + text below,
  bottom icon+label strip) — palette stays entirely on the sitewide
  ink/paper/rail + blue-600 signal color, no imported gradient hues, so it
  reads as this site's design language rather than a copy-pasted look.

  Left column is NOT built with the shared SectionHeader component this
  time — SectionHeader is a centered-only pattern (see its own
  `mx-auto ... text-center` wrapper) and this layout needs a left-aligned
  eyebrow/heading/subtitle stacked beside the cards, not above them. Markup
  below intentionally mirrors SectionHeader's type scale/eyebrow styling by
  hand so it still reads as the same header pattern, just left-aligned.
-->
<section class="bg-[linear-gradient(180deg,#EAF1FC_0%,#F2F7FE_60%,#FFFFFF_100%)] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="lg:col-span-2">
        <span class="inline-flex items-center rounded-full border border-rail bg-paper px-3 py-1 font-mono text-xs uppercase tracking-widest text-blue-600">
          Why lean
        </span>
        <h2 class="font-display mt-4 text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
          Built for one freelancer, not a whole team
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-ink/70">
          Bonsai and HoneyBook grew into agency platforms. Huzlly stayed built for the person doing the work.
        </p>
      </div>

      <div class="lg:col-span-3">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {reasons.map((reason, index) => (
            <Card variant="elevated" class={index === 0 ? 'sm:col-span-2' : ''}>
              {/*
                Visual block: same containment technique as the
                "how it works" illustration boxes above (overflow-hidden
                rounded-xl + a radial-gradient glow via inline `style`,
                Tailwind can't express an arbitrary-position radial
                gradient as a class) — but deliberately a single fixed
                blue-600 glow across all 3 cards here, not per-card signal
                colors, per explicit user direction (this section reads as
                one consistent group, not 3 differently-themed stages like
                "how it works").
              */}
              <div class="relative h-32 overflow-hidden rounded-xl bg-gradient-to-b from-paper to-white sm:h-40">
                <span
                  class="pointer-events-none absolute inset-[-10%] rounded-full blur-[46px]"
                  style="background: radial-gradient(circle at 50% 50%, #2563eb 0%, transparent 55%); opacity: 0.18;"
                  aria-hidden="true"
                ></span>
                <span class="relative z-10 flex h-full items-center justify-center">
                  <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink text-paper">
                    <reason.icon class="h-6 w-6" stroke-width="1.75" />
                  </span>
                </span>
              </div>
              <h3 class="mt-5 text-xl font-semibold leading-snug text-ink">{reason.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{reason.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:mt-12">
      {quickWins.map((item) => (
        <div class="flex flex-col items-start gap-3 rounded-2xl border border-rail bg-paper p-5">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-paper">
            <item.icon class="h-5 w-5" stroke-width="1.75" />
          </span>
          <p class="text-sm font-medium leading-snug text-ink">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
