---
// src/components/sections/FeaturesSummary.astro
// Homepage features summary: the four-step flow explained in card form,
// plus a short "why lean, not bloated" strip pulled from the same
// positioning used in FAQAccordion's Comparisons category. Deep-dive
// copy stays on /features — this is the summary version.
//
// v2 redesign pass: cards move to the ink/paper/rail neutral system, the
// 4-card step grid uses Card's new `flat-lift` + tick-mark treatment (the
// design system's "feature/process card" pairing), and section backgrounds
// invert per Section 4's rhythm — Paper is now the base, White is the
// occasional crisp break, rather than the old White/warm-50 pairing.

import { FileText, PenTool, Receipt, FolderKanban, Tag, Zap, Feather } from 'lucide-astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';

const steps = [
  {
    icon: FileText,
    title: 'Proposal',
    body: 'Send a proposal. The moment a client approves it, the rest of the flow kicks off on its own.',
  },
  {
    icon: PenTool,
    title: 'Contract',
    body: 'A contract goes out pre-filled with the approved scope, ready to sign — no re-typing, no separate app.',
  },
  {
    icon: Receipt,
    title: 'Invoice',
    body: 'Accepting the contract sends the linked invoice straight to your client — no manual step in between.',
  },
  {
    icon: FolderKanban,
    title: 'Project',
    body: 'The same moment, Huzlly creates the project — scoped and ready for you to start logging work.',
  },
];

const reasons = [
  {
    icon: Feather,
    title: 'Nothing you don\u2019t use',
    body: 'Built for one freelancer running one flow, not a scaled-down version of enterprise software.',
  },
  {
    icon: Zap,
    title: 'Live in minutes',
    body: 'No consultant, no onboarding call. Connect your flow and it runs the same day.',
  },
  {
    icon: Tag,
    title: 'One flat price',
    body: 'No per-seat fees, no usage tiers to track. What you see is what you pay.',
  },
];
---

<section id="how-it-works" class="scroll-mt-20 bg-[linear-gradient(180deg,#D3E0F9_0%,#EEF3FC_18%,#FFFFFF_55%)] px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow="How it works"
      title="Four steps. Zero handoffs."
      subtitle="Each step in your client workflow triggers the next one automatically — you only touch what actually needs a human."
    />

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <Card variant="flat-lift" tick>
          <span class="font-mono text-xs text-blue-600/70">{String(i + 1).padStart(2, '0')}</span>
          <span class="mt-3 flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <step.icon class="w-5 h-5" stroke-width="1.75" />
          </span>
          <h3 class="mt-4 text-xl font-semibold text-ink leading-snug">{step.title}</h3>
          <p class="mt-2 text-sm text-ink/70 leading-relaxed">{step.body}</p>
        </Card>
      ))}
    </div>
  </div>
</section>

<section class="bg-paper px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow="Why lean"
      title="Built for one freelancer, not a whole team"
      subtitle="Bonsai and HoneyBook grew into agency platforms. Huzlly stayed built for the person doing the work."
    />

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {reasons.map((reason) => (
        <Card variant="elevated" class="text-center sm:text-left">
          <span class="mx-auto sm:mx-0 flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-paper">
            <reason.icon class="w-5 h-5" stroke-width="1.75" />
          </span>
          <h3 class="mt-4 text-xl font-semibold text-ink leading-snug">{reason.title}</h3>
          <p class="mt-2 text-sm text-ink/70 leading-relaxed">{reason.body}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
