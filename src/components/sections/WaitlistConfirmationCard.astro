---
// src/components/sections/WaitlistConfirmationCard.astro
// Used only on src/pages/waitlist.astro, alongside WaitlistFormCard.astro
// — together they replace the single WaitlistSplitCard.astro. This
// component is "screen 2": the post-submit "what happens now?" stepper
// panel, swapped in for WaitlistFormCard.astro on successful submit (see
// the page-level script in waitlist.astro), or shown directly on load if
// the visitor already has the `huzlly_waitlist_joined` cookie set.
//
// ASTRO SCOPING NOTE: this panel's leave/enter transition is driven from
// waitlist.astro's page-level <script> via `classList.add('screen-leave'
// | 'screen-enter')`, referencing the keyframes `screen-leave` /
// `screen-enter` by name. Astro scopes (renames) `@keyframes` names
// declared inside a component's own <style> block by default; the
// `animation` property on the *matching* class in the *same* style block
// gets rewritten to the renamed name automatically, so the class-based
// usage here is internally consistent on its own. They're still declared
// with the `-global-` prefix (duplicating the same keyframes also defined
// in WaitlistFormCard.astro) to keep one literal, page-wide name for both
// components' usages — WaitlistFormCard.astro's script also drives this
// panel indirectly via `switchScreens()`, and duplicating avoids any
// dependency on which component's <style> block the browser happens to
// process/keep first.
import { Check, MailCheck, Users, Rocket, Compass } from 'lucide-astro';
import Button from '../ui/Button.astro';

// "What happens now?" stepper — shown in place of the form card once the
// waitlist form succeeds (or immediately, if the visitor already joined).
// Uses the DESIGN_SYSTEM.md signal-color trio (blue-600 / teal-600 /
// amber-500) for the three step icons instead of the reference
// screenshot's purple/cyan/pink, so it stays on-brand.
const nextSteps = [
  { icon: MailCheck, title: 'Confirmation sent', desc: "Check your inbox — we've just emailed you a confirmation.", gradient: 'from-blue-500 to-blue-600' },
  { icon: Users, title: "You're queued", desc: 'One of 50 spots this cohort — requests are reviewed in order.', gradient: 'from-teal-500 to-teal-600' },
  { icon: Rocket, title: 'Invite on opening', desc: "We'll email the moment your spot opens — no need to check back.", gradient: 'from-amber-500 to-amber-600' },
];
---

<!-- "What happens now?" panel — swapped in for #waitlist-split-card on
     successful submit (see script in waitlist.astro). Same slot, same
     footprint, centered stepper instead of the two-column form layout. -->
<div id="waitlist-next-steps" class="next-steps hidden relative mx-auto w-full max-w-3xl flex-col items-center rounded-3xl border border-rail bg-white px-8 py-14 text-center sm:px-14 sm:py-16">
  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
    <Check class="w-6 h-6" stroke-width="2" />
  </span>
  <h2 class="mt-5 font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink" id="waitlist-success-title">
    You're on the list.
  </h2>
  <p class="text-pretty mt-3 text-ink/70 max-w-sm">Here's what happens now.</p>

  <div class="mt-12 flex w-full flex-col items-center gap-10 sm:flex-row sm:items-start sm:justify-center sm:gap-2">
    {nextSteps.map((step, i) => (
      <>
        <div class="flex flex-col items-center gap-4 sm:w-40">
          <span class={`flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${step.gradient} text-white shadow-sm`}>
            <step.icon class="w-6 h-6" stroke-width="1.75" />
          </span>
          <div>
            <p class="font-display text-base font-semibold text-ink">{step.title}</p>
            <p class="mt-1 text-sm text-ink/70 leading-snug">{step.desc}</p>
          </div>
        </div>
        {i < nextSteps.length - 1 && (
          <div class="hidden shrink sm:flex sm:w-12 items-center justify-center pt-7" aria-hidden="true">
            <svg width="100%" height="2" viewBox="0 0 48 2" preserveAspectRatio="none">
              <line x1="0" y1="1" x2="48" y2="1" stroke="#E4E0D8" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round" />
            </svg>
          </div>
        )}
      </>
    ))}
  </div>

  <div class="mx-auto mt-12 w-full max-w-xs" aria-hidden="true">
    <div class="h-px w-full bg-rail"></div>
  </div>

  <Button href="/features" variant="accent" class="group mt-6" ariaLabel="Explore Huzlly features">
    <Compass class="w-3.5 h-3.5 transition-transform group-hover:rotate-45" stroke-width="1.75" />
    Explore features
  </Button>

  <button type="button" id="waitlist-go-back" class="mt-3 text-xs font-medium text-ink/50 underline-offset-2 hover:text-ink/70 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600/20 rounded">
    Go back
  </button>
</div>

<style>
  /* One-shot fade-up, triggered the moment this panel is unhidden via JS
     rather than on page load. (Not currently added by the page script —
     preserved from the original component as-is.) */
  .next-steps.is-entering {
    opacity: 0;
    transform: translateY(10px);
    animation: -global-split-card-in 0.9s ease-out forwards;
  }
  @keyframes -global-split-card-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next-steps.is-entering {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* Screen-to-screen transition (JS-triggered via switchScreens() in
     waitlist.astro). Used for this panel's leave/enter in both
     directions (submit → next-steps, "Go back" → split-card). */
  .screen-leave {
    animation: -global-screen-leave 0.4s ease-in forwards;
  }
  .screen-enter {
    animation: -global-screen-enter 0.6s ease-out forwards;
  }
  @keyframes -global-screen-leave {
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes -global-screen-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen-leave,
    .screen-enter {
      animation: none;
    }
  }
</style>
