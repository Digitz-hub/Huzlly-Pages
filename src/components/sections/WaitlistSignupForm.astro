---
// src/components/sections/WaitlistSignupForm.astro
// Full waitlist signup form (name + email) — used only on src/pages/waitlist.astro.
// The homepage CTA stays on the lighter, email-only WaitlistForm.astro.
// Submits to the same functions/api/waitlist.js endpoint, which accepts
// an optional `name` field.
// v2 redesign pass: ink/paper/rail palette replaces gray-*; form inputs
// move from rounded-lg/gray-300 to rounded-xl/border-rail; submit button
// reuses the ui/ Button primitive instead of hand-rolled markup, per
// CLAUDE.md Section 2's "always use the primitive" rule. Client-side JS
// logic (submit handling, success/error states) is unchanged.

import { ArrowRight, Check } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
---

<section class="bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <Card variant="highlighted" class="p-8 sm:p-12 text-center">
      <Badge variant="beta" class="mx-auto">50 spots this cohort</Badge>

      <h2 class="mt-5 font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
        Get early access
      </h2>
      <p class="mt-4 text-ink/70 leading-relaxed max-w-md mx-auto">
        Tell us who you are and we'll email you the moment a spot opens — no sales
        calls, no spam, unsubscribe any time.
      </p>

      <form id="waitlist-signup-form" class="mt-8 flex flex-col gap-4 max-w-sm mx-auto text-left" novalidate>
        <div>
          <label for="waitlist-name" class="mb-1.5 block text-sm font-medium text-ink/70">Name</label>
          <input id="waitlist-name"
            name="name"
            type="text"
            required
            placeholder="Jordan Rivera"
            autocomplete="name"
            class="w-full rounded-xl border border-rail bg-paper px-4 py-2.5 text-sm text-ink placeholder:text-ink/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          />
        </div>

        <div>
          <label for="waitlist-signup-email" class="mb-1.5 block text-sm font-medium text-ink/70">Email</label>
          <input id="waitlist-signup-email"
            name="email"
            type="email"
            required
            placeholder="you@studio.com"
            autocomplete="email"
            class="w-full rounded-xl border border-rail bg-paper px-4 py-2.5 text-sm text-ink placeholder:text-ink/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          />
        </div>

        <!-- Honeypot: hidden from real visitors, irresistible to bots that fill every field. -->
        <div class="sr-only" aria-hidden="true">
          <label for="waitlist-signup-company">Company</label>
          <input id="waitlist-signup-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <Button type="submit" size="default" class="mt-2 disabled:opacity-60 disabled:cursor-not-allowed" ariaLabel="Join waitlist">
          Join waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </Button>
      </form>

      <p id="waitlist-signup-error" class="mt-3 text-sm text-red-600 hidden"></p>

      <div id="waitlist-signup-success" class="mt-8 hidden flex-col items-center gap-2">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
          <Check class="w-5 h-5" stroke-width="2" />
        </span>
        <p class="text-sm font-semibold text-ink" id="waitlist-signup-success-title">You're on the list.</p>
        <p class="text-sm text-ink/70">We'll email you when your spot opens up.</p>
      </div>
    </Card>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-signup-form');
  const errorEl = document.getElementById('waitlist-signup-error');
  const successEl = document.getElementById('waitlist-signup-success');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const successTitle = document.getElementById('waitlist-signup-success-title');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(message) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  function showSuccess(duplicate) {
    if (successTitle) {
      successTitle.textContent = duplicate ? "You're already on the list." : "You're on the list.";
    }
    form?.classList.add('hidden');
    successEl?.classList.remove('hidden');
    successEl?.classList.add('flex');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');

    const nameInput = document.getElementById('waitlist-name') as HTMLInputElement;
    const emailInput = document.getElementById('waitlist-signup-email') as HTMLInputElement;
    const companyInput = document.getElementById('waitlist-signup-company') as HTMLInputElement;
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();

    if (!name) {
      showError('Enter your name to join the waitlist.');
      return;
    }
    if (!EMAIL_RE.test(email)) {
      showError('Enter a valid email address to join the waitlist.');
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, email, company: companyInput ? companyInput.value : '' }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showError('Something went wrong on our end — try again in a moment.');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      showSuccess(Boolean(data.duplicate));
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
