---
// src/components/sections/WaitlistSignupForm.astro
// Full waitlist signup form (name + email) — used only on src/pages/waitlist.astro.
// The homepage CTA stays on the lighter, email-only WaitlistForm.astro.
// Submits to the same functions/api/waitlist.js endpoint, which accepts
// an optional `name` field.

import { ArrowRight, Check } from 'lucide-astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
---

<section class="bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <Card variant="highlighted" class="p-8 sm:p-12 text-center">
      <Badge variant="beta" class="mx-auto">50 spots this cohort</Badge>

      <h2 class="mt-5 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
        Get early access
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed max-w-md mx-auto">
        Tell us who you are and we'll email you the moment a spot opens — no sales
        calls, no spam, unsubscribe any time.
      </p>

      <form id="waitlist-signup-form" class="mt-8 flex flex-col gap-4 max-w-sm mx-auto text-left" novalidate>
        <div>
          <label for="waitlist-name" class="mb-1.5 block text-sm font-medium text-gray-700">Name</label>
          <input
            id="waitlist-name"
            name="name"
            type="text"
            required
            placeholder="Jordan Rivera"
            autocomplete="name"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
          />
        </div>

        <div>
          <label for="waitlist-signup-email" class="mb-1.5 block text-sm font-medium text-gray-700">Email</label>
          <input
            id="waitlist-signup-email"
            name="email"
            type="email"
            required
            placeholder="you@studio.com"
            autocomplete="email"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
          />
        </div>

        <!-- Honeypot: hidden from real visitors, irresistible to bots that fill every field. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="waitlist-signup-company">Company</label>
          <input id="waitlist-signup-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          id="waitlist-signup-submit"
          class="mt-2 inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 active:bg-gray-950 transition-colors duration-200 ease-in-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Join waitlist
          <ArrowRight class="w-4 h-4" stroke-width="1.75" />
        </button>
      </form>

      <p id="waitlist-signup-error" class="mt-3 text-sm text-red-600 hidden"></p>

      <div id="waitlist-signup-success" class="mt-8 hidden flex-col items-center gap-2">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
          <Check class="w-5 h-5" stroke-width="2" />
        </span>
        <p class="text-sm font-semibold text-gray-900" id="waitlist-signup-success-title">You're on the list.</p>
        <p class="text-sm text-gray-600">We'll email you when your spot opens up.</p>
      </div>
    </Card>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-signup-form');
  const errorEl = document.getElementById('waitlist-signup-error');
  const successEl = document.getElementById('waitlist-signup-success');
  const submitBtn = document.getElementById('waitlist-signup-submit');
  const successTitle = document.getElementById('waitlist-signup-success-title');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(message) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  function showSuccess(duplicate) {
    if (successTitle) {
      successTitle.textContent = duplicate ? "You're already on the list." : "You're on the list.";
    }
    form?.classList.add('hidden');
    successEl?.classList.remove('hidden');
    successEl?.classList.add('flex');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');

    const nameInput = document.getElementById('waitlist-name');
    const emailInput = document.getElementById('waitlist-signup-email');
    const companyInput = document.getElementById('waitlist-signup-company');
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();

    if (!name) {
      showError('Enter your name to join the waitlist.');
      return;
    }
    if (!EMAIL_RE.test(email)) {
      showError('Enter a valid email address to join the waitlist.');
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, email, company: companyInput ? companyInput.value : '' }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        showError('Something went wrong on our end — try again in a moment.');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      showSuccess(Boolean(data.duplicate));
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
