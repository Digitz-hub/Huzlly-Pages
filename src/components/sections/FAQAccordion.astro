---
import { Plus, Minus } from 'lucide-astro';

export interface FAQItem {
  question: string;
  answer: string; // may contain inline <a> markup per PAGE_MAP_AND_SEO.md contextual linking rules
}

export interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 max-w-6xl mx-auto mt-10">
  {items.map((item) => (
    <details class="group rounded-2xl bg-gray-50/70 hover:bg-gray-100/80 border border-transparent p-5 sm:p-6 transition-all duration-200 cursor-pointer [&::-webkit-details-marker]:hidden">
      <summary class="flex items-center justify-between text-left font-semibold text-gray-900 text-base sm:text-lg gap-4 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">
        <span>
          {item.question}
        </span>
        <span class="flex-shrink-0">
          <Plus class="w-5 h-5 text-blue-600 flex-shrink-0 group-open:hidden" stroke-width="1.75" />
          <Minus class="w-5 h-5 text-blue-600 flex-shrink-0 hidden group-open:block" stroke-width="1.75" />
        </span>
      </summary>
      <div class="mt-3 text-sm sm:text-base text-gray-600 leading-relaxed font-normal [&_a]:text-blue-600 [&_a]:hover:text-blue-700 [&_a]:font-semibold [&_a]:transition-colors [&_a]:duration-200 [&_a]:ease-in-out [&_a]:focus-visible:outline [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-offset-2 [&_a]:focus-visible:outline-gray-900"
        set:html={item.answer}
      />
    </details>
  ))}
</div>
