---
import { Plus, Minus } from 'lucide-astro';

export interface FAQItem {
  question: string;
  answer: string;
  category: string;
  linkHref?: string;
  linkText?: string;
}

export interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item) => (
    <details class="group rounded-lg border border-gray-200 bg-white p-6" data-category={item.category}>
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-4 text-left [&::-webkit-details-marker]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
      >
        <span class="text-xl font-semibold text-gray-900 leading-snug">{item.question}</span>
        <span class="flex-shrink-0">
          <Plus class="w-5 h-5 text-blue-600 group-open:hidden" stroke-width="1.75" />
          <Minus class="w-5 h-5 text-blue-600 hidden group-open:block" stroke-width="1.75" />
        </span>
      </summary>
      <div class="mt-4 text-base text-gray-600 leading-relaxed">
        <p>{item.answer}</p>
        {item.linkHref && item.linkText && (
          
            href={item.linkHref}
            class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors duration-200 ease-in-out"
          >
            {item.linkText}
          </a>
        )}
      </div>
    </details>
  ))}
</div>
