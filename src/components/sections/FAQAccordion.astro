---
// src/components/sections/FAQAccordion.astro

import { Plus, Minus } from 'lucide-astro';

export interface FAQItem {
  question: string;
  answer: string; // may contain inline <a> markup per PAGE_MAP_AND_SEO.md contextual linking rules
}

export interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div>
  {items.map((item) => (
    <details class="group rounded-2xl bg-rail/10 hover:bg-rail/20 border border-rail p-5 sm:p-6 mb-4 transition-all duration-200 cursor-pointer [&::-webkit-details-marker]:hidden">
      <summary class="flex items-center justify-between text-left font-semibold text-ink text-base sm:text-lg gap-4 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
        <span>
          {item.question}
        </span>
        <span class="flex-shrink-0">
          <Plus class="w-5 h-5 text-blue-600 flex-shrink-0 group-open:hidden" stroke-width="1.75" />
          <Minus class="w-5 h-5 text-blue-600 flex-shrink-0 hidden group-open:block" stroke-width="1.75" />
        </span>
      </summary>
      <div class="mt-3 text-sm sm:text-base text-ink/70 leading-relaxed font-normal [&_a]:text-blue-600 [&_a]:hover:text-blue-700 [&_a]:font-semibold [&_a]:transition-colors [&_a]:duration-200 [&_a]:ease-in-out [&_a]:focus-visible:outline [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-offset-2 [&_a]:focus-visible:outline-ink"
        set:html={item.answer}
      />
    </details>
  ))}
</div>
