---
// ==========================================
// 1. FRONTMATTER & SEO CONFIGURATION (Astro Component Logic)
// ==========================================
// Claude ko bolna: "Is page ke title aur meta description ko Huzlly ke primary business keywords ke hisab se optimize karo."
import Layout from '../layouts/Layout.astro';

const pageTitle = "Huzlly - [Apna Main Headline / Value Proposition Yahan Likhein]";
const pageDescription = "Huzlly helps [Target Audience] achieve [Primary Goal]. High-performance solutions built for scale.";
---

<!-- ==========================================
2. MAIN PAGE LAYOUT WRAPPER
Layout.astro automatically contains:
- Primary Meta Tags & OpenGraph Tags
- Structured JSON-LD Schema
- Navigation Header & Footer
========================================== -->
<Layout title={pageTitle} description={pageDescription}>

  <main>
    <!-- HERO SECTION: Main headline, subheadline aur primary call-to-action (CTA) buttons yahan aayenge -->
    <section id="hero">
      <!-- <h1>: Page ka primary target keyword hamesha isme aana chahiye -->
      <h1>[Main Business Headline / Hook]</h1>
      <p>[Short supporting paragraph explaining the exact product or service]</p>
      
      <!-- Action Buttons -->
      <div>
        <a href="/pricing">[Primary CTA - e.g., Get Started / Book Demo]</a>
        <a href="/about">[Secondary CTA - Learn More]</a>
      </div>
    </section>

    <!-- VALUE PROPOSITION / FEATURES SECTION: Key benefits aur highlights -->
    <section id="features">
      <h2>[Why Choose Huzlly / Core Benefits]</h2>
      <!-- Claude se grid cards ya 3-column value props generate karwayenge -->
    </section>

    <!-- SOCIAL PROOF / TESTIMONIALS / FAQ SECTION: Trust building content -->
    <section id="social-proof">
      <!-- Reviews, client metrics ya FAQs yahan rahenge -->
    </section>

    <!-- FINAL CTA SECTION: Bottom conversion banner -->
    <section id="final-cta">
      <h2>[Ready to scale your business?]</h2>
      <a href="/contact">[Contact Us / Sign Up]</a>
    </section>
  </main>

</Layout>

<!-- ==========================================
3. PAGE-SPECIFIC SCOPED CSS STYLING
Astro me yeh styling sirf isi page par apply hogi, baaki pages affect nahi honge.
========================================== -->
<style>
  /* Claude ko bolna: "Modern dark-themed CSS styling with responsive flex/grid layouts yahan add karo" */
</style>
