---
const { title = "Huzlly - Modern Web", description = "Digital solutions by Huzlly" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; font-family: system-ui, sans-serif; }
      body { background-color: #0d1117; color: #e6edf3; min-height: 100vh; display: flex; flex-direction: column; }
      header { display: flex; justify-content: space-between; padding: 20px 8%; border-bottom: 1px solid #30363d; }
      .logo { font-size: 1.5rem; font-weight: bold; color: #58a6ff; text-decoration: none; }
      nav a { color: #8b949e; text-decoration: none; margin-left: 20px; }
      footer { margin-top: auto; text-align: center; padding: 25px; border-top: 1px solid #30363d; color: #8b949e; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo">Huzlly.</a>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/pricing">Pricing</a>
      </nav>
    </header>

    <slot />

    <footer>
      <p>© 2026 Huzlly. All rights reserved.</p>
    </footer>
  </body>
</html>
