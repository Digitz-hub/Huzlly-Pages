---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Huzlly - Modern Digital Solutions",
  description = "Fast, SEO-optimized digital solutions tailored to scale your brand efficiently.",
  image = "/favicon.svg",
} = Astro.props;

const siteTitle = title.includes("Huzlly") ? title : `${title} | Huzlly`;
const siteUrl = "https://huzlly-pages.pages.dev";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteUrl} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Huzlly",
        "url": "https://huzlly-pages.pages.dev",
        "logo": "https://huzlly-pages.pages.dev/favicon.svg"
      }
    </script>
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white font-sans">
    
    <!-- Global Header (Light Mode) -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight text-blue-600 hover:text-blue-700 transition-colors">
          Huzlly.
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
          <a href="/about" class="hover:text-blue-600 transition-colors">About</a>
          <a href="/pricing" class="hover:text-blue-600 transition-colors">Pricing</a>
          <a href="/pricing" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors font-semibold shadow-sm">
            Get Started
          </a>
        </nav>
      </div>
    </header>

    <!-- Dynamic Page Content Slot -->
    <div class="flex-grow">
      <slot />
    </div>

    <!-- Global Footer (Light Mode) -->
    <footer class="border-t border-gray-200 bg-gray-50 py-10 mt-20">
      <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
        <p>© 2026 Huzlly. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/terms" class="hover:text-gray-900 transition-colors">Terms</a>
          <a href="/privacy" class="hover:text-gray-900 transition-colors">Privacy</a>
          <a href="/about" class="hover:text-gray-900 transition-colors">About</a>
        </div>
      </div>
    </footer>

  </body>
</html>
