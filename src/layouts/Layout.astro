---
// src/layouts/Layout.astro

import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath: string;
  noindex?: boolean;
  hideChrome?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/og-home.png',
  canonicalPath,
  noindex = false,
  hideChrome = false,
} = Astro.props;

const siteUrl = 'https://huzlly.com';
const canonicalURL = new URL(canonicalPath, siteUrl).toString();
const ogImageURL = new URL(ogImage, siteUrl).toString();

// Organization schema — copied verbatim from SITE_IDENTITY_AND_AEO.md Section 5.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Huzlly',
  url: 'https://huzlly.com/',
  email: 'contact@huzlly.com',
  sameAs: ['https://x.com/huzlly', 'https://instagram.com/huzllyofficial'],
  description:
    'Huzlly is an all-in-one platform for managing a freelance business — helping freelancers and independent professionals organize clients, projects, tasks, contracts, invoices, and client communication in one place.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Disable the browser's default scroll-restoration-on-reload behavior.
         Without this, Chrome/Firefox/Safari all remember scrollY across a
         refresh and silently jump back to it once the page repaints —
         reload should always land at the top like a fresh navigation.
         Must be set synchronously, this early in <head>, before the
         browser gets a chance to restore/repaint with the old position. -->
    <script>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
    </script>
    <!-- Sitewide smooth-scroll, powered by Lenis. Initialized once here
         (the only file that owns <body>/the document shell) so every page
         gets the same inertia-scroll feel. See src/scripts/lenis.ts for
         the reduced-motion guard and cleanup details. -->
    <script>
      import { initLenis } from '../scripts/lenis';
      initLenis();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Type pairing per DESIGN_SYSTEM.md v2 Section 2: Inter as the single
         sitewide font (body/UI, display headings, eyebrows, node captions,
         step counters). Replaces the superseded Roboto + Poppins pairing.
         Loaded once, sitewide, from Layout.astro — the only file that owns <head>. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content="Huzlly" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@huzlly" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="bg-paper text-ink antialiased">
    {!hideChrome && <Nav />}
    <slot />
    {!hideChrome && <Footer />}
  </body>
</html>
