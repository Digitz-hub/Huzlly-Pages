---
// src/layouts/Layout.astro
// Owns the entire document shell per CLAUDE.md Section 1 — the ONLY file
// permitted to contain <!doctype>, <html>, <head>, <body>, <header>, <footer>.
//
// Canonical/OG/meta implementation follows the exact pattern specified in
// PAGE_MAP_AND_SEO.md ("Base Layout Implementation Pattern").
//
// Organization JSON-LD is rendered sitewide here, since PAGE_MAP_AND_SEO.md
// Section 4 lists Organization schema as present on every route (e.g. /waitlist
// gets "None beyond sitewide Organization"). Page-specific schema
// (SoftwareApplication, FAQPage, etc.) is added by individual pages inside
// their own <main> content, per CLAUDE.md Section 4's per-page JSON-LD rule —
// schema.org script tags are valid anywhere in the document, not only <head>.

import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath: string;
  noindex?: boolean;
  hideChrome?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/og-home.png',
  canonicalPath,
  noindex = false,
  hideChrome = false,
} = Astro.props;

const siteUrl = 'https://huzlly.com';
const canonicalURL = new URL(canonicalPath, siteUrl).toString();
const ogImageURL = new URL(ogImage, siteUrl).toString();

// Organization schema — copied verbatim from SITE_IDENTITY_AND_AEO.md Section 5.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Huzlly',
  url: 'https://huzlly.com/',
  email: 'contact@huzlly.com',
  sameAs: ['https://x.com/huzlly', 'https://instagram.com/huzllyofficial'],
  description:
    'Huzlly is a lean, clutter-free software tool that helps freelancers automate manual work without paying for bloated, overpriced enterprise features.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Disable the browser's default scroll-restoration-on-reload behavior.
         Without this, Chrome/Firefox/Safari all remember scrollY across a
         refresh and silently jump back to it once the page repaints —
         reload should always land at the top like a fresh navigation.
         Must be set synchronously, this early in <head>, before the
         browser gets a chance to restore/repaint with the old position. -->
    <script>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Type pairing per DESIGN_SYSTEM.md v2 Section 2: Inter (body/UI) +
         Space Grotesk (display) + JetBrains Mono (eyebrows, node captions,
         step counters). Replaces the superseded Plus Jakarta Sans pairing.
         Loaded once, sitewide, from Layout.astro — the only file that owns <head>. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content="Huzlly" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@huzlly" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="bg-paper text-ink antialiased">
    {!hideChrome && <Nav />}
    <slot />
    {!hideChrome && <Footer />}
  </body>
</html>
