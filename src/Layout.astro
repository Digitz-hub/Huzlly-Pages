---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Huzlly - Modern Digital Solutions",
  description = "Discover modern, scalable digital solutions with Huzlly. Fast, reliable, and built for growth.",
  image = "/favicon.svg",
} = Astro.props;

const siteTitle = title.includes("Huzlly") ? title : `${title} | Huzlly`;
const siteUrl = "https://huzlly-pages.pages.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteUrl} />
    
    <!-- Primary SEO Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Huzlly",
        "url": "https://huzlly-pages.pages.dev",
        "logo": "https://huzlly-pages.pages.dev/favicon.svg"
      }
    </script>

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      body {
        background-color: #0d1117;
        color: #e6edf3;
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 8%;
        border-bottom: 1px solid #30363d;
        position: sticky;
        top: 0;
        background-color: rgba(13, 17, 23, 0.95);
        backdrop-filter: blur(8px);
        z-index: 100;
      }
      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: #58a6ff;
        text-decoration: none;
      }
      nav a {
        color: #8b949e;
        text-decoration: none;
        margin-left: 20px;
        font-weight: 500;
        transition: color 0.2s ease;
      }
      nav a:hover {
        color: #58a6ff;
      }
      footer {
        margin-top: auto;
        text-align: center;
        padding: 30px 20px;
        border-top: 1px solid #30363d;
        color: #8b949e;
        font-size: 0.9rem;
      }
      footer a {
        color: #8b949e;
        text-decoration: none;
        margin: 0 8px;
      }
      footer a:hover {
        color: #58a6ff;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo">Huzlly.</a>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/pricing">Pricing</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <slot />

    <footer>
      <p>© 2026 Huzlly. All rights reserved. | <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></p>
    </footer>
  </body>
</html>
